<Window x:Class="PropertyManagement.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="澜庭物业管理系统 - M0 骨架"
        Width="1366" Height="768"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 顶部栏（原型范式：标题 + 用户区） -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#2B7DE9">
            <DockPanel>
                <TextBlock Text="澜庭物业管理系统"
                           Foreground="White" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="16,0" />
                <TextBlock DockPanel.Dock="Right"
                           Text="系统管理员"
                           Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0" />
            </DockPanel>
        </Border>

        <!-- 左侧导航（原型两级树的模块分组骨架） -->
        <ListBox Grid.Row="1" Grid.Column="0" x:Name="NavList"
                 Background="#12345B" Foreground="White" BorderThickness="0"
                 SelectedIndex="0">
            <ListBoxItem Content="仪表盘" Margin="12,8" />
            <ListBoxItem Content="基础信息" Margin="12,8" />
            <ListBoxItem Content="财务收费" Margin="12,8" />
            <ListBoxItem Content="应急处置" Margin="12,8" />
            <ListBoxItem Content="人员组织" Margin="12,8" />
            <ListBoxItem Content="便民电话簿" Margin="12,8" />
            <ListBoxItem Content="纠纷调解" Margin="12,8" />
            <ListBoxItem Content="设备台账" Margin="12,8" />
            <ListBoxItem Content="系统设置" Margin="12,8" />
        </ListBox>

        <!-- 内容区占位（M1 契约后按切片填充页面） -->
        <Grid Grid.Row="1" Grid.Column="1">
            <TextBlock Text="内容区（M1 契约定稿后按业务切片填充）"
                       FontSize="16" Foreground="#888888"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- 状态栏（骨架验证：后端服务连通状态） -->
        <StatusBar Grid.Row="2" Grid.ColumnSpan="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="正在检查后端服务..." />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

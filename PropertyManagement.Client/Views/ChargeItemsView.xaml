<UserControl x:Class="PropertyManagement.Client.Views.ChargeItemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             FontFamily="微软雅黑">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="#FAFBFD" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowHeight" Value="44" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F4F7FB" />
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Height" Value="36" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridRow">
                                    <Border x:Name="RowBg" Background="{TemplateBinding Background}">
                                        <DataGridCellsPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowBg" Property="Background" Value="#F2F7FE" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="RowBg" Property="Background" Value="#E7EBF0" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}" VerticalAlignment="Center">
                                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EAF3FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- T4F-1-1：自定义模板内嵌占位层（hc:InfoElement.Placeholder 在自定义样式下不渲染的修复） -->
        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <TextBlock x:Name="PART_Placeholder"
                                       Text="{Binding Path=(hc:InfoElement.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                       VerticalAlignment="Center" Margin="1,0,0,0" IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="PART_Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="PART_Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 工具栏 ============ -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="34" Background="#F8FAFD" BorderBrush="{StaticResource BorderBrushColor}"
                        BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Style="{StaticResource IconStroke}"
                              Stroke="{StaticResource TextMutedBrush}" Width="14" Height="14" Margin="10,0,0,0"
                              VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Style="{StaticResource SearchTextBox}"
                                    Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                                    hc:InfoElement.Placeholder="搜索项目名称 / 编号"
                                    KeyDown="SearchBox_KeyDown"
                                    Margin="8,0,0,0" />
                    </Grid>
                </Border>
                <TextBlock Grid.Column="1" Text="类别" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="14,0,8,0" />
                <ComboBox Grid.Column="2" Height="32" FontSize="12" VerticalContentAlignment="Center"
                          ItemsSource="{Binding FilterCategories}" DisplayMemberPath="ItemName"
                          SelectedItem="{Binding CategoryFilter}" />
                <TextBlock Grid.Column="3" Text="状态" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="14,0,8,0" />
                <ComboBox Grid.Column="4" Height="32" FontSize="12" VerticalContentAlignment="Center"
                          SelectedIndex="{Binding StatusFilter}">
                    <ComboBoxItem Content="全部" />
                    <ComboBoxItem Content="启用" />
                    <ComboBoxItem Content="停用" />
                </ComboBox>
                <Button Grid.Column="6" Style="{StaticResource ButtonPrimary}" Content="新增项目"
                        Command="{Binding NewCommand}" Margin="0,0,10,0" />
                <Button Grid.Column="7" Style="{StaticResource LinkButton}" Content="导出"
                        FontSize="13" VerticalAlignment="Center" Click="ExportButton_Click" />
            </Grid>
        </Border>

        <!-- ============ 项目表格（T4F-1-3 八列对齐） ============ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid Style="{StaticResource GridStyle}" ItemsSource="{Binding Items}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="项目编号" Width="90" Binding="{Binding NoText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="项目名称" Width="*" Binding="{Binding Name}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="类别" Width="100" Binding="{Binding CategoryText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="计价方式" Width="110" Binding="{Binding MethodText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="单价" Width="140" Binding="{Binding PriceText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="计费周期" Width="100" Binding="{Binding CycleText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTemplateColumn Header="状态" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBg}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding StatusBrush}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="操作" Width="165">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource LinkButton}" Content="编辑"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource LinkButton}" Content="{Binding ToggleText}"
                                            Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource LinkButton}" Content="删除" Foreground="{StaticResource DangerBrush}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ============ 状态/错误条 ============ -->
        <TextBlock Grid.Row="4" Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource SuccessBrush}" />
        <TextBlock Grid.Row="4" Text="{Binding ErrorText}" FontSize="11" Foreground="{StaticResource DangerBrush}" />

        <!-- ============ 新增/编辑表单浮层（T4F-1-4 重建） ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="5" Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="400" HorizontalAlignment="Right" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20">
                        <TextBlock Text="{Binding FormTitle}" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="停用后不再生成新账单，历史账单不受影响（BR-FIN-03）" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,18" />

                        <TextBlock Text="项目名称" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Border Height="34" Margin="0,8,0,14" Background="#F8FAFD" BorderBrush="{StaticResource BorderBrushColor}"
                                BorderThickness="1" CornerRadius="6">
                            <TextBox Style="{StaticResource SearchTextBox}" Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                                        hc:InfoElement.Placeholder="如：物业服务费" />
                        </Border>

                        <TextBlock Text="类别" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Grid Margin="0,8,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" Height="34" FontSize="12" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding FormCategories}" DisplayMemberPath="ItemName"
                                      SelectedItem="{Binding FormCategory}"
                                      hc:InfoElement.Placeholder="请选择类别" />
                            <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="自定义"
                                    FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
                                    Command="{Binding OpenCustomCategoryCommand}" />
                        </Grid>

                        <TextBlock Text="计价方式" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Grid Margin="0,8,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" Height="34" FontSize="12" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding Methods}" DisplayMemberPath="ItemName"
                                      SelectedItem="{Binding FormMethod}"
                                      hc:InfoElement.Placeholder="请选择计价方式" />
                            <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="自定义"
                                    FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
                                    Command="{Binding OpenCustomMethodCommand}" />
                        </Grid>

                        <TextBlock Text="单价" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Grid Margin="0,8,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="34" Background="#F8FAFD" BorderBrush="{StaticResource BorderBrushColor}"
                                    BorderThickness="1" CornerRadius="6">
                                <TextBox Style="{StaticResource SearchTextBox}" Text="{Binding FormUnitPrice, StringFormat={}{0:0.##}, UpdateSourceTrigger=PropertyChanged}"
                                            hc:InfoElement.Placeholder="0.00" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding PriceUnitHint}" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>

                        <TextBlock Text="计费周期" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Grid Margin="0,8,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" Height="34" FontSize="12" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding Cycles}" DisplayMemberPath="ItemName"
                                      SelectedItem="{Binding FormCycle}"
                                      hc:InfoElement.Placeholder="请选择计费周期" />
                            <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="自定义"
                                    FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"
                                    Command="{Binding OpenCustomCycleCommand}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                            <CheckBox IsChecked="{Binding FormEnabled}" VerticalAlignment="Center" />
                            <TextBlock Text="启用（可生成新账单）" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="8,0,0,0" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource ButtonPrimary}" Content="保存"
                                    Command="{Binding SaveCommand}" />
                            <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="取消"
                                    FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Command="{Binding CancelCommand}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============ 自定义字典弹层（在表单之上） ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="5" Visibility="{Binding IsCustomDialogVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="340" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}" CornerRadius="10"
                    BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Padding="22,18">
                <StackPanel>
                    <TextBlock Text="{Binding CustomDialogTitle}" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" />
                    <TextBlock Text="名称" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <Border Height="34" Margin="0,8,0,10" Background="#F8FAFD" BorderBrush="{StaticResource BorderBrushColor}"
                            BorderThickness="1" CornerRadius="6">
                        <TextBox Style="{StaticResource SearchTextBox}" Text="{Binding CustomInputName, UpdateSourceTrigger=PropertyChanged}"
                                    hc:InfoElement.Placeholder="请输入名称（如：按卡）" />
                    </Border>
                    <TextBlock Text="单位文本（如：张）" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Visibility="{Binding CustomShowRemark, Converter={StaticResource BoolToVis}}" />
                    <Border Height="34" Margin="0,8,0,10" Background="#F8FAFD" BorderBrush="{StaticResource BorderBrushColor}"
                            BorderThickness="1" CornerRadius="6"
                            Visibility="{Binding CustomShowRemark, Converter={StaticResource BoolToVis}}">
                        <TextBox Style="{StaticResource SearchTextBox}" Text="{Binding CustomInputRemark, UpdateSourceTrigger=PropertyChanged}"
                                    hc:InfoElement.Placeholder="如：张" />
                    </Border>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonPrimary}" Content="保存"
                                Command="{Binding ConfirmCustomCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="取消"
                                FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Command="{Binding CancelCustomCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 删除二次确认弹层（T4R-1，软删除留痕 BR-FIN-03） ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="5" Visibility="{Binding IsConfirmVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}" CornerRadius="10"
                    BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="确认删除" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="确认删除收费项目（" /><Run Text="{Binding ConfirmRow.NoText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ConfirmRow.Name, Mode=OneWay}" /><Run Text="）？删除为软删除，历史账单与流水不受影响（BR-FIN-03）。" />
                    </TextBlock>
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonPrimary}" Content="确认删除" Command="{Binding ConfirmDeleteCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelDeleteCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

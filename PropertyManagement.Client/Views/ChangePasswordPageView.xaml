<UserControl x:Class="PropertyManagement.Client.Views.ChangePasswordPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:conv="clr-namespace:PropertyManagement.Client.Converters"
             FontFamily="微软雅黑">
    <UserControl.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
    </UserControl.Resources>
    <!-- 2026-09-06 P0 修复：原生 PasswordBox.Password 非 DP，XAML 直接 Binding 会在
         InitializeComponent 抛 XamlParseException。改用 hc:PasswordBox + 代码后置
         ActualPasswordBox.PasswordChanged 事件回填 VM（同 ChangePasswordWindow 方案）；
         明文输入框（TextBox）用于「眼睛」显隐切换，绑定同一 VM 属性。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,12,16,12">
            <Border Style="{StaticResource CardBorder}" Padding="28,24">
                <StackPanel>
                    <!-- 标题区（原型 PG-COM-04：图标座 + 标题 + 当前账号副标题，账号取自会话不硬编码） -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,4,0,22">
                        <Border Width="54" Height="54" CornerRadius="27" Background="{StaticResource PrimarySoftBrush}" HorizontalAlignment="Center">
                            <Path Data="{StaticResource Icon.LockKeyhole}" Style="{StaticResource IconStroke}" Stroke="{StaticResource PrimaryBrush}" Width="24" Height="24" />
                        </Border>
                        <TextBlock Text="修改密码" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding CurrentAccountText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>

                    <TextBlock Text="原密码" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <Grid>
                        <hc:PasswordBox x:Name="OldPasswordInput" hc:InfoElement.Placeholder="请输入原密码" Height="44" Padding="14,0,40,0" />
                        <TextBox x:Name="OldPasswordPlain" Text="{Binding OldPassword, UpdateSourceTrigger=PropertyChanged}"
                                 Height="44" Padding="14,0,40,0" VerticalContentAlignment="Center" Visibility="Collapsed" />
                        <Button x:Name="OldVisibilityToggle" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,8,0" Click="ToggleOldPassword_Click" ToolTip="显示 / 隐藏密码">
                            <Path Data="{StaticResource Icon.Eye}" Style="{StaticResource IconStroke}" Stroke="{StaticResource TextMutedBrush}" Width="16" Height="16" />
                        </Button>
                    </Grid>

                    <TextBlock Text="新密码" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,6" />
                    <Grid>
                        <hc:PasswordBox x:Name="NewPasswordInput" hc:InfoElement.Placeholder="6-20 位，含字母和数字" Height="44" Padding="14,0,40,0" />
                        <TextBox x:Name="NewPasswordPlain" Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                                 Height="44" Padding="14,0,40,0" VerticalContentAlignment="Center" Visibility="Collapsed" />
                        <Button x:Name="NewVisibilityToggle" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,8,0" Click="ToggleNewPassword_Click" ToolTip="显示 / 隐藏密码">
                            <Path Data="{StaticResource Icon.Eye}" Style="{StaticResource IconStroke}" Stroke="{StaticResource TextMutedBrush}" Width="16" Height="16" />
                        </Button>
                    </Grid>

                    <TextBlock Text="确认新密码" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,6" />
                    <Grid>
                        <hc:PasswordBox x:Name="ConfirmPasswordInput" hc:InfoElement.Placeholder="再次输入新密码" Height="44" Padding="14,0,40,0" />
                        <TextBox x:Name="ConfirmPasswordPlain" Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"
                                 Height="44" Padding="14,0,40,0" VerticalContentAlignment="Center" Visibility="Collapsed" />
                        <Button x:Name="ConfirmVisibilityToggle" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,8,0" Click="ToggleConfirmPassword_Click" ToolTip="显示 / 隐藏密码">
                            <Path Data="{StaticResource Icon.Eye}" Style="{StaticResource IconStroke}" Stroke="{StaticResource TextMutedBrush}" Width="16" Height="16" />
                        </Button>
                    </Grid>

                    <!-- 强度提示三段条（弱/中/强）+ 强度文案（原型：满宽，标签右对齐） -->
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="6" CornerRadius="3" Background="{Binding StrengthBrush1}" />
                        <Border Grid.Column="2" Height="6" CornerRadius="3" Background="{Binding StrengthBrush2}" Margin="6,0,0,0" />
                        <Border Grid.Column="4" Height="6" CornerRadius="3" Background="{Binding StrengthBrush3}" Margin="6,0,0,0" />
                        <TextBlock Grid.Column="5" Text="{Binding StrengthText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>

                    <!-- 密码规则说明卡（原型三行，逐条 ✓） -->
                    <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="密码规则" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Path Data="{StaticResource Icon.Check}" Style="{StaticResource IconStroke}" Stroke="{StaticResource SuccessBrush}" Width="13" Height="13" VerticalAlignment="Center" />
                                <TextBlock Text="长度 6-20 位；必须同时包含字母和数字（大小写不限，无需特殊字符）" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Path Data="{StaticResource Icon.Check}" Style="{StaticResource IconStroke}" Stroke="{StaticResource SuccessBrush}" Width="13" Height="13" VerticalAlignment="Center" />
                                <TextBlock Text="不得与最近 3 次密码重复" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Path Data="{StaticResource Icon.Check}" Style="{StaticResource IconStroke}" Stroke="{StaticResource SuccessBrush}" Width="13" Height="13" VerticalAlignment="Center" />
                                    <TextBlock Text="连续输错 5 次，账号锁定 30 分钟" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 状态/错误/强制改密提示：空文案时不额外占位，按钮紧贴规则卡（原型 PG-COM-04） -->
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SuccessBrush}" FontSize="12" TextWrapping="Wrap"
                                   Visibility="{Binding StatusText, Converter={StaticResource StringToVis}}" />
                        <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding ErrorText, Converter={StaticResource StringToVis}}" />
                        <TextBlock Text="{Binding ForcedHintText}" Foreground="{StaticResource WarningBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding ForcedHintText, Converter={StaticResource StringToVis}}" />
                    </StackPanel>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- 首登强制改密：禁用「取消」（UC-COM-002；R16 已下线 90 天强制更换） -->
                        <Button Grid.Column="0" Style="{StaticResource ButtonSecondary}" Content="取消" Height="44"
                                IsEnabled="{Binding CanCancel}" ToolTip="强制改密流程下不可取消" Command="{Binding CancelCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource ButtonPrimary}" Content="确认修改" Height="44" Command="{Binding SubmitCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 交互标注（原型 PG-COM-04；短信网关未接入，改密后强制重新登录） -->
            <Border Background="#F7F5FE" CornerRadius="6" Padding="12,8" Margin="0,14,0,4">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Eye}" Style="{StaticResource IconStroke}" Stroke="#5B3DF5" Width="12" Height="12" />
                        <TextBlock Text="交互标注" Foreground="#5B3DF5" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="· 【确认修改】→ 校验规则 → 弹窗“密码已更新，请重新登录”→ 强制退出至登录页（UC-COM-002）" Foreground="#4A3AB0" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="· 首登强制改密：进入系统后自动定位本页并禁用「取消」；改密写审计日志，眼睛图标切换明文/密文" Foreground="#4A3AB0" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

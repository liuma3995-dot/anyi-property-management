<UserControl x:Class="PropertyManagement.Client.Views.DeviceReminderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:PropertyManagement.Client.Views"
             FontFamily="微软雅黑">
    <UserControl.Resources>
        <Style x:Key="RemainCellText" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 范围页签胶囊按钮（原型 PG-EQP-04：选中蓝底白字，未选白底描边）
             用 ToggleButton + IsChecked 承载选中态：悬停组合条件可直接判定，避免浅底白字看不清 -->
        <Style x:Key="ScopeTabButton" TargetType="ToggleButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="TabBg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- 选中态：蓝底白字 -->
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
                <!-- 未选态悬停：浅蓝底 + 主色字 -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                </Trigger>
                <!-- 选中态悬停：加深主色底，保持白字可读（修复悬停变浅底导致文字看不清） -->
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsChecked" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryDarkBrush}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- 统计行：后端 summary 分桶 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="30 天内到期" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding Within30, StringFormat='{}{0} 项'}" FontSize="24" FontWeight="Bold" Margin="0,6,0,2"/>
                    <TextBlock Text="{Binding Within30Sub}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="18,14" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="7 天内到期" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding Within7, StringFormat='{}{0} 项'}" FontSize="24" FontWeight="Bold" Margin="0,6,0,2"/>
                    <TextBlock Text="{Binding Within7Sub}" FontSize="11" Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18,14" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="本月已处理" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding MonthHandled, StringFormat='{}{0} 项'}" FontSize="24" FontWeight="Bold" Margin="0,6,0,2"/>
                    <TextBlock Text="{Binding MonthHandledSub}" FontSize="11" Foreground="{StaticResource SuccessBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource CardBorder}" Padding="18,14" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="逾期未处理" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding OverdueUnhandled, StringFormat='{}{0} 项'}" FontSize="24" FontWeight="Bold" Margin="0,6,0,2"/>
                    <TextBlock Text="{Binding OverdueSub}" FontSize="11" Foreground="{StaticResource DangerBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
        <!-- 工具栏：第一行=范围页签+状态页签（左）与批量删除入口（右）；第二行=批量模式操作条（避免挤压页签） -->
        <StackPanel Grid.Row="2">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <!-- 5 个页签统一走 ScopeTabButton（选中态由 IsChecked 驱动；原重复的"全部"页签已移除） -->
                <ToggleButton Style="{StaticResource ScopeTabButton}" Content="全部" Command="{Binding SetScopeCommand}" CommandParameter="0" IsChecked="{Binding IsScopeAll, Mode=OneWay}" />
                <ToggleButton Style="{StaticResource ScopeTabButton}" Content="保养到期" Command="{Binding SetScopeCommand}" CommandParameter="1" IsChecked="{Binding IsScopeMaintenance, Mode=OneWay}" />
                <ToggleButton Style="{StaticResource ScopeTabButton}" Content="年检到期" Command="{Binding SetScopeCommand}" CommandParameter="2" IsChecked="{Binding IsScopeInspection, Mode=OneWay}" />
                <ToggleButton Style="{StaticResource ScopeTabButton}" Content="质保到期" Command="{Binding SetScopeCommand}" CommandParameter="3" IsChecked="{Binding IsScopeWarranty, Mode=OneWay}" />
                <ToggleButton Style="{StaticResource ScopeTabButton}" Content="合同到期" Command="{Binding SetScopeCommand}" CommandParameter="4" IsChecked="{Binding IsScopeContract, Mode=OneWay}" />
                <Border Width="1" Background="{StaticResource BorderBrushColor}" Margin="8,4,12,4" />
                <!-- R6 状态页签：全部（含已处理）/ 待处理 / 已处理 -->
                <ToggleButton Style="{StaticResource ScopeTabButton}" Content="全部状态" Command="{Binding SetStatusCommand}" CommandParameter="0" IsChecked="{Binding IsStatusAll, Mode=OneWay}" />
                <ToggleButton Style="{StaticResource ScopeTabButton}" Content="待处理" Command="{Binding SetStatusCommand}" CommandParameter="1" IsChecked="{Binding IsStatusPending, Mode=OneWay}" />
                <ToggleButton Style="{StaticResource ScopeTabButton}" Content="已处理" Command="{Binding SetStatusCommand}" CommandParameter="2" IsChecked="{Binding IsStatusHandled, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 批量删除入口：批量模式下的勾选与确认移到下一行，避免页签被挤压 -->
                <Button Height="32" FontSize="12" Background="{StaticResource DangerSoftBrush}" Foreground="{StaticResource DangerBrush}"
                        BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Content="批量删除记录"
                        Command="{Binding StartBatchDeleteCommand}" Visibility="{Binding IsNotBatchMode, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>
        <!-- 批量模式操作条（全选 / 已选 N / 取消 / 确认删除） -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0" Visibility="{Binding IsBatchMode, Converter={StaticResource BoolToVis}}">
            <CheckBox Content="全选" IsChecked="{Binding IsAllChecked, Mode=TwoWay}" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CheckedCountText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
            <Button Style="{StaticResource ButtonSecondary}" Content="取消" Height="32" FontSize="12" Margin="12,0,0,0" Command="{Binding CancelBatchDeleteCommand}" />
            <Button Height="32" FontSize="12" Margin="8,0,0,0" Background="{StaticResource DangerSoftBrush}" Foreground="{StaticResource DangerBrush}"
                    BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Content="确认删除" Command="{Binding RequestBatchConfirmCommand}" />
        </StackPanel>
        </StackPanel>
        <!-- 数据表：设备/事项/计划日期/剩余天数/责任班组/状态/处置时间/操作（R6：提醒进度列已下线） -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid Style="{StaticResource GridStyle}" ItemsSource="{Binding Items}" IsReadOnly="True">
                <DataGrid.Columns>
                    <!-- 批量删除勾选列（仅多选模式可见） -->
                    <DataGridTemplateColumn Width="44" CanUserSort="False">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate><TextBlock Text="选" FontSize="11" /></DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="{Binding DataContext.IsBatchMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVis}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="设备" Width="*" Binding="{Binding DeviceText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="事项" Width="88" Binding="{Binding ItemText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="计划日期" Width="92" Binding="{Binding DueText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="剩余天数" Width="92" Binding="{Binding RemainingText}" ElementStyle="{StaticResource RemainCellText}" />
                    <!-- R7：责任班组单元格支持行内自定义选择（部门字典 + 直接输入），支持恢复默认规则 -->
                    <DataGridTemplateColumn Header="责任班组" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding ShowTeamText, Converter={StaticResource BoolToVis}}" ToolTip="{Binding TeamTip}">
                                        <TextBlock Text="{Binding TeamText}" FontSize="12" VerticalAlignment="Center" />
                                        <Border Background="#EFEEFF" CornerRadius="3" Padding="4,1" Margin="5,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding HasCustomTeam, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="自定义" FontSize="10" Foreground="#5B3DF5" />
                                        </Border>
                                        <Button Style="{StaticResource LinkButton}" Content="改" FontSize="12" Padding="2,1" Margin="6,0,0,0"
                                                Command="{Binding DataContext.EditTeamCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource LinkButton}" Content="默认" FontSize="12" Padding="2,1" Margin="4,0,0,0" Foreground="#98A2B3"
                                                ToolTip="恢复默认规则（逾期→物业办，其余→工程部）"
                                                Command="{Binding DataContext.ResetTeamCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding HasCustomTeam, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="-8,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsTeamEditing, Converter={StaticResource BoolToVis}}">
                                        <ComboBox Width="96" Height="26" FontSize="12" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                                                  Text="{Binding TeamDraft, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding DataContext.TeamOptions, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                  hc:InfoElement.Placeholder="选择/输入班组" />
                                        <Button Style="{StaticResource LinkButton}" Content="保存" FontSize="12" Padding="2,1" Margin="4,0,0,0"
                                                Command="{Binding DataContext.SaveTeamCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource LinkButton}" Content="取消" FontSize="12" Padding="2,1" Margin="2,0,0,0" Foreground="#98A2B3"
                                                Command="{Binding DataContext.CancelTeamCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="状态" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBg}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-8,0,0,0">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusFg}" FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- R6 新增：处置时间（已处理记录保留展示） -->
                    <DataGridTextColumn Header="处置时间" Width="124" Binding="{Binding HandledText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTemplateColumn Header="操作" Width="112">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- R6：一键催办下线，未处理行统一「标记已处理」 -->
                                    <Button Style="{StaticResource LinkButton}" Content="标记已处理" FontSize="12" Padding="3,2"
                                            Command="{Binding DataContext.MarkHandledCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}"
                                            Visibility="{Binding ShowMarkHandled, Converter={StaticResource BoolToVis}}" />
                                    <!-- 已处理行：操作列 —（记录保留，可通过批量删除清理） -->
                                    <TextBlock Text="—" Visibility="{Binding ShowNoAction, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <StackPanel Grid.Row="6">
            <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SuccessBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>
        <!-- 交互标注（原型 PG-EQP-04 底部） -->
        <Border Grid.Row="8" Background="#F7F5FE" CornerRadius="6" Padding="12,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Eye}" Style="{StaticResource IconStroke}" Stroke="#5B3DF5" Width="12" Height="12" />
                    <TextBlock Text="交互标注" Foreground="#5B3DF5" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Text="· 状态分档：剩余天数 &gt;30 天＝正常、≤30 天＝待处理、已过期＝逾期（逾期默认升级物业办）" Foreground="#4A3AB0" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="·【标记已处理】→ 手动闭环本期提醒，记录保留在列表（状态＝已处理 + 处置时间），本期不再重复提醒" Foreground="#4A3AB0" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                <TextBlock Text="· 跨模块联动：在「保养 / 年检登记」完成合格登记后，对应提醒自动闭环并按新记录顺延下一周期" Foreground="#4A3AB0" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                <TextBlock Text="·【责任班组】点「改」可自定义选择 / 输入负责部门（默认：逾期→物业办，其余→工程部）；【批量删除记录】仅可删「已处理」（软删留痕）" Foreground="#4A3AB0" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- 批量删除二次确认浮层（R6） -->
        <Grid Grid.RowSpan="9" Visibility="{Binding IsBatchConfirmVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="430" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="批量删除提醒记录" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding BatchConfirmText}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,14,0,22" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelBatchDeleteCommand}" />
                        <Button Grid.Column="2" Height="34" FontSize="13" Background="{StaticResource DangerSoftBrush}" Foreground="{StaticResource DangerBrush}"
                                BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Content="确认删除" Command="{Binding ConfirmBatchDeleteCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <!-- 禁止删除提示浮层（R6：待处理/逾期记录） -->
        <Grid Grid.RowSpan="9" Visibility="{Binding IsBlockedVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="禁止删除" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                    <TextBlock Text="{Binding BlockedText}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,14,0,20" />
                    <Button Style="{StaticResource ButtonPrimary}" Content="知道了" HorizontalAlignment="Right" Command="{Binding CloseBlockedCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

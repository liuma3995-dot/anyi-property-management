<Window x:Class="PropertyManagement.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="登录 - 安怡物业管理系统"
        Width="680" Height="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#FAF8F4"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="微软雅黑">
    <Grid>
        <!-- 登录主面板：680x560 无边框两栏铺满（登录页不套 1366x768 画布）；窗口轮廓为直角（兼容性决策 2026-08-31）；左栏品牌渐变 #12332D→#1F4B43 直抵左边缘，右栏表单区白色直抵右边缘，边缘颜色与区域颜色一致 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="282" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 品牌信息区：渐变 #12332D → #1F4B43（150°），铺满左栏直达左边缘 -->
            <Border Grid.Column="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#12332D" Offset="0" />
                            <GradientStop Color="#1F4B43" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid Margin="34,42">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- M8-D8-0 徽记对齐（2026-09-14）：唯一源 docs\brand\anyi-logo-square-color.svg（与 app.ico 同源）
                             采用母版 240×240 网格坐标 + LayoutTransform 等比缩放至 52×52（52/240 = 0.2166667），
                             几何/色值/叶片与母版逐值一致；已移除原「半透明白描边容器」（与 exe 图标 1:1） -->
                        <Border Grid.Row="0" Width="240" Height="240"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Background="#1F4B43" CornerRadius="54">
                            <Border.LayoutTransform>
                                <ScaleTransform ScaleX="0.2166667" ScaleY="0.2166667" />
                            </Border.LayoutTransform>
                            <Canvas Width="240" Height="240">
                                <Rectangle Canvas.Left="57.7" Canvas.Top="135" Width="34.5" Height="68.5" Fill="#FAF8F4" RadiusX="3.4" RadiusY="3.4" />
                                <Rectangle Canvas.Left="101.3" Canvas.Top="97.5" Width="42" Height="106" Fill="#FAF8F4" RadiusX="3.4" RadiusY="3.4" />
                                <Rectangle Canvas.Left="152.3" Canvas.Top="147" Width="30" Height="56.5" Fill="#FAF8F4" RadiusX="3.4" RadiusY="3.4" />
                                <Rectangle Canvas.Left="52.5" Canvas.Top="200.6" Width="135" Height="5.8" Fill="#C8A96A" RadiusX="2.9" RadiusY="2.9" />
                                <Path Data="M99.3,88.7 Q99.3,43.1 144.9,43.1 Q144.9,88.7 99.3,88.7 Z" Fill="#C8A96A" />
                            </Canvas>
                        </Border>

                        <TextBlock Grid.Row="1" Text="安怡物业&#x0a;管理系统"
                                   Foreground="White"
                                   FontSize="30" FontWeight="Bold"
                                   LineHeight="40" LineStackingStrategy="BlockLineHeight"
                                   Margin="0,20,0,0" />

                        <TextBlock Grid.Row="2" Text="社区运营 · 财务收费 · 应急协同&#x0a;让物业服务更清晰、更高效"
                                   Foreground="#DCE9E4" FontSize="13" LineHeight="24"
                                   LineStackingStrategy="BlockLineHeight"
                                   Margin="0,20,0,0" />

                        <Border Grid.Row="3" Background="#14FFFFFF" CornerRadius="10"
                                Padding="14,12" Margin="0,20,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.ShieldCheck}"
                                      Style="{StaticResource IconStroke}"
                                      Stroke="White"
                                      Width="18" Height="18" />
                                <TextBlock Text="本地数据加密保护" Foreground="White"
                                           FontSize="12" Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="5" Text="DESKTOP CLIENT  ·  V1.0"
                                   Foreground="#BFD8D2" FontSize="10" />
                    </Grid>
                </Border>

            <!-- 登录表单区：白色铺满右栏直达右边缘 -->
            <Border Grid.Column="1" Background="White">
                <Grid Margin="48,52">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="欢迎回来"
                               Foreground="#172033"
                               FontSize="26" FontWeight="Bold" />

                    <TextBlock Grid.Row="1" Text="请输入账号信息以进入工作台"
                               Foreground="#667085" FontSize="13"
                               Margin="0,6,0,18" />

                    <!-- 账号输入组 -->
                    <TextBlock Grid.Row="2" Text="账号" Foreground="#172033"
                               FontSize="12" FontWeight="SemiBold" />
                    <Border Grid.Row="3" Height="46" Margin="0,8,0,18"
                            Background="#F7F4EE"
                            BorderBrush="#E4EAF2" BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Data="{StaticResource Icon.UserRound}"
                                  Style="{StaticResource IconStroke}"
                                  Stroke="#98A2B3"
                                  Width="18" Height="18" Margin="14,0,0,0" />
                            <hc:TextBox Grid.Column="1" x:Name="UserNameInput"
                                        Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                        hc:InfoElement.Placeholder="请输入用户名"
                                        InputMethod.IsInputMethodEnabled="False"
                                        FontSize="13" Foreground="#172033"
                                        Background="Transparent" BorderThickness="0"
                                        Height="46" Margin="12,0"
                                        VerticalContentAlignment="Center"
                                        CaretBrush="#1F4B43" />
                        </Grid>
                    </Border>

                    <!-- 密码输入组 -->
                    <TextBlock Grid.Row="4" Text="密码" Foreground="#172033"
                               FontSize="12" FontWeight="SemiBold" />
                    <Border Grid.Row="5" Height="46" Margin="0,8,0,18"
                            Background="#F7F4EE"
                            BorderBrush="#E4EAF2" BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Data="{StaticResource Icon.LockKeyhole}"
                                  Style="{StaticResource IconStroke}"
                                  Stroke="#98A2B3"
                                  Width="18" Height="18" Margin="14,0,0,0" />
                            <hc:PasswordBox Grid.Column="1" x:Name="PasswordInput"
                                            hc:InfoElement.Placeholder="请输入密码"
                                            FontSize="13" Foreground="#172033"
                                            Background="Transparent" BorderThickness="0"
                                            Height="46" Margin="12,0" />
                            <!-- 显示密码：明文输入框（默认隐藏，与 PasswordBox 同位置切换） -->
                            <hc:TextBox Grid.Column="1" x:Name="PasswordPlainInput"
                                        hc:InfoElement.Placeholder="请输入密码"
                                        AutomationProperties.AutomationId="PasswordPlainInput"
                                        InputMethod.IsInputMethodEnabled="False"
                                        FontSize="13" Foreground="#172033"
                                        Background="Transparent" BorderThickness="0"
                                        Height="46" Margin="12,0"
                                        VerticalContentAlignment="Center"
                                        CaretBrush="#1F4B43"
                                        Visibility="Collapsed" />
                            <!-- 小眼睛：切换密码明文/密文（点击区域 30x30，避免误触） -->
                            <Button Grid.Column="2" x:Name="TogglePasswordButton"
                                    AutomationProperties.AutomationId="TogglePasswordButton"
                                    Click="TogglePasswordButton_Click"
                                    Cursor="Hand" ToolTip="显示密码"
                                    Background="Transparent" BorderThickness="0"
                                    Width="30" Height="30" Margin="0,0,8,0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#F1F4F9" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Path x:Name="TogglePasswordIcon"
                                      Data="{StaticResource Icon.Eye}"
                                      Style="{StaticResource IconStroke}"
                                      Stroke="#98A2B3"
                                      Width="18" Height="18" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 登录选项：记住账号 + 服务状态 -->
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding RememberAccount}" VerticalAlignment="Center">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="Box" Width="16" Height="16"
                                                Background="#FAF8F4"
                                                BorderBrush="#E4EAF2" BorderThickness="1"
                                                CornerRadius="4">
                                            <Path x:Name="Check"
                                                  Data="{StaticResource Icon.Check}"
                                                  Style="{StaticResource IconStroke}"
                                                  Stroke="#1F4B43"
                                                  Width="10" Height="10"
                                                  Visibility="Collapsed" />
                                        </Border>
                                        <ContentPresenter Margin="8,0,0,0"
                                                          VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Box" Property="BorderBrush" Value="#1F4B43" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                            <TextBlock Text="记住账号" Foreground="#667085" FontSize="12" />
                        </CheckBox>
                        <!-- M8 T8-4-1：本地服务状态（未启动 → 启动中（含重试次数）→ 正常 / 超时） -->
                        <TextBlock Grid.Column="1" Text="{Binding ServiceStatusText}"
                                   Foreground="{Binding ServiceStatusBrush}" FontSize="11"
                                   AutomationProperties.AutomationId="ServiceStatusText"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Row="7" Margin="0,8,0,0">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="12" TextWrapping="Wrap"
                                   MinHeight="18" />
                        <TextBlock Text="{Binding HintText}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- IsDefault：在用户名/密码框内直接回车即可登录（M8 登录体验修复） -->
                    <Button Grid.Row="8" Height="46" Margin="0,16,0,18"
                            Command="{Binding LoginCommand}"
                            IsDefault="True"
                            Style="{StaticResource ButtonPrimary}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="登 录" Foreground="White"
                                       FontSize="14" FontWeight="SemiBold" />
                            <Path Data="{StaticResource Icon.ArrowRight}"
                                  Style="{StaticResource IconStroke}"
                                  Stroke="White"
                                  Width="17" Height="17" Margin="10,0,0,0" />
                        </StackPanel>
                    </Button>

                    <TextBlock Grid.Row="9" Text="登录行为将记录至系统审计日志"
                               Foreground="#98A2B3" FontSize="11"
                               HorizontalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 无边框窗口控制：右上角最小化/关闭（背景区可拖拽移动，见 Window_MouseLeftButtonDown） -->
            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,10,10,0">
                    <Button Width="30" Height="30" Click="MinimizeButton_Click"
                            ToolTip="最小化" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#F1F4F9" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Path Data="M6 12h12" Stroke="#667085" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                    <Button Width="30" Height="30" Margin="4,0,0,0" Click="CloseButton_Click"
                            ToolTip="关闭" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#FDECEC" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Path Data="M7 7l10 10 M17 7L7 17" Stroke="#667085" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                </StackPanel>
        </Grid>
    </Grid>
</Window>

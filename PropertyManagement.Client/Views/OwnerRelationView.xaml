<UserControl x:Class="PropertyManagement.Client.Views.OwnerRelationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PropertyManagement.Client.Assets.Controls"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             FontFamily="微软雅黑">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Height="32" Width="200" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Style="{StaticResource IconStroke}" Stroke="{StaticResource TextMutedBrush}" Width="14" Height="14" Margin="10,0,0,0" />
                        <TextBox Grid.Column="1" Style="{StaticResource SearchTextBox}" Text="{Binding RoomKeyword, UpdateSourceTrigger=PropertyChanged}" hc:InfoElement.Placeholder="搜索房号 / 业主" FontSize="11" Margin="8,0,12,0" />
                    </Grid>
                </Border>
                <ComboBox Height="32" MinWidth="130" Margin="8,0,0,0" SelectedIndex="{Binding RelTypeFilter, Mode=TwoWay}">
                    <ComboBoxItem Content="关系类型：全部" />
                    <ComboBoxItem Content="关系类型：业主" />
                    <ComboBoxItem Content="关系类型：共有人" />
                    <ComboBoxItem Content="关系类型：租户备案" />
                </ComboBox>
                <ComboBox Height="32" Width="120" Margin="8,0,0,0" SelectedIndex="{Binding StatusFilter, Mode=TwoWay}">
                    <ComboBoxItem Content="状态：全部" />
                    <ComboBoxItem Content="状态：有效" />
                    <ComboBoxItem Content="状态：即将到期" />
                    <ComboBoxItem Content="状态：已解除" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource ButtonPrimary}" Content="绑定关系" Command="{Binding BindCommand}" />
                <Button Height="32" FontSize="13" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Content="批量解除" Command="{Binding OpenBatchCommand}" Margin="10,0,0,0" />
                <Button Height="32" FontSize="13" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Content="导出 Excel" Command="{Binding ExportCommand}" Margin="10,0,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid Style="{StaticResource GridStyle}" ItemsSource="{Binding Items}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="房产编号" Width="96" Binding="{Binding PropertyCode}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="房号" Width="140" Binding="{Binding PropertyNo}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="业主 / 关系人" Width="*" Binding="{Binding OwnerName}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTemplateColumn Header="关系类型" Width="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#F1EDFD" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding RelTypeText}" Foreground="#7A5AF8" FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="份额" Width="60" Binding="{Binding ShareText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="起止日期" Width="140" Binding="{Binding PeriodText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTemplateColumn Header="状态" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBg}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="操作" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource LinkButton}" Content="解除"
                                        Foreground="{StaticResource DangerBrush}"
                                        Command="{Binding DataContext.ReleaseCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 记录条数与翻页（v1.3.0：与「房产列表」同口径） -->
        <Grid Grid.Row="4" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding TotalText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource SuccessBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Height="24" FontSize="12" Background="Transparent" BorderThickness="0" Style="{StaticResource LinkButton}" Content="上一页" Command="{Binding PrevPageCommand}" />
                <Button Height="24" FontSize="12" Background="Transparent" BorderThickness="0" Style="{StaticResource LinkButton}" Content="下一页" Command="{Binding NextPageCommand}" Margin="6,0,0,0" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="5" Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" />

        <!-- 绑定弹层 -->
        <Border Grid.RowSpan="6" Background="#66000000" Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="绑定业主-房产关系" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,18" />
                    <TextBlock Text="房产" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <!-- CHG-v1.3.1-01：改为「服务端检索 + 下拉内翻页」（PagedPicker）——
                         v1.3.0 及以前只取前 100 条并在本地过滤，房产/业主一多就"只显示一部分、搜什么都搜不到"（负责人现场反馈）。
                         选中口径仍由 SelectedProperty / FormPropertyId 承载，集合重建不会丢选中项（不会复现"选不中/存不了"）。 -->
                    <controls:PagedPicker x:Name="PropertyPicker" Style="{StaticResource PagedPickerStyle}"
                                          Margin="0,6,0,12" FontSize="12"
                                          ItemsSource="{Binding PropertyOptions}" DisplayMemberPath="UnitPath"
                                          SelectedItem="{Binding SelectedProperty, Mode=TwoWay}"
                                          SearchText="{Binding PropertySearchText, Mode=TwoWay}"
                                          PageText="{Binding PropertyPageText}"
                                          PrevCommand="{Binding PropertyPrevPageCommand}"
                                          NextCommand="{Binding PropertyNextPageCommand}"
                                          Placeholder="输入楼栋 / 单元 / 房号 / 业主 / 电话检索" />
                    <TextBlock Text="业主" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <controls:PagedPicker x:Name="OwnerPicker" Style="{StaticResource PagedPickerStyle}"
                                          Margin="0,6,0,12" FontSize="12"
                                          ItemsSource="{Binding OwnerOptions}" DisplayMemberPath="OwnerDisplayName"
                                          SelectedItem="{Binding SelectedOwner, Mode=TwoWay}"
                                          SearchText="{Binding OwnerSearchText, Mode=TwoWay}"
                                          PageText="{Binding OwnerPageText}"
                                          PrevCommand="{Binding OwnerPrevPageCommand}"
                                          NextCommand="{Binding OwnerNextPageCommand}"
                                          Placeholder="输入姓名 / 电话 / 证件号检索" />
                    <TextBlock Text="关系类型" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <ComboBox SelectedValue="{Binding FormRelType}" SelectedValuePath="Tag" Margin="0,6,0,12">
                        <ComboBoxItem Content="业主" Tag="Owner" />
                        <ComboBoxItem Content="共有人" Tag="CoOwner" />
                        <ComboBoxItem Content="租户备案" Tag="RentRecord" />
                    </ComboBox>
                    <StackPanel Visibility="{Binding IsShareVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="份额（%）" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <hc:NumericUpDown Value="{Binding FormShare, Mode=TwoWay}" Minimum="0" Maximum="100" Increment="10"
                                          ValueFormat="0" Height="32" Margin="0,6,0,12" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <StackPanel Width="180">
                            <TextBlock Text="起始日期" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBox Text="{Binding FormStart, StringFormat=yyyy-MM-dd, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Width="180" Margin="12,0,0,0">
                            <TextBlock Text="终止日期" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <TextBox Text="{Binding FormEnd, StringFormat=yyyy-MM-dd, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelCommand}" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="保存" Command="{Binding SaveCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- 解除确认 -->
        <Border Grid.RowSpan="6" Background="#66000000" Visibility="{Binding IsReleaseVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="确认解除关系？" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" />
                    <TextBlock Text="{Binding ReleaseRow.PropertyNo, StringFormat=房产：{0}}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="解除原因" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,12,0,6" />
                    <TextBox Text="{Binding ReleaseReason, UpdateSourceTrigger=PropertyChanged}" Height="64" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelReleaseCommand}" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="确认解除" Command="{Binding ConfirmReleaseCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- 批量解除 -->
        <Border Grid.RowSpan="6" Background="#66000000" Visibility="{Binding IsBatchVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="640" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="批量解除关系" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />
                    <!-- v1.2.0 第 3 轮：原「房号 / 业主」两个搜索框合并为一个，带放大镜标识与检索引导提示 -->
                    <Border Height="32" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Style="{StaticResource IconStroke}" Stroke="{StaticResource TextMutedBrush}" Width="14" Height="14" Margin="10,0,0,0" />
                            <TextBox Grid.Column="1" Style="{StaticResource SearchTextBox}" FontSize="12" Margin="8,0,12,0"
                                     Text="{Binding BatchSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     hc:InfoElement.Placeholder="搜索房号 / 业主姓名 / 电话" />
                        </Grid>
                    </Border>
                    <Border Height="220" Style="{StaticResource CardBorder}" Padding="0" Margin="0,14,0,0">
                        <DataGrid Style="{StaticResource GridStyle}" ItemsSource="{Binding BatchRelations}" IsReadOnly="True" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="40">
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding DataContext.IsBatchSelectAll, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Mode=TwoWay}"
                                                      Style="{StaticResource GridCheckBox}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      ToolTip="全选当前列表" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="RowCheckBox_Click" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="房号" Width="*" Binding="{Binding PropertyNo}" ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="业主" Width="120" Binding="{Binding OwnerName}" ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="关系类型" Width="90" Binding="{Binding RelTypeText}" ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="状态" Width="80" Binding="{Binding StatusText}" ElementStyle="{StaticResource GridCellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelBatchCommand}" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="解除选中" Command="{Binding ConfirmBatchCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>

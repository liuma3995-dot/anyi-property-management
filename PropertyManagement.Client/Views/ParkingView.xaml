<UserControl x:Class="PropertyManagement.Client.Views.ParkingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             FontFamily="微软雅黑">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 统计行 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="车位总数" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="{Binding Total}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold" Margin="0,8,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding CardUnderNote, UpdateSourceTrigger=PropertyChanged}" Height="22" Background="Transparent" BorderThickness="0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="保存" Command="{Binding SaveUnderNoteCommand}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="18,14" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="已售产权" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="{Binding OwnedCount}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold" Margin="0,8,0,4" />
                    <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding SoldRatioText}" Foreground="{StaticResource PrimaryBrush}" FontSize="11" />
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18,14" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="已出租" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="{Binding RentedCount}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold" Margin="0,8,0,4" />
                    <Border Background="{StaticResource SuccessSoftBrush}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left">
                        <!-- CHG-v1.1.0-12：租金已下线，「已出租」卡片副文案改为含绑定业主户数 -->
                        <TextBlock Text="{Binding RentedOwnerHintText}" Foreground="{StaticResource SuccessBrush}" FontSize="11" />
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource CardBorder}" Padding="18,14" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="空置" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="{Binding VacantCount}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold" Margin="0,8,0,4" />
                    <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding VacantHintText}" Foreground="{StaticResource WarningBrush}" FontSize="11" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 工具栏 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Height="32" Width="200" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Style="{StaticResource IconStroke}" Stroke="{StaticResource TextMutedBrush}" Width="14" Height="14" Margin="10,0,0,0" />
                        <TextBox Grid.Column="1" Style="{StaticResource SearchTextBox}" Text="{Binding SpaceNoKeyword, UpdateSourceTrigger=PropertyChanged}" hc:InfoElement.Placeholder="搜索车位编号" FontSize="11" Margin="8,0,12,0" />
                    </Grid>
                </Border>
                <ComboBox Height="32" MinWidth="120" Margin="8,0,0,0" SelectedIndex="0">
                    <ComboBoxItem Content="区域：全部" />
                </ComboBox>
                <ComboBox Height="32" Width="120" Margin="8,0,0,0" SelectedIndex="{Binding TypeFilter, Mode=TwoWay}">
                    <ComboBoxItem Content="类型：全部" />
                    <ComboBoxItem Content="类型：产权" />
                    <ComboBoxItem Content="类型：人防" />
                    <ComboBoxItem Content="类型：临时" />
                </ComboBox>
                <ComboBox Height="32" Width="120" Margin="8,0,0,0" SelectedIndex="{Binding StatusFilter, Mode=TwoWay}">
                    <ComboBoxItem Content="状态：全部" />
                    <ComboBoxItem Content="状态：已售" />
                    <ComboBoxItem Content="状态：已租" />
                    <ComboBoxItem Content="状态：空置" />
                    <ComboBoxItem Content="状态：维修中" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource ButtonPrimary}" Content="新增车位" Command="{Binding NewCommand}" />
                <Button Height="32" FontSize="13" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Content="批量删除" Command="{Binding BatchDeleteCommand}" Margin="10,0,0,0" />
                <Button Height="32" FontSize="13" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Content="导出 Excel" Command="{Binding ExportCommand}" Margin="10,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- 数据表 -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid Style="{StaticResource GridStyle}" ItemsSource="{Binding Items}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding DataContext.IsSelectAll, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Mode=TwoWay}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="全选" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="RowCheckBox_Click" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="车位编号" Width="72" Binding="{Binding SpaceNo}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="区域" Width="64" Binding="{Binding Area}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="类型" Width="56" Binding="{Binding TypeText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTemplateColumn Header="状态" Width="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBg}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="绑定房产" Width="*" Binding="{Binding BindProperty}" ElementStyle="{StaticResource GridCellText}" />
                    <!-- CHG-v1.1.0-11：租金/租期至下线（车位不再承载计费规则，定价统一由收费项目维护） -->
                    <DataGridTextColumn Header="绑定业主" Width="120" Binding="{Binding OwnerName}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTemplateColumn Header="操作" Width="132">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource LinkButton}" Content="查看" Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource LinkButton}" Content="编辑" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Margin="8,0,0,0" />
                                    <Button Style="{StaticResource LinkButton}" Content="删除" Foreground="{StaticResource DangerBrush}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Margin="8,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="6" Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="11" />

        <!-- 新增弹层 -->
        <Border Grid.RowSpan="7" Background="#66000000" Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,18" />
                    <TextBlock Text="车位编号 / 区域" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,12">
                        <TextBox x:Name="ParkingSpaceNoBox" Text="{Binding FormSpaceNo, UpdateSourceTrigger=PropertyChanged}" Height="32" Width="170" />
                        <TextBox Text="{Binding FormArea, UpdateSourceTrigger=PropertyChanged}" Height="32" Width="170" Margin="10,0,0,0" hc:InfoElement.Placeholder="区域，如 B1 层" />
                    </StackPanel>
                    <TextBlock Text="类型 / 状态" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,12">
                        <ComboBox x:Name="ParkingTypeCombo" SelectedValue="{Binding FormType}" SelectedValuePath="Tag" Width="170">
                            <ComboBoxItem Content="产权" Tag="PropertyRight" />
                            <ComboBoxItem Content="人防" Tag="CivilDefense" />
                            <ComboBoxItem Content="临时" Tag="Temporary" />
                        </ComboBox>
                        <ComboBox SelectedValue="{Binding FormStatus}" SelectedValuePath="Tag" Width="170" Margin="10,0,0,0">
                            <ComboBoxItem Content="已售" Tag="Owned" />
                            <ComboBoxItem Content="已租" Tag="Rented" />
                            <ComboBoxItem Content="空置" Tag="Vacant" />
                            <ComboBoxItem Content="维修中" Tag="Repairing" />
                        </ComboBox>
                    </StackPanel>
                    <!-- CHG-v1.1.0-12：绑定房产下线（改由「绑定业主 → 自动引用房产」，避免与业主-房产关系模块歧义） -->
                    <!-- CHG-v1.1.0-11：租金/租期至下线（定价统一由收费项目维护）；表单新增绑定业主 -->
                    <TextBlock Text="绑定业主" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <ComboBox x:Name="ParkingOwnerCombo" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True"
                              IsSynchronizedWithCurrentItem="False"
                              ItemsSource="{Binding OwnersView}" DisplayMemberPath="DisplayText"
                              SelectedItem="{Binding SelectedOwner, Mode=TwoWay}"
                              Text="{Binding OwnerSearchText, UpdateSourceTrigger=PropertyChanged}"
                              Height="32" Margin="0,6,0,12" MaxDropDownHeight="220" FontSize="12"
                              hc:InfoElement.Placeholder="输入业主姓名 / 手机号检索" />
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelCommand}" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="保存" Command="{Binding SaveCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- 车位详情 -->
        <Border Grid.RowSpan="7" Background="#66000000" Visibility="{Binding IsViewVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="车位详情" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding ViewRow.SpaceNo}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="区域" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                            <TextBlock Text="{Binding ViewRow.Area}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="类型" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                            <TextBlock Text="{Binding ViewRow.TypeText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="状态" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                            <TextBlock Text="{Binding ViewRow.StatusText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="绑定房产" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                            <TextBlock Text="{Binding ViewRow.BindProperty}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <!-- CHG-v1.1.0-11：详情面板同步下线「租金 / 租期至」，保留绑定业主 -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="绑定业主" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                            <TextBlock Text="{Binding ViewRow.OwnerName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource ButtonSecondary}" Content="关闭" Command="{Binding CloseViewCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- 删除确认 -->
        <Border Grid.RowSpan="7" Background="#66000000" Visibility="{Binding IsDeleteVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="确认删除车位？" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" />
                    <TextBlock Text="{Binding DeleteRow.SpaceNo, StringFormat=车位：{0}}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="删除后该车位将从列表移除（软删除留痕）。" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelDeleteCommand}" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="确认删除" Command="{Binding ConfirmDeleteCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- 批量删除确认 -->
        <Border Grid.RowSpan="7" Background="#66000000" Visibility="{Binding IsBatchConfirmVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="确认批量删除车位？" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" />
                    <TextBlock Text="{Binding BatchConfirmMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="删除后这些车位将从列表移除（软删除留痕）。" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelBatchDeleteCommand}" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="确认删除" Command="{Binding ConfirmBatchDeleteCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>

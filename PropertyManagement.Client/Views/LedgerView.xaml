<UserControl x:Class="PropertyManagement.Client.Views.LedgerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             FontFamily="微软雅黑">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 筛选栏 ============ -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="118" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="118" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="126" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="日期范围" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <DatePicker Grid.Column="1" Height="32" FontSize="12" SelectedDate="{Binding From}" />
                <TextBlock Grid.Column="2" Text="至" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="8,0" />
                <DatePicker Grid.Column="3" Height="32" FontSize="12" SelectedDate="{Binding To}" />
                <TextBlock Grid.Column="4" Text="类型" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="14,0,8,0" />
                <ComboBox Grid.Column="5" Height="32" FontSize="12" VerticalContentAlignment="Center"
                          SelectedIndex="{Binding BizTypeFilter}">
                    <ComboBoxItem Content="全部" />
                    <ComboBoxItem Content="收款" />
                    <ComboBoxItem Content="支出" />
                    <ComboBoxItem Content="退款" />
                </ComboBox>
                <TextBlock Grid.Column="6" Text="项目" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="14,0,8,0" />
                <ComboBox Grid.Column="7" Height="32" FontSize="12" VerticalContentAlignment="Center"
                          ItemsSource="{Binding Subjects}" SelectedIndex="{Binding SubjectFilter}" />
                <Border Grid.Column="8" Height="34" Background="#F7F4EE" BorderBrush="{StaticResource BorderBrushColor}"
                        BorderThickness="1" CornerRadius="6" Margin="14,0,14,0">
                    <!-- CHG-v2.0.0-04：引导文案补「楼栋/单元/房号」，并加回车快捷查询（Enter = 查询按钮） -->
                    <TextBox x:Name="LedgerKeywordBox" Style="{StaticResource SearchTextBox}" FontSize="12"
                             Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                             hc:InfoElement.Placeholder="搜索单据号 / 付款人 / 项目 / 楼栋 / 单元 / 房号"
                             VerticalContentAlignment="Center" KeyDown="KeywordBox_KeyDown"
                             ToolTip="回车可直接查询；支持按楼栋 / 单元 / 房号检索" />
                </Border>
                <Button Grid.Column="9" Style="{StaticResource ButtonPrimary}" Content="查询" Command="{Binding SearchCommand}"
                        Margin="0,0,10,0" />
                <!-- CHG-v1.1.2-05：导出功能实现（原按钮只弹提示让用户去财务报表生成总表） -->
                <Button Grid.Column="10" Style="{StaticResource LinkButton}" Content="导出Excel" FontSize="13"
                        VerticalAlignment="Center" Command="{Binding ExportExcelCommand}" />
                <Button Grid.Column="11" Style="{StaticResource LinkButton}" Content="导出PDF" FontSize="13"
                        VerticalAlignment="Center" Margin="10,0,0,0" Command="{Binding ExportPdfCommand}" />
            </Grid>
        </Border>

        <!-- ============ 流水表 ============ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="收支明细流水（只读，错账以红冲负数记录）" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding TotalText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,16,0" VerticalAlignment="Center" />
                </Grid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" IsReadOnly="True"
                          MouseDoubleClick="DataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="流水号" Width="100" Binding="{Binding NoText}" ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTextColumn Header="日期" Width="100" Binding="{Binding DateText}" ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTemplateColumn Header="收/支" Width="64">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding TypeBg}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding TypeText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding TypeBrush}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="项目" Width="*" Binding="{Binding Category}" ElementStyle="{StaticResource GridCellText}" />
                        <!-- CHG-v1.1.2-05 / CHG-v1.1.2-13：「楼栋/房号/单元」——
                             房产取楼栋/单元/房号，车位取车位编号，业主直缴按业主名下主房产回填，跨模块引用基础信息档案 -->
                        <DataGridTextColumn Header="楼栋/房号/单元" Width="150" Binding="{Binding ObjectText}" ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTextColumn Header="金额" Width="120" Binding="{Binding AmountText}" ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTextColumn Header="支付方式" Width="100" Binding="{Binding PayMethodText}" ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTextColumn Header="关联单据" Width="130" Binding="{Binding BizNo}" ElementStyle="{StaticResource GridCellText}" />
                        <!-- CHG-v1.1.0-18：表头口径改为「付款人」（含业主与自定义缴费对象手工填写的名称） -->
                        <!-- CHG-v1.2.0-30：付款人解析补齐「缴费对象 = 业主」档后，该列由「—」变为真实姓名，
                             原 100px 放不下「姓名 + 长名」→ 加宽至 132 并补悬停查看完整值（不再出现截断观感） -->
                        <DataGridTextColumn Header="付款人" Width="132" Binding="{Binding OwnerNameText}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                    <Setter Property="ToolTip" Value="{Binding OwnerNameText}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="经手人" Width="100" Binding="{Binding OperatorName}" ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTemplateColumn Header="操作" Width="64">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource LinkButton}" Content="查看"
                                            Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ============ 状态/错误条 ============ -->
        <!-- CHG-v1.1.2-11：状态/错误条改为可换行容器，长提示不再被右侧裁切 -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorText}" FontSize="11" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ============ 流水与来源单据明细（点击「查看」或双击行） ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="5" Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="640" MaxHeight="690" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="{Binding DetailTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="收支明细流水（只读）" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,14" />
                    <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="12,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="流水号" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedRow.NoText}" FontSize="12" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="日期" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding SelectedRow.DateText}" FontSize="12" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="类型" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedRow.BizTypeText}" FontSize="12" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="金额" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding SelectedRow.AmountText}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="付款人" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedRow.OwnerNameText}" FontSize="12" />
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="关联单据" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                    <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding SelectedRow.BizNo}" FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <StackPanel Visibility="{Binding HasBill, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="账单明细" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="账单号" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DetailBillNo}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="收费项目" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding DetailChargeItem}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="缴费对象" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetailObject}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="缴费人" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding DetailPayer}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="账单期间" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DetailCycle}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="到期日" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding DetailDueAt}" />
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="应收" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding DetailAmount}" />
                                    <TextBlock Grid.Row="6" Grid.Column="2" Text="实缴" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="6" Grid.Column="3" Text="{Binding DetailPaid}" />
                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="未收" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding DetailUnpaid}" Foreground="{StaticResource DangerBrush}" />
                                    <TextBlock Grid.Row="8" Grid.Column="2" Text="状态" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="8" Grid.Column="3" Text="{Binding DetailBillStatus}" />
                                </Grid>
                            </StackPanel>

                            <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="6" Padding="12,10" Margin="0,14,0,0"
                                    Visibility="{Binding NoBillVisible, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding DetailNoBillReason}" Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" />
                            </Border>

                            <StackPanel Visibility="{Binding HasAdjustment, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="调整单据" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="单据类型" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DetailAdjustmentType}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="方向" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding DetailAdjustmentDirection}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="金额" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetailAdjustmentAmount}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="方式" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding DetailAdjustmentMethod}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="经手人" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding DetailAdjustmentOperator}" />
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="原因" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding DetailAdjustmentReason}" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasExpense, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="支出单据" FontSize="13" FontWeight="SemiBold" Margin="0,16,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="支出分类" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DetailExpenseCategory}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="支出日期" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding DetailExpenseDate}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="收款方" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetailExpensePayee}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="金额" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding DetailExpenseAmount}" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="备注" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding DetailExpenseNote}" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Style="{StaticResource ButtonPrimary}" Content="关闭" FontSize="13" Margin="0,16,0,0"
                            HorizontalAlignment="Right" Command="{Binding CloseDetailCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

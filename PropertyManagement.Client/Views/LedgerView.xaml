<UserControl x:Class="PropertyManagement.Client.Views.LedgerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             FontFamily="微软雅黑">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 筛选栏 ============ -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="118" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="118" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="126" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="日期范围" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <DatePicker Grid.Column="1" Height="32" FontSize="12" SelectedDate="{Binding From}" />
                <TextBlock Grid.Column="2" Text="至" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="8,0" />
                <DatePicker Grid.Column="3" Height="32" FontSize="12" SelectedDate="{Binding To}" />
                <TextBlock Grid.Column="4" Text="类型" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="14,0,8,0" />
                <ComboBox Grid.Column="5" Height="32" FontSize="12" VerticalContentAlignment="Center"
                          SelectedIndex="{Binding BizTypeFilter}">
                    <ComboBoxItem Content="全部" />
                    <ComboBoxItem Content="收款" />
                    <ComboBoxItem Content="支出" />
                    <ComboBoxItem Content="退款" />
                </ComboBox>
                <TextBlock Grid.Column="6" Text="项目" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="14,0,8,0" />
                <ComboBox Grid.Column="7" Height="32" FontSize="12" VerticalContentAlignment="Center"
                          ItemsSource="{Binding Subjects}" SelectedIndex="{Binding SubjectFilter}" />
                <Border Grid.Column="8" Height="34" Background="#F7F4EE" BorderBrush="{StaticResource BorderBrushColor}"
                        BorderThickness="1" CornerRadius="6" Margin="14,0,14,0">
                    <TextBox x:Name="LedgerKeywordBox" Style="{StaticResource SearchTextBox}" FontSize="12"
                             Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                             hc:InfoElement.Placeholder="搜索单据号 / 付款人 / 项目" VerticalContentAlignment="Center" />
                </Border>
                <Button Grid.Column="9" Style="{StaticResource ButtonPrimary}" Content="查询" Command="{Binding SearchCommand}"
                        Margin="0,0,10,0" />
                <Button Grid.Column="10" Style="{StaticResource LinkButton}" Content="导出" FontSize="13"
                        VerticalAlignment="Center" Click="ExportButton_Click" />
            </Grid>
        </Border>

        <!-- ============ 流水表 ============ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="收支明细流水（只读，错账以红冲负数记录）" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding TotalText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,0,16,0" VerticalAlignment="Center" />
                </Grid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" IsReadOnly="True"
                          MouseDoubleClick="DataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="流水号" Width="100" Binding="{Binding NoText}" ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTextColumn Header="日期" Width="100" Binding="{Binding DateText}" ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTemplateColumn Header="收/支" Width="64">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding TypeBg}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding TypeText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding TypeBrush}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="项目" Width="*" Binding="{Binding Category}" ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTextColumn Header="金额" Width="120" Binding="{Binding AmountText}" ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTextColumn Header="支付方式" Width="100" Binding="{Binding PayMethodText}" ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTextColumn Header="关联单据" Width="130" Binding="{Binding BizNo}" ElementStyle="{StaticResource GridCellText}" />
                        <!-- CHG-v1.1.0-18：表头口径改为「付款人」（含业主与自定义缴费对象手工填写的名称） -->
                        <DataGridTextColumn Header="付款人" Width="100" Binding="{Binding OwnerNameText}" ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTextColumn Header="经手人" Width="100" Binding="{Binding OperatorName}" ElementStyle="{StaticResource GridCellText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ============ 状态/错误条 ============ -->
        <TextBlock Grid.Row="4" Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource SuccessBrush}" />
        <TextBlock Grid.Row="4" Text="{Binding ErrorText}" FontSize="11" Foreground="{StaticResource DangerBrush}" />

        <!-- ============ 关联单据详情浮层（行点击，T4F-7-1） ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="5" Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="430" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="关联单据详情" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="收支明细流水（只读）" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,6,0,18" TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="流水号" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedRow.NoText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="日期" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedRow.DateText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="类型" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedRow.BizTypeText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="项目" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedRow.Category}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="金额" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedRow.AmountText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Grid.Row="10" Grid.Column="0" Text="支付方式" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding SelectedRow.PayMethodText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Grid.Row="12" Grid.Column="0" Text="关联单据" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding SelectedRow.BizNo}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Grid.Row="14" Grid.Column="0" Text="付款人" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="14" Grid.Column="1" Text="{Binding SelectedRow.OwnerNameText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Grid>

                    <Button Style="{StaticResource ButtonPrimary}" Content="关闭" FontSize="13" Margin="0,22,0,0"
                            HorizontalAlignment="Right" Command="{Binding CloseDetailCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="PropertyManagement.Client.Views.RefundAdjustmentView"
             PreviewMouseDown="Root_PreviewMouseDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:conv="clr-namespace:PropertyManagement.Client.Converters"
             xmlns:controls="clr-namespace:PropertyManagement.Client.Assets.Controls"
             FontFamily="微软雅黑">
    <UserControl.Resources>
        <conv:IntEqualsConverter x:Key="IntEquals" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <!-- CHG-v1.1.2-45：不再套外层 ScrollViewer —— 宿主对页面高度无约束时，ScrollViewer 的
         「视口高＝内容高」会与记录表高度计算形成自反馈（实测行数一路涨到 13 行）。
         页面高度一律以宿主（Parent）的真实高度为准（见代码后置 ApplyRecordsTableHeight）。 -->
    <Grid x:Name="PageGrid" Margin="24,10" SizeChanged="PageGrid_SizeChanged" Loaded="PageGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 上排：三页签表单 + 审批节点流 ============ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 表单卡片 -->
            <!-- CHG-v1.1.2-44：纵向收口 —— 1366×768 真机下页面可用高度仅 670px，原表单内边距/行距偏松，
                 挤压了下方「最近申请记录」表格（只剩表头）。此处统一收紧 6~8px 级间距，让记录表稳定显示 2 整行。 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="18,12">
                <StackPanel>
                    <!-- 三页签 -->
                    <Border Height="30" Background="#F1F3F7" CornerRadius="8">
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" Content="退款申请" GroupName="RefundTabs" IsChecked="{Binding RefundType, Converter={StaticResource IntEquals}, ConverterParameter=0}"
                                     Style="{StaticResource TabRadioStyle}" />
                        <RadioButton Grid.Column="1" Content="费用减免" GroupName="RefundTabs" IsChecked="{Binding RefundType, Converter={StaticResource IntEquals}, ConverterParameter=1}"
                                     Style="{StaticResource TabRadioStyle}" />
                        <RadioButton Grid.Column="2" Content="账务调整" GroupName="RefundTabs" IsChecked="{Binding RefundType, Converter={StaticResource IntEquals}, ConverterParameter=2}"
                                     Style="{StaticResource TabRadioStyle}" />
                    </Grid>
                </Border>

                    <TextBlock Text="{Binding FormTitle}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,8,0,6" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- CHG-v1.1.0-13：关联对象覆盖房产/车位/业主直缴（原「关联房产」） -->
                        <!-- CHG-v1.2.0-34：改为按缴费人（业主）聚合 —— 「业主姓名 · 楼栋/单元/房号 · 账单 N 笔」，
                             文案较原「姓名 · 房号」更长 → 补悬停提示，窄面板下也能看清完整关联对象 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="关联对象" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="RefundObjectCombo" Grid.Row="0" Grid.Column="1" Height="32" FontSize="12" VerticalContentAlignment="Center"
                                  ItemsSource="{Binding Properties}" SelectedItem="{Binding SelectedProperty}" DisplayMemberPath="DisplayText"
                                  ToolTip="{Binding SelectedProperty.DisplayText}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="关联账单" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <!-- CHG-v1.1.0-13：关联账单改为可多选/全选的下拉浮层（原单选下拉） -->
                        <!-- CHG-v1.1.0-15：选择器宽度与「关联对象」下拉框同步（显式 Stretch + 同一列宽） -->
                        <ToggleButton x:Name="RefundBillSelector" Grid.Row="2" Grid.Column="1" Height="32" FontSize="12"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                      HorizontalContentAlignment="Left" Padding="10,0"
                                      IsChecked="{Binding IsBillPickerOpen, Mode=OneWay}"
                                      Click="BillPickerToggle_Click">
                            <TextBlock Text="{Binding BillPickerText}" TextTrimming="CharacterEllipsis" />
                        </ToggleButton>
                        <!-- CHG-v1.2.0-37：多选浮层由 Popup（独立顶层窗口，会「全局置顶/遮挡窗口外界面」且与窗口分离）
                             改为**窗口内浮层**（BillPickerFlyout，见 PageGrid 末尾）—— 位置由代码后置按选择器实时计算，
                             不再有自己的 HWND：既不会浮到别的窗口之上，也不会在拖动窗口时分离。 -->
                        <!-- CHG-v1.2.0-36：勾选汇总增加账单号 → 文案更长，改为省略号 + 悬停查看完整内容 -->
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CheckedBillsText}" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,4"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding CheckedBillsText}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding AmountLabelFull}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Row="4" Grid.Column="1" Height="36" Background="#F7F4EE"
                                BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6">
                            <!-- CHG-v1.1.2-08：改用 DecimalTextBox（原 StringFormat 绑定会边输边格式化，12.12 变 12.12.00） -->
                            <!-- CHG-v1.2.0-37：多选（≥2 张）时金额＝勾选账单合计并锁定（与收款登记「统一收款」同口径）；
                                 单张仍可改额（支持部分退/减） -->
                            <controls:DecimalTextBox Style="{StaticResource SearchTextBox}" FontSize="15" FontWeight="SemiBold"
                                     Foreground="{StaticResource DangerBrush}"
                                     IsEnabled="{Binding IsAmountEditable}"
                                     Value="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" />
                        </Border>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="方式" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <!-- CHG-v1.1.2-12：账务调整的 +/− 由「方式」决定（补收＝＋ / 冲正＝−）
                             CHG-v1.1.2-19：提示文字与下拉框同格堆叠（原放在下方 12px 间隔行，被压缩遮挡） -->
                        <StackPanel Grid.Row="6" Grid.Column="1">
                            <ComboBox Height="32" FontSize="12" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding MethodOptions}" SelectedIndex="{Binding MethodIndex}" />
                            <TextBlock Text="{Binding DirectionHint}" FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="原因" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Top" Margin="0,4,0,0" />
                        <Border Grid.Row="8" Grid.Column="1" Height="38" Background="#F7F4EE"
                                BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6">
                            <TextBox Style="{StaticResource SearchTextBox}" FontSize="12" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" Padding="8,5"
                                     Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                                     hc:InfoElement.Placeholder="必填：如 重复缴费、空置减免、单价更正…" />
                        </Border>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="附件" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Row="10" Grid.Column="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center">
                                    <Run Text="附件：" /><Run Text="{Binding AttachmentName, Mode=OneWay}" FontWeight="SemiBold" />
                            <!-- CHG-v1.1.0-14：附件改为可选项 -->
                            <Run Text="（可选，≤5MB）" Foreground="{StaticResource TextMutedBrush}" />
                                </TextBlock>
                                <Button Grid.Column="1" Content="选择附件…" FontSize="12" Padding="12,4"
                                        Command="{Binding PickAttachmentCommand}" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- 大额提示 + 负责人确认（CHG-v1.1.2-44：由上下两行合并为一行，省出 ~26px 纵向空间，
                         避免大额场景把下方记录表挤出可视区） -->
                    <Border Background="#FFF5DC" CornerRadius="6" Padding="10,6" Margin="0,10,0,0"
                            Visibility="{Binding HasLargeHint, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LargeHint}" FontSize="11" Foreground="#B76E00"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" Content="负责人已确认" IsChecked="{Binding Confirmed}" FontSize="12"
                                      Foreground="{StaticResource TextPrimaryBrush}" Margin="12,0,0,0"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- CHG-v1.1.2-43：「暂存」按钮下线 —— 原实现是「假暂存」（清空表单 + 提示已暂存，
                         无任何持久化，还会丢掉刚填的内容）；本模块登记即落账，无草稿业务需求。
                         下线后主操作整行铺满，避免右侧留空。 -->
                    <Button Margin="0,10,0,0" Style="{StaticResource ButtonPrimary}" Content="提交审批"
                            Command="{Binding SubmitCommand}" />
                </StackPanel>
            </Border>

            <!-- 审批节点流（本期不落地，仅状态展示） -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="审批节点流" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="本期不落地审批流，登记即生效（大额需负责人确认）"
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,16" />

                    <ItemsControl>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Width="92">
                                        <Border Width="26" Height="26" CornerRadius="13"
                                                Background="#1F4B43" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Index}" FontSize="11" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="→" FontSize="12" Foreground="#C3CCD8" VerticalAlignment="Top" Margin="4,6,4,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Rectangle Height="1" Fill="{StaticResource BorderBrushColor}" Margin="0,18,0,14" />
                    <TextBlock Text="节点说明" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="提交申请 → 客服主管审核 → 财务复核 → 负责人审批 → 原路退回（全程留痕）"
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <Border Background="#F7F5FE" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                        <TextBlock Text="本期单角色（系统管理员）：退款/减免/调整 &gt; ¥1,000 → 勾选负责人确认后提交；驳回/短信通知等审批流能力在多人协作版提供。"
                                   FontSize="10" Foreground="#4A3AB0" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 最近申请记录 ============ -->
        <Border x:Name="RecordsCard" Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="最近申请记录" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                <!-- CHG-v1.1.2-44/-45：记录表高度按可用高度**自动排整行**（代码后置 PageGrid_SizeChanged 计算），
                     口径：表头 36 + N × 行高 44，N = 可用高度能放下的完整行数，下限 2 行（1366×768 下即 2 行）。
                     保证 ① 小分辨率下至少 2 整行完整可见；② 窗口最大化时把可用高度用满、能放几行就展示几行；
                     ③ 永不出现「只露表头 / 半截行」的遮挡。 -->
                <DataGrid x:Name="RecordsGrid" Grid.Row="1" ItemsSource="{Binding Records}" IsReadOnly="True" AutoGenerateColumns="False"
                          VerticalAlignment="Top">
                    <DataGrid.Columns>
                        <!-- CHG-v1.1.2-43：申请编号完整展示（形如 RF-20260920145402758-35，共 23 字符）——
                             原宽 130px 会被省略号截断，单据编号是导出 PDF / 审计反查的凭据，不得裁切；
                             宽度从「原因」列（自适应 *）让出，不影响其它列。 -->
                        <DataGridTextColumn Header="申请编号" Width="230" Binding="{Binding NoText}" ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTemplateColumn Header="类型" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding TypeBg}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding TypeText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding TypeBrush}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="关联房产" Width="100" Binding="{Binding PropertyNoText}" ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTextColumn Header="金额" Width="100" Binding="{Binding AmountText}" ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTextColumn Header="原因" Width="*" Binding="{Binding Reason}" ElementStyle="{StaticResource GridCellText}" />
                        <!-- CHG-v1.1.2-41：经办人随单据落库（导出 PDF 的必备要素，旧数据为 —） -->
                        <DataGridTextColumn Header="经办人" Width="90" Binding="{Binding OperatorText}" ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTemplateColumn Header="状态" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#E8F7F1" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#12805C" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- CHG-v1.1.2-12：原「当前节点」为开发期 mock 列，改为展示已落库的「方式」 -->
                        <DataGridTextColumn Header="方式" Width="120" Binding="{Binding MethodText}" ElementStyle="{StaticResource GridCellText}" />
                        <!-- CHG-v1.1.2-41：提交后可导出单据 PDF（退款申请/费用减免/财务调整详情），用于留档与审计追溯 -->
                        <DataGridTemplateColumn Header="操作" Width="96">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="导出PDF" FontSize="11" Padding="10,2" Margin="4,0"
                                            Style="{StaticResource LinkButton}"
                                            Command="{Binding ExportCommand}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ============ 状态/错误条 ============ -->
        <!-- CHG-v1.1.2-11：状态/错误条改为可换行容器 ——
             原为单行 TextBlock，像「账单已冲正，不能重复退款…」这类长提示会被右侧裁切（负责人反馈的遮挡问题） -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorText}" FontSize="11" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ============ 关联账单多选浮层（CHG-v1.2.0-37：窗口内浮层，非 Popup） ============ -->
        <!-- 位置/宽度/最大高度由代码后置按「关联账单」选择器实时计算（UpdateBillFlyoutPlacement），
             因此它始终在软件窗口内部：不会全局置顶遮挡其它界面，也不会随窗口拖动而分离；
             勾选行不会让浮层消失（关闭仅由「再次点选择器」或「点浮层外」触发）。 -->
        <Border x:Name="BillPickerFlyout" Panel.ZIndex="90"
                Visibility="{Binding IsBillPickerOpen, Converter={StaticResource BoolToVis}}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="1" CornerRadius="6" MinWidth="320">
            <StackPanel>
                <!-- CHG-v1.2.0-36：全选右侧新增「删除旧账单」入口；「不指定关联对象」时全选禁用 -->
                <Border Background="#F7F4EE" Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="全选" FontSize="12" VerticalAlignment="Center"
                                  IsChecked="{Binding IsSelectAllBills, Mode=TwoWay}"
                                  IsEnabled="{Binding CanSelectAllBills}"
                                  ToolTip="{Binding SelectAllHintText}" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectAllHintText}" FontSize="10"
                                   Margin="10,0,8,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <Button Grid.Column="2" Content="删除旧账单" FontSize="11" Height="24" Padding="8,0"
                                VerticalAlignment="Center"
                                Command="{Binding RequestDeleteBillsCommand}"
                                ToolTip="删除勾选的已结清旧账单（未缴费账单不可删除）；只从本列表移除，账务记录保留">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="210">
                    <ItemsControl ItemsSource="{Binding FilteredBills}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="10,6" FontSize="11" HorizontalContentAlignment="Left"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay}">
                                    <TextBlock TextTrimming="CharacterEllipsis" MaxWidth="380">
                                        <Run Text="{Binding NoText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ObjectText, Mode=OneWay}" />
                                        <Run Text=" · " /><Run Text="{Binding Dto.ChargeItemName, Mode=OneWay}" />
                                        <!-- CHG-v1.1.2-40：金额提示随页签口径（退款/调整＝实缴；减免＝未收余额） -->
                                        <Run Text=" · " /><Run Text="{Binding PickerMoneyText, Mode=OneWay}" />
                                    </TextBlock>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Border Background="#FAF8F4" Padding="10,6">
                    <TextBlock Text="{Binding CheckedBillsText}" FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <!-- ============ 确认弹层（CHG-v1.2.0-36：多选提交范围确认 / 删除旧账单确认） ============ -->
        <Grid Grid.RowSpan="5" Background="#66000000" Visibility="{Binding IsConfirmVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="520" Style="{StaticResource CardBorder}" Padding="24,20"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding ConfirmTitle}" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ConfirmMessage}" FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,16,0,0"
                               HorizontalAlignment="Left" TextWrapping="Wrap" LineHeight="19" />
                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonPrimary}"
                                Content="{Binding ConfirmOkText}" Command="{Binding ConfirmActionCommand}" />
                        <Button Grid.Column="2" Content="取消" Command="{Binding CancelActionCommand}" FontSize="13" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

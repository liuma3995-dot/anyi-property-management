<UserControl x:Class="PropertyManagement.Client.Views.BillWorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PropertyManagement.Client.Views"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             FontFamily="微软雅黑">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- CHG-v1.1.2-34：有手填计量参数时用输入框，无则回到只读展示 -->
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <!-- CHG-v1.1.0-23：账单期间紧凑显示 + 悬停查看完整期间 -->
        <Style x:Key="GridCellTextWithTip" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
            <Setter Property="ToolTip" Value="{Binding CyclePeriodFull}" />
        </Style>
        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="#FAFBFD" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowHeight" Value="44" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FAF8F4" />
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Height" Value="36" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridRow">
                                    <Border x:Name="RowBg" Background="{TemplateBinding Background}">
                                        <DataGridCellsPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowBg" Property="Background" Value="#F2F7FE" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="RowBg" Property="Background" Value="#E7EBF0" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}" VerticalAlignment="Center">
                                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E9F0EE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- CHG-v1.1.0-10：灰字提示行（文本为空时自动折叠） -->
        <Style x:Key="HintLine" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="118" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 统计卡（4，T4F-2-1 副文案对齐原型） ============ -->
        <UniformGrid Grid.Row="0" Columns="4">
            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="草稿账单" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding DraftText}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="待发布核对" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="7,0">
                <StackPanel>
                    <TextBlock Text="已发布" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding PublishedText}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding PublishedSubText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="7,0">
                <StackPanel>
                    <TextBlock Text="部分缴纳" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding PartialText}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"
                               Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="{Binding PartialSubText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="7,0,0,0">
                <StackPanel>
                    <TextBlock Text="发布失败" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding FailedText}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"
                               Foreground="{StaticResource DangerBrush}" />
                    <!-- CHG-v1.1.0-21：卡片提示「可一键重推」原先只是文案，未接功能；此处补齐一键重推入口
                         CHG-v1.1.0-22：提示语与入口同一行 —— 统计卡行高固定 118，第 4 行会被裁切（按钮被遮挡） -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="失败对象可一键重推" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <Button Style="{StaticResource LinkButton}" Content="一键重推" FontSize="11" Padding="0"
                                VerticalAlignment="Center" Margin="8,0,0,0"
                                Command="{Binding RetryAllFailuresCommand}"
                                Visibility="{Binding HasFailedBatches, Converter={StaticResource BoolToVis}}"
                                ToolTip="按批次重推全部发布失败对象（等价逐批次点「重推」）" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ============ 工具栏（T4F-2-1：期间/状态筛选） ============ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="34" Background="#F7F4EE" BorderBrush="{StaticResource BorderBrushColor}"
                        BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Style="{StaticResource IconStroke}"
                              Stroke="{StaticResource TextMutedBrush}" Width="14" Height="14" Margin="10,0,0,0"
                              VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Style="{StaticResource SearchTextBox}"
                                 Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                                 hc:InfoElement.Placeholder="搜索批次号 / 项目"
                                 Margin="8,0,0,0" />
                    </Grid>
                </Border>
                <TextBlock Grid.Column="1" Text="账单期间" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="14,0,8,0" />
                <ComboBox Grid.Column="2" Height="32" FontSize="12" VerticalContentAlignment="Center"
                          ItemsSource="{Binding PeriodFilterOptions}" SelectedItem="{Binding PeriodFilter}" />
                <TextBlock Grid.Column="3" Text="状态" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="14,0,8,0" />
                <ComboBox Grid.Column="4" Height="32" FontSize="12" VerticalContentAlignment="Center"
                          SelectedIndex="{Binding StatusFilter}">
                    <ComboBoxItem Content="全部" />
                    <ComboBoxItem Content="草稿" />
                    <ComboBoxItem Content="已发布" />
                    <ComboBoxItem Content="部分缴纳" />
                    <ComboBoxItem Content="发布失败" />
                </ComboBox>
                <Button Grid.Column="6" Style="{StaticResource ButtonPrimary}" Content="生成账单"
                        Command="{Binding OpenGenerateCommand}" Margin="0,0,10,0" />
                <Button Grid.Column="7" Height="32" FontSize="13" Background="{StaticResource SurfaceBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrushColor}"
                        BorderThickness="1" Content="批量删除" Command="{Binding BatchDeleteCommand}" Margin="0,0,10,0" />
                <Button Grid.Column="8" Style="{StaticResource LinkButton}" Content="失败清单"
                        FontSize="13" VerticalAlignment="Center" Command="{Binding ShowAllFailuresCommand}" />
            </Grid>
        </Border>

        <!-- ============ 批次表格（T4F-2-1：操作按状态派生） ============ -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid Style="{StaticResource GridStyle}" ItemsSource="{Binding Batches}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding DataContext.IsSelectAll, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Mode=TwoWay}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="全选" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="RowCheckBox_Click" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="批次号" Width="110" Binding="{Binding BatchNoText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="收费项目" Width="*" Binding="{Binding ChargeItemName}" ElementStyle="{StaticResource GridCellText}" />
                    <!-- CHG-v1.1.0-23：账单期间紧凑显示（同年省略结束年份）并加宽，避免日期被省略号遮挡；悬停看完整期间 -->
                    <DataGridTextColumn Header="账单期间" Width="150" MinWidth="150" Binding="{Binding CyclePeriodText}"
                                        ElementStyle="{StaticResource GridCellTextWithTip}" />
                    <DataGridTextColumn Header="户数" Width="70" Binding="{Binding HouseCountText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="总金额" Width="120" Binding="{Binding TotalAmountText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTemplateColumn Header="状态" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBg}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding StatusBrush}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="发布时间" Width="120" Binding="{Binding PublishTimeText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTemplateColumn Header="操作" Width="250">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- 草稿：发布 + 编辑 -->
                                    <Button Content="发布"
                                            Command="{Binding DataContext.PublishCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanPublish}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="编辑"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanEdit}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <!-- 已发布/部分缴纳：查看 -->
                                    <Button Content="查看"
                                            Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanView}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <!-- 部分缴纳：催缴 -->
                                    <Button Content="催缴"
                                            Command="{Binding DataContext.RemindCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanRemind}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <!-- 失败：重推 + 失败明细 -->
                                    <Button Content="重推"
                                            Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanRetry}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="失败明细"
                                            Command="{Binding DataContext.ShowFailuresCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanShowFailures}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <!-- CHG-M4-16：任意状态批次删除（软删批次及其账单，保留轨迹） -->
                                    <Button Content="删除"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanDelete}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ============ 状态/错误条 ============ -->
        <!-- CHG-v1.1.2-11：状态/错误条改为可换行容器，长提示不再被右侧裁切 -->
        <StackPanel Grid.Row="6">
            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorText}" FontSize="11" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ============ 生成账单浮层 ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="7" Visibility="{Binding IsGenerateVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="1000" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="700">
                <StackPanel>
                    <TextBlock Text="生成账单（草稿）" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="依次选择收费项目、计费周期与缴费对象，生成草稿账单；校验不通过的对象进入失败清单"
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,16" />

                    <TextBlock Text="收费项目" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <ComboBox x:Name="BillChargeItemCombo" Height="34" Margin="0,8,0,14" FontSize="12" VerticalContentAlignment="Center"
                              ItemsSource="{Binding ChargeItems}" SelectedItem="{Binding SelectedItem}"
                              DisplayMemberPath="Name" />

                    <TextBlock Text="计费周期" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <ComboBox x:Name="BillCycleCombo" Height="34" Margin="0,8,0,20" FontSize="12" VerticalContentAlignment="Center"
                              ItemsSource="{Binding Cycles}" SelectedItem="{Binding SelectedCycle}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding StartDate, StringFormat={}{0:yyyy-MM-dd}}" />
                                    <Run Text=" ~ " />
                                    <Run Text="{Binding EndDate, StringFormat={}{0:yyyy-MM-dd}}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!-- CHG-v1.1.2-35：周期派生变量的折算口径（每年 → 12 个月 = 1 年） -->
                    <TextBlock Margin="0,-14,0,10" FontSize="9" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"
                               Text="周期折算：「月数 / 年数 / 天数」按收费标准的计费周期自动折算（每年 = 12 个月 · 1 年；每季 = 3 个月；每月 = 1 个月）；一次性不计周期倍数（三项均按 1 参与计算）；自定义周期按账期起止日期跨度折算。" />

                    <!-- CHG-M4-16：生成账单计费周期自定义（不再固定内置月份） -->
                    <TextBlock Text="自定义周期（可选，按起止日期新增）" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="开始日期" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <DatePicker Grid.Column="1" Height="34" FontSize="12"
                                    SelectedDate="{Binding NewCycleStart}" />
                        <TextBlock Grid.Column="2" Text="" />
                        <TextBlock Grid.Column="3" Text="结束日期" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <DatePicker Grid.Column="4" Height="34" FontSize="12"
                                    SelectedDate="{Binding NewCycleEnd}" />
                        <Button Grid.Column="5" Style="{StaticResource LinkButton}" Content="添加周期"
                                FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" Command="{Binding AddCycleCommand}" />
                        <!-- CHG-v1.1.0-17：删除当前选中的自定义周期（内置周期/已被账单引用由服务端拦截） -->
                        <Button Grid.Column="6" Style="{StaticResource LinkButton}" Content="删除周期"
                                Foreground="{StaticResource DangerBrush}"
                                FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" Command="{Binding DeleteCycleCommand}" />
                    </Grid>
                    <TextBlock Text="添加后自动选中；也可直接填好日期点“生成草稿”（自动建周期再生成）；“删除周期”删除当前选中的自定义周期"
                               FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,2" TextWrapping="Wrap" />

                    <!-- CHG-v1.1.0-10：缴费对象（默认不预选；单选／多选／全选；全选作用域＝当前搜索结果） -->
                    <TextBlock Text="缴费对象" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,14,0,0" />
                    <!-- CHG-v1.1.0-18：自定义缴费对象 → 隐藏候选勾选区，改为手工填写表格 -->
                    <Grid Margin="0,8,0,6" Visibility="{Binding IsStandardChargeObject, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="BillObjectKindCombo" Grid.Column="0" Height="32" FontSize="12" VerticalContentAlignment="Center"
                                  SelectedIndex="{Binding ObjectKindIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="房产" />
                            <ComboBoxItem Content="车位" />
                            <!-- CHG-v1.1.0-11：业主直缴（办卡费/清理费/维修费等面向业主本人的收费项目） -->
                            <ComboBoxItem Content="业主" />
                        </ComboBox>
                        <Border Grid.Column="1" Height="32" Margin="8,0,6,0" Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Style="{StaticResource IconStroke}"
                                      Stroke="{StaticResource TextMutedBrush}" Width="14" Height="14" Margin="10,0,0,0" />
                                <TextBox x:Name="BillObjectKeywordBox" Grid.Column="1" Style="{StaticResource SearchTextBox}" FontSize="11" Margin="8,0,12,0"
                                         Text="{Binding ObjectKeyword, UpdateSourceTrigger=PropertyChanged}"
                                         hc:InfoElement.Placeholder="{Binding ObjectSearchPlaceholder}" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,4,0" VerticalAlignment="Center">
                            <CheckBox Content="全选" IsChecked="{Binding IsAllObjectsChecked, Mode=TwoWay}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedObjectCountText}" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <Border BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6"
                            Visibility="{Binding IsStandardChargeObject, Converter={StaticResource BoolToVis}}">
                        <DataGrid Style="{StaticResource GridStyle}" ItemsSource="{Binding BillObjects}" IsReadOnly="True"
                                  RowHeight="32" MaxHeight="140" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <!-- CHG-v1.1.2-35 / -36：勾选列用「GridCheckCell + GridCheckBox」专用样式（去单元格 12px 内边距），
                                     否则默认单元格内边距会把 24px 宽的勾选框裁掉一半（全仓其它模块同口径） -->
                                <DataGridTemplateColumn Width="48" MinWidth="48" CellStyle="{StaticResource GridCheckCell}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}" Click="ObjectCheckBox_Click"
                                                      Style="{StaticResource GridCheckBox}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- CHG-v1.1.2-35：列宽按「对话框 1000 − 内边距」重排，表头文字与状态标识不再被裁切 -->
                                <DataGridTextColumn Header="缴费对象" Width="170" Binding="{Binding No}" ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="规格（自动匹配）" Width="130" Binding="{Binding SpecText}" ElementStyle="{StaticResource GridCellText}" />
                                <!-- CHG-v1.1.2-50：单价列 —— 收费项目开启「出账时可改价」时按行改价（留空＝价目表单价）；
                                     未开启时保持只读展示，与价目表口径一致。 -->
                                <DataGridTemplateColumn Header="单价" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PriceText}" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Visibility="{Binding IsPriceEditable, Converter={StaticResource InverseBoolToVis}}" />
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding IsPriceEditable, Converter={StaticResource BoolToVis}}">
                                                    <TextBox Width="58" Height="24" FontSize="11" VerticalContentAlignment="Center" Padding="4,0"
                                                             Text="{Binding UnitPriceOverrideText, Mode=OneWay}"
                                                             TextChanged="PriceOverrideTextBox_TextChanged"
                                                             ToolTip="出账改价：填写本次出账单价（留空＝按价目表单价）；只作用于本次生成的账单" />
                                                    <TextBlock Text="{Binding PriceUnitSuffix}" FontSize="10" VerticalAlignment="Center" Margin="3,0,0,0"
                                                               Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="改价" FontSize="9" VerticalAlignment="Center" Margin="4,0,0,0"
                                                               Foreground="{StaticResource PrimaryBrush}"
                                                               Visibility="{Binding IsPriceOverridden, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- CHG-v1.1.2-34：价目表「手填」变量 → 出账行内输入框（其余来源只读展示计量结果） -->
                                <DataGridTemplateColumn Header="计量" Width="196">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MeasureText}" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Visibility="{Binding HasMeasures, Converter={StaticResource InverseBoolToVis}}" />
                                                <ItemsControl ItemsSource="{Binding Measures}"
                                                              Visibility="{Binding HasMeasures, Converter={StaticResource BoolToVis}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Label}" FontSize="10" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                                <TextBox Width="52" Height="24" FontSize="11" Margin="4,0,0,0"
                                                                         VerticalContentAlignment="Center"
                                                                         Text="{Binding ValueText, Mode=OneWay}"
                                                                         TextChanged="MeasureTextBox_TextChanged"
                                                                         ToolTip="{Binding Hint}" />
                                                                <TextBlock Text="{Binding UnitText}" FontSize="10" VerticalAlignment="Center"
                                                                           Margin="3,0,0,0" Foreground="{StaticResource TextMutedBrush}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="预估金额" Width="100" Binding="{Binding AmountText}" ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTemplateColumn Header="状态" Width="88">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding PreviewBg}" CornerRadius="10" Padding="6,2" HorizontalAlignment="Left"
                                                    ToolTip="{Binding PreviewReason}">
                                                <TextBlock Text="{Binding PreviewState}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding PreviewBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="缴费人" Width="80" Binding="{Binding OwnerText}" ElementStyle="{StaticResource GridCellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <!-- CHG-v1.1.2-26：出账预演（规格命中 + 预估金额），与生成账单同口径 -->
                    <StackPanel Visibility="{Binding IsStandardChargeObject, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding PreviewSummaryText}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PreviewFailText}" FontSize="10" Foreground="#B76E00" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsCustomChargeObject, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
                            <Button Style="{StaticResource LinkButton}" Content="新增一行" FontSize="12"
                                    Command="{Binding AddCustomPayerCommand}" />
                            <TextBlock Text="无档案对象：手工填写名称 + 手选规格 + 手填计量参数（金额仍由价目表公式计算）"
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="填写顺序：① 缴费对象名称（必填）→ ② 规格（手选，仅一条时自动选中）→ ③ 计量参数（按所选规格的公式显示，手填；“按周期自动折算”的项无需填写）→ ④ 生成草稿。"
                                   FontSize="9" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <!-- CHG-v1.1.2-37：取价目表失败 / 无启用规格时给出可见原因 + 重试入口 -->
                        <Border Background="#FDECEC" CornerRadius="6" Padding="8,6" Margin="0,0,0,6"
                                Visibility="{Binding HasPriceListError, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding PriceListErrorText}" FontSize="10" TextWrapping="Wrap" MaxWidth="720"
                                           Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource LinkButton}" Content="重新加载价目表" FontSize="10"
                                        Foreground="{StaticResource PrimaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding ReloadPriceListCommand}" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6">
                            <ItemsControl x:Name="CustomPayerList" ItemsSource="{Binding CustomPayers}" MinHeight="96" MaxHeight="220">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,6">
                                            <!-- CHG-v1.1.2-36：缴费对象 3 个输入项补显式引导文字（HandyControl 占位符在默认 TextBox 上不渲染） -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="缴费对象名称（必填）" FontSize="10" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0" />
                                                <TextBox Grid.Column="1" Height="30" FontSize="12" VerticalContentAlignment="Center"
                                                         Padding="6,0"
                                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.HelpText="自定义缴费对象名称"
                                                         hc:InfoElement.Placeholder="缴费对象名称（必填）" />
                                                <TextBlock Grid.Column="2" Text="合同 / 备注编号（选填）" FontSize="10" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,6,0" />
                                                <TextBox Grid.Column="3" Height="30" FontSize="12" VerticalContentAlignment="Center"
                                                         Padding="6,0"
                                                         Text="{Binding ContractNo, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.HelpText="合同 / 备注编号（选填）"
                                                         hc:InfoElement.Placeholder="合同 / 备注编号（选填）" />
                                                <Button Grid.Column="4" Style="{StaticResource LinkButton}" Content="删除"
                                                        Foreground="{StaticResource DangerBrush}" FontSize="12"
                                                        VerticalAlignment="Center" Margin="10,0,4,0"
                                                        Command="{Binding DataContext.RemoveCustomPayerCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                            <!-- CHG-v1.1.2-46：规格 / 计量参数 两块排版对齐修正 ——
                                                 ① 共用同一「标签列」（Auto＝两标签最大宽度），两个标签左边缘、
                                                    两个控件的左边缘因此严格对齐（原先各自 Margin 起排，视觉上错位）；
                                                 ② 拆成两行等距（规格一行、计量参数一行），互不挤压，也避免计量项多时换行
                                                    把「字与输入框」挤成上下两块；
                                                 ③ 控件高度统一 28（原 规格 28 / 计量框 26 不一致）；
                                                 ④ 计算过程 / 金额移到规格行右侧居中，不再用两行堆叠顶开行高。 -->
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="规格（手选）" FontSize="10"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ComboBox Width="200" Height="28" FontSize="11" VerticalContentAlignment="Center"
                                                              ItemsSource="{Binding SpecOptions}" DisplayMemberPath="SpecName"
                                                              SelectedItem="{Binding SelectedSpec}"
                                                              ToolTip="无档案对象：规格由用户手选（仅一条规格时自动选中；公式未用到的计量项不显示）" />
                                                    <TextBlock Text="该收费标准没有启用中的规格，请先在「价目表」补充"
                                                               FontSize="9" VerticalAlignment="Center" Margin="8,0,0,0"
                                                               Foreground="{StaticResource DangerBrush}"
                                                               Visibility="{Binding HasSpecWarning, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProcessText}" FontSize="10" MaxWidth="320"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding AmountText}" FontSize="12" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" Margin="10,0,0,0"
                                                               Foreground="{StaticResource PrimaryBrush}" />
                                                </StackPanel>

                                                <!-- CHG-v1.1.2-50：自定义缴费对象的出账改价（仅收费项目开启时显示输入框） -->
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="单价（出账改价）" FontSize="10"
                                                           VerticalAlignment="Center" Margin="0,8,8,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="0,8,0,0">
                                                    <TextBox Width="90" Height="28" FontSize="11" VerticalContentAlignment="Center" Padding="4,0"
                                                             Text="{Binding UnitPriceOverrideText, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="出账改价：填写本次出账单价（留空＝按所选规格的价目表单价）"
                                                             Visibility="{Binding IsPriceEditable, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="按所选规格的价目表单价（本收费项目未开启「出账时可改价」）"
                                                               FontSize="10" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               Visibility="{Binding IsPriceEditable, Converter={StaticResource InverseBoolToVis}}" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="计量参数" FontSize="10"
                                                           VerticalAlignment="Top" Margin="0,15,8,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                <ItemsControl Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                                              ItemsSource="{Binding Measures}" Margin="0,8,0,0"
                                                              VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <!-- 计量项按「上下布局」逐行排列，每行＝文字 + 输入框 + 单位；
                                                                 需要换行的项不会再横向挤在一起，也就不会与左侧「规格」错位。 -->
                                                            <StackPanel Orientation="Vertical" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Label}" FontSize="10" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                                <TextBox Width="64" Height="28" FontSize="11" Margin="4,0,0,0"
                                                                         VerticalContentAlignment="Center" Padding="4,0"
                                                                         IsReadOnly="{Binding IsReadOnly}"
                                                                         Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                                                                         ToolTip="{Binding Hint}" />
                                                                <TextBlock Text="{Binding UnitText}" FontSize="10" VerticalAlignment="Center"
                                                                           Margin="3,0,0,0" Foreground="{StaticResource TextMutedBrush}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <TextBlock Text="{Binding PreviewSummaryText}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PreviewFailText}" FontSize="10" Foreground="#B76E00" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource HintLine}" Text="{Binding HiddenOwnerText}" />
                    <TextBlock Style="{StaticResource HintLine}" Text="{Binding ObjectListHint}" />
                    <!-- CHG-v1.1.2-50：出账改价口径（开关来自「收费项目维护 → 出账时可改价」） -->
                    <TextBlock Style="{StaticResource HintLine}" Text="{Binding PriceOverrideHintText}" />
                    <TextBlock Style="{StaticResource HintLine}"
                               Visibility="{Binding IsStandardChargeObject, Converter={StaticResource BoolToVis}}"
                               Text="提示：房产收物业费、车位收停车费、业主收办卡/清理/维修等直缴费用；全选只作用于当前搜索结果，未勾选任何缴费对象时无法生成。" />
                    <TextBlock Style="{StaticResource HintLine}"
                               Visibility="{Binding HasStandardMeasures, Converter={StaticResource BoolToVis}}"
                               Text="提示：本收费标准的计算规则含「手填」计量变量（如车位数 / 度数 / 桶数），请先按缴费对象逐行填写「计量」再点生成草稿；未填写的行会进入失败明细。" />
                    <!-- CHG-v1.1.0-16：校验失败（如缴费对象与收费项目不一致）在弹窗内可见，避免提示被浮层遮住 -->
                    <TextBlock Text="{Binding ErrorText}" FontSize="11" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonPrimary}" Content="生成草稿" Margin="0,14,0,0"
                                Command="{Binding GenerateCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="取消" FontSize="13"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,14,0,0"
                                Command="{Binding CloseGenerateCommand}" />
                    </Grid>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============ 发布确认弹窗（T4F-2-1） ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="7" Visibility="{Binding IsPublishConfirmVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="确认发布" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding PublishConfirmText}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,14,0,22" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonPrimary}" Content="确认发布" Command="{Binding ConfirmPublishCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="取消" FontSize="13"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Command="{Binding CancelPublishCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 删除批次确认（CHG-M4-16） ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="7" Visibility="{Binding IsDeleteConfirmVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="{Binding DeleteConfirmTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding DeleteConfirmText}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,14,0,22" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonPrimary}" Content="确认删除"
                                Command="{Binding ConfirmDeleteCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource ButtonSecondary}" Content="取消"
                                Command="{Binding CancelDeleteCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <!-- ============ 批次查看弹窗（T4F-2-1） ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="7" Visibility="{Binding IsViewVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="批次详情" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="批次号" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ViewBatchRow.BatchNoText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="收费项目" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ViewBatchRow.ChargeItemName}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="账单期间" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ViewBatchRow.CyclePeriod}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="户数" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ViewBatchRow.HouseCountText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="总金额" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ViewBatchRow.TotalAmountText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="状态" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ViewBatchRow.StatusText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="发布时间" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ViewBatchRow.PublishTimeText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                        <!-- CHG-v1.1.0-10：本次生成范围摘要（对账口径） -->
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="生成范围" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ViewBatchRow.ScopeSummaryText}" FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    </Grid>
                    <Button Style="{StaticResource LinkButton}" Content="关闭" FontSize="13" HorizontalAlignment="Right"
                            Margin="0,18,0,0" Command="{Binding CloseViewCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 失败清单浮层 ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="7" Visibility="{Binding IsFailurePanelVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="620" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding FailureTitle}" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <Border Grid.Row="2" Background="#FDF6F6" BorderBrush="#F2D0D0" BorderThickness="1" CornerRadius="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Failures}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,0,1" Padding="14,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding No}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Reason}" FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{StaticResource DangerBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="关闭" FontSize="13"
                                Command="{Binding CloseFailuresCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

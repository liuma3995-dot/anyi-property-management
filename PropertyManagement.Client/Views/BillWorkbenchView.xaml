<UserControl x:Class="PropertyManagement.Client.Views.BillWorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             FontFamily="微软雅黑">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="#FAFBFD" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowHeight" Value="44" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F4F7FB" />
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Height" Value="36" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridRow">
                                    <Border x:Name="RowBg" Background="{TemplateBinding Background}">
                                        <DataGridCellsPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowBg" Property="Background" Value="#F2F7FE" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="RowBg" Property="Background" Value="#E7EBF0" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}" VerticalAlignment="Center">
                                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EAF3FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="118" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 统计卡（4，T4F-2-1 副文案对齐原型） ============ -->
        <UniformGrid Grid.Row="0" Columns="4">
            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="草稿账单" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding DraftText}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="待发布核对" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="7,0">
                <StackPanel>
                    <TextBlock Text="已发布" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding PublishedText}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding PublishedSubText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="7,0">
                <StackPanel>
                    <TextBlock Text="部分缴纳" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding PartialText}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"
                               Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="{Binding PartialSubText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="7,0,0,0">
                <StackPanel>
                    <TextBlock Text="发布失败" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding FailedText}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"
                               Foreground="{StaticResource DangerBrush}" />
                    <TextBlock Text="可一键重推（FL-FIN-01）" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ============ 工具栏（T4F-2-1：期间/状态筛选） ============ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="34" Background="#F8FAFD" BorderBrush="{StaticResource BorderBrushColor}"
                        BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Style="{StaticResource IconStroke}"
                              Stroke="{StaticResource TextMutedBrush}" Width="14" Height="14" Margin="10,0,0,0"
                              VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Style="{StaticResource SearchTextBox}"
                                 Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                                 hc:InfoElement.Placeholder="搜索批次号 / 项目"
                                 Margin="8,0,0,0" />
                    </Grid>
                </Border>
                <TextBlock Grid.Column="1" Text="账单期间" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="14,0,8,0" />
                <ComboBox Grid.Column="2" Height="32" FontSize="12" VerticalContentAlignment="Center"
                          ItemsSource="{Binding PeriodFilterOptions}" SelectedItem="{Binding PeriodFilter}" />
                <TextBlock Grid.Column="3" Text="状态" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="14,0,8,0" />
                <ComboBox Grid.Column="4" Height="32" FontSize="12" VerticalContentAlignment="Center"
                          SelectedIndex="{Binding StatusFilter}">
                    <ComboBoxItem Content="全部" />
                    <ComboBoxItem Content="草稿" />
                    <ComboBoxItem Content="已发布" />
                    <ComboBoxItem Content="部分缴纳" />
                    <ComboBoxItem Content="发布失败" />
                </ComboBox>
                <Button Grid.Column="6" Style="{StaticResource ButtonPrimary}" Content="生成账单"
                        Command="{Binding OpenGenerateCommand}" Margin="0,0,10,0" />
                <Button Grid.Column="7" Height="32" FontSize="13" Background="{StaticResource SurfaceBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrushColor}"
                        BorderThickness="1" Content="批量删除" Command="{Binding BatchDeleteCommand}" Margin="0,0,10,0" />
                <Button Grid.Column="8" Style="{StaticResource LinkButton}" Content="失败清单"
                        FontSize="13" VerticalAlignment="Center" Command="{Binding ShowAllFailuresCommand}" />
            </Grid>
        </Border>

        <!-- ============ 批次表格（T4F-2-1：操作按状态派生） ============ -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid Style="{StaticResource GridStyle}" ItemsSource="{Binding Batches}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding DataContext.IsSelectAll, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Mode=TwoWay}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="全选" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="RowCheckBox_Click" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="批次号" Width="110" Binding="{Binding BatchNoText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="收费项目" Width="*" Binding="{Binding ChargeItemName}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="账单期间" Width="110" Binding="{Binding CyclePeriod}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="户数" Width="70" Binding="{Binding HouseCountText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="总金额" Width="120" Binding="{Binding TotalAmountText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTemplateColumn Header="状态" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBg}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding StatusBrush}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="发布时间" Width="130" Binding="{Binding PublishTimeText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTemplateColumn Header="操作" Width="300">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- 草稿：发布 + 编辑 -->
                                    <Button Content="发布"
                                            Command="{Binding DataContext.PublishCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanPublish}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="编辑"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanEdit}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <!-- 已发布/部分缴纳：查看 -->
                                    <Button Content="查看"
                                            Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanView}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <!-- 部分缴纳：催缴 -->
                                    <Button Content="催缴"
                                            Command="{Binding DataContext.RemindCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanRemind}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <!-- 失败：重推 + 失败明细 -->
                                    <Button Content="重推"
                                            Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanRetry}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="失败明细"
                                            Command="{Binding DataContext.ShowFailuresCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanShowFailures}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <!-- CHG-M4-16：任意状态批次删除（软删批次及其账单，保留轨迹） -->
                                    <Button Content="删除"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanDelete}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ============ 状态/错误条 ============ -->
        <TextBlock Grid.Row="6" Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource SuccessBrush}" />
        <TextBlock Grid.Row="6" Text="{Binding ErrorText}" FontSize="11" Foreground="{StaticResource DangerBrush}" />

        <!-- ============ 生成账单浮层 ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="7" Visibility="{Binding IsGenerateVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="580" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="生成账单（草稿）" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="选择收费项目与计费周期，生成草稿账单；重复对象进入失败清单（BR-FIN-01）"
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,16" />

                    <TextBlock Text="收费项目" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <ComboBox Height="34" Margin="0,8,0,14" FontSize="12" VerticalContentAlignment="Center"
                              ItemsSource="{Binding ChargeItems}" SelectedItem="{Binding SelectedItem}"
                              DisplayMemberPath="Name" />

                    <TextBlock Text="计费周期" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <ComboBox Height="34" Margin="0,8,0,20" FontSize="12" VerticalContentAlignment="Center"
                              ItemsSource="{Binding Cycles}" SelectedItem="{Binding SelectedCycle}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding StartDate, StringFormat={}{0:yyyy-MM-dd}}" />
                                    <Run Text=" ~ " />
                                    <Run Text="{Binding EndDate, StringFormat={}{0:yyyy-MM-dd}}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- CHG-M4-16：生成账单计费周期自定义（不再固定内置月份） -->
                    <TextBlock Text="自定义周期（可选，按起止日期新增）" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="开始日期" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <DatePicker Grid.Column="1" Height="34" FontSize="12"
                                    SelectedDate="{Binding NewCycleStart}" />
                        <TextBlock Grid.Column="2" Text="" />
                        <TextBlock Grid.Column="3" Text="结束日期" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        <DatePicker Grid.Column="4" Height="34" FontSize="12"
                                    SelectedDate="{Binding NewCycleEnd}" />
                        <Button Grid.Column="5" Style="{StaticResource LinkButton}" Content="添加周期"
                                FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" Command="{Binding AddCycleCommand}" />
                    </Grid>
                    <TextBlock Text="添加后自动选中；也可直接填好日期点“生成草稿”（自动建周期再生成）"
                               FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,2" TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonPrimary}" Content="生成草稿" Command="{Binding GenerateCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="取消" FontSize="13"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Command="{Binding CloseGenerateCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 发布确认弹窗（T4F-2-1） ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="7" Visibility="{Binding IsPublishConfirmVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="确认发布" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding PublishConfirmText}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,14,0,22" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonPrimary}" Content="确认发布" Command="{Binding ConfirmPublishCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="取消" FontSize="13"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Command="{Binding CancelPublishCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 删除批次确认（CHG-M4-16） ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="7" Visibility="{Binding IsDeleteConfirmVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="确认删除批次" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding DeleteConfirmText}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,14,0,22" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonPrimary}" Content="确认删除"
                                Command="{Binding ConfirmDeleteCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource ButtonSecondary}" Content="取消"
                                Command="{Binding CancelDeleteCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <!-- ============ 批次查看弹窗（T4F-2-1） ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="7" Visibility="{Binding IsViewVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="批次详情" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="批次号" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ViewBatchRow.BatchNoText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="收费项目" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ViewBatchRow.ChargeItemName}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="账单期间" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ViewBatchRow.CyclePeriod}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="户数" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ViewBatchRow.HouseCountText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="总金额" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ViewBatchRow.TotalAmountText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="状态" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ViewBatchRow.StatusText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="发布时间" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ViewBatchRow.PublishTimeText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Grid>
                    <Button Style="{StaticResource LinkButton}" Content="关闭" FontSize="13" HorizontalAlignment="Right"
                            Margin="0,18,0,0" Command="{Binding CloseViewCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 失败清单浮层 ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="7" Visibility="{Binding IsFailurePanelVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="620" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding FailureTitle}" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <Border Grid.Row="2" Background="#FDF6F6" BorderBrush="#F2D0D0" BorderThickness="1" CornerRadius="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Failures}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,0,1" Padding="14,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding No}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Reason}" FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{StaticResource DangerBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="关闭" FontSize="13"
                                Command="{Binding CloseFailuresCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

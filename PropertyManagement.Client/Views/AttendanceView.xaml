<UserControl x:Class="PropertyManagement.Client.Views.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             FontFamily="微软雅黑">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 统计行：本月出勤率 / 迟到 / 旷工 / 请假（GetAttendanceSummaryAsync） -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="本月出勤率" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="{Binding RateText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold" Margin="0,8,0,4" />
                    <Border Background="{StaticResource SuccessSoftBrush}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left" Visibility="{Binding HasRateDelta, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding RateDeltaText}" Foreground="{StaticResource SuccessBrush}" FontSize="11" />
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="迟到" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="{Binding LateText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold" Margin="0,8,0,4" />
                    <TextBlock Text="含各时段班次" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="旷工" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="{Binding AbsentText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold" Margin="0,8,0,4" />
                    <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left">
                        <TextBlock Text="未到岗" Foreground="{StaticResource WarningBrush}" FontSize="11" />
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource CardBorder}" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="请假" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="{Binding LeaveText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold" Margin="0,8,0,4" />
                    <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left">
                        <TextBlock Text="已确认请假" Foreground="{StaticResource DangerBrush}" FontSize="11" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 工具栏：月份（年+月）/ 部门 / 异常类型 / 搜索（回车触发）/ 导出月报 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="月份：" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                <hc:DatePicker Height="32" Width="150" FontSize="11" hc:InfoElement.Placeholder="选择月份（点击日历）"
                              SelectedDate="{Binding SelectedMonth, Mode=TwoWay}" />
                <ComboBox Height="32" Width="120" Margin="12,0,0,0" ItemsSource="{Binding DeptFilterItems}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding DeptFilter, Mode=TwoWay}" />
                <ComboBox Height="32" Width="132" Margin="8,0,0,0" ItemsSource="{Binding StatusFilterItems}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedIndex="{Binding AbnormalFilter, Mode=TwoWay}" />
                <Border Height="32" Width="200" Margin="8,0,0,0" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </Grid.InputBindings>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Style="{StaticResource IconStroke}" Stroke="{StaticResource TextMutedBrush}" Width="14" Height="14" Margin="10,0,0,0" />
                        <TextBox Grid.Column="1" Style="{StaticResource SearchTextBox}" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" hc:InfoElement.Placeholder="搜索工号 / 姓名" FontSize="11" Margin="8,0,12,0" />
                    </Grid>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource ButtonPrimary}" Height="32" FontSize="13" Content="批量审核" Command="{Binding BatchReviewCommand}" Margin="0,0,8,0" />
                <Button Height="32" FontSize="13" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Content="导出月报" Command="{Binding ExportCommand}" />
            </StackPanel>
        </Grid>

        <!-- 数据表 -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid Style="{StaticResource GridStyle}" ItemsSource="{Binding Items}" IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="日期" Width="70" Binding="{Binding DateText}" ElementStyle="{StaticResource GridCellText}" IsReadOnly="True" />
                    <DataGridTextColumn Header="工号" Width="70" Binding="{Binding EmpNo}" ElementStyle="{StaticResource GridCellText}" IsReadOnly="True" />
                    <DataGridTextColumn Header="姓名" Width="90" Binding="{Binding EmpName}" ElementStyle="{StaticResource GridCellText}" IsReadOnly="True" />
                    <DataGridTextColumn Header="班次" Width="70" Binding="{Binding ShiftName}" ElementStyle="{StaticResource GridCellText}" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="状态" Width="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding ResultBg}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-7,0,0,0">
                                    <TextBlock Text="{Binding ResultText}" Foreground="{Binding ResultFg}" FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="审核状态" Width="84" Binding="{Binding ReviewStatusText}" ElementStyle="{StaticResource GridCellText}" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="操作" Width="*" MinWidth="116">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource LinkButton}" Content="审核" Visibility="{Binding IsReviewable, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.ReviewCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Margin="-6,0,0,0" />
                                    <TextBlock Text="—" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Visibility="{Binding IsNotReviewable, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 分页 + 状态 -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding TotalText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SuccessBrush}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Height="24" FontSize="12" Background="Transparent" BorderThickness="0" Style="{StaticResource LinkButton}" Content="上一页" Command="{Binding PrevPageCommand}" />
                <Button Height="24" FontSize="12" Background="Transparent" BorderThickness="0" Style="{StaticResource LinkButton}" Content="下一页" Command="{Binding NextPageCommand}" Margin="6,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- 交互标注 -->
        <Border Grid.Row="8" Background="#F7F5FE" CornerRadius="6" Padding="12,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Eye}" Style="{StaticResource IconStroke}" Stroke="#5B3DF5" Width="12" Height="12" />
                    <TextBlock Text="交互标注" Foreground="#5B3DF5" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Text="· 考勤记录由排班表数据同步生成；操作栏【审核】→ 选择状态标识（正常/迟到/旷工/请假）→ 已确认" Foreground="#4A3AB0" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="· 工具栏「批量审核」→ 对当前页面全部待审记录批量通过并闭环为正常" Foreground="#4A3AB0" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                <TextBlock Text="· 考勤由系统管理员统一操作，员工无该系统使用权限" Foreground="#4A3AB0" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- 审核：选择员工状态标识（正常/迟到/旷工/请假） → 已确认 -->
        <Border Grid.RowSpan="9" Background="#66000000" Visibility="{Binding IsStatusPickerVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="审核考勤" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"><Run Text="员工：" /><Run Text="{Binding StatusPickerRow.EmpName, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="{Binding StatusPickerRow.EmpNo, StringFormat=（{0}）}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="4,0,0,0" />
                        <TextBlock Text="{Binding StatusPickerRow.DateText, StringFormat=日期：{0}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="16,0,0,0" />
                        <TextBlock Text="{Binding StatusPickerRow.ShiftName, StringFormat=班次：{0}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="选择员工状态标识：" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,6" />
                    <ItemsControl ItemsSource="{Binding StatusOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Height="40" Margin="6,4" Cursor="Hand"
                                        Background="{Binding BgBrush}" Foreground="{Binding FgBrush}"
                                        FontSize="14" FontWeight="SemiBold" Content="{Binding Label}"
                                        Command="{Binding DataContext.SetStatusCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelStatusCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- 批量审核（勾选待审记录后一键通过闭环） -->
        <Border Grid.RowSpan="9" Background="#66000000" Visibility="{Binding IsBatchReviewVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="批量审核" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBlock Text="对当前页面的全部待审核记录一键通过并闭环为正常，请确认。" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                        <TextBlock Text="{Binding BatchReviewCountText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding BatchReviewCancelCommand}" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="确认批量审核" Command="{Binding BatchReviewConfirmCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>

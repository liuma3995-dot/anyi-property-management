<Window x:Class="PropertyManagement.Client.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="修改密码" Width="440" Height="400"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="White" FontFamily="微软雅黑">
    <StackPanel Margin="28,24">
        <TextBlock Text="修改密码" FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" />
        <TextBlock Text="修改成功后需重新登录（UC-COM-002）" FontSize="12"
                   Foreground="{StaticResource TextHintBrush}" Margin="0,4,0,20" />

        <hc:PasswordBox x:Name="OldPasswordInput" hc:InfoElement.Placeholder="原密码"
                        Margin="0,8" />
        <hc:PasswordBox x:Name="NewPasswordInput" hc:InfoElement.Placeholder="新密码（至少 6 位）"
                        Margin="0,8" />
        <hc:PasswordBox x:Name="ConfirmPasswordInput" hc:InfoElement.Placeholder="确认新密码"
                        Margin="0,8" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" MinHeight="18" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" Width="88" Margin="0,0,12,0" Click="OnCancelClick" />
            <Button Content="保存" Width="88" Command="{Binding SaveCommand}"
                    Style="{StaticResource ButtonPrimary}" />
        </StackPanel>
    </StackPanel>
</Window>


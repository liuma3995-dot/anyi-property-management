<UserControl x:Class="PropertyManagement.Client.Views.DictParamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:vm="clr-namespace:PropertyManagement.Client.ViewModels"
             xmlns:conv="clr-namespace:PropertyManagement.Client.Converters"
             FontFamily="微软雅黑">
    <UserControl.Resources>
        <vm:IconKeyConverter x:Key="IconConv" />
        <!-- R14：把视图 DataContext 传给不在可视化树内的 DataGridColumn（控制勾选框列显隐） -->
        <conv:BindingProxy x:Key="VmProxy" Data="{Binding}" />
        <!-- 停用项灰显（单元格文本随行状态着色） -->
        <Style x:Key="DictCellText" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16,12,16,12">
        <Grid.ColumnDefinitions>
            <!-- CHG-v1.1.2-55：左栏分类列表固定宽度并收窄 —— 原来左右各占 ~48%（右表仅 660px），
                 计量变量表 10 列被压缩：单位/类型/来源/默认值/状态 表头与内容被裁、引用列塌成 20px。 -->
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左栏：字典分类卡片列表（原型 PG-COM-01：共八类，选中项主色高亮） -->
        <!-- 卡片按内容高度收边（原型 PG-COM-01 左栏）；分类过多时在卡片内滚动 -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="18,16" VerticalAlignment="Top"
                MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type Grid}}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="字典分类" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <ListBox Grid.Row="1" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType, Mode=TwoWay}"
                         Margin="0,14,0,0" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <!-- 无障碍/自动化：列表项暴露分类名（UIA Name），便于读屏与端到端校验 -->
                            <Setter Property="AutomationProperties.Name" Value="{Binding TypeName}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bg" Background="White" BorderBrush="{StaticResource BorderBrushColor}"
                                                BorderThickness="1" CornerRadius="8" Height="46" Padding="14,0" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Ico" Grid.Column="0" Data="{Binding IconKey, Converter={StaticResource IconConv}}"
                                                      Style="{StaticResource IconStroke}" Stroke="{StaticResource TextSecondaryBrush}"
                                                      Width="16" Height="16" VerticalAlignment="Center" />
                                                <TextBlock x:Name="Txt" Grid.Column="1" Text="{Binding TypeName}" FontSize="13"
                                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="12,0,8,0" VerticalAlignment="Center" />
                                                <Path Grid.Column="2" Data="{StaticResource Icon.ChevronRight}" Style="{StaticResource IconStroke}"
                                                      Stroke="{StaticResource TextMutedBrush}" Width="14" Height="14" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                <Setter TargetName="Ico" Property="Stroke" Value="{StaticResource PrimaryBrush}" />
                                                <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- 右栏：选中分类的字典项表格 + 交互标注 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="{Binding SelectedType.TypeName, StringFormat={}{0} · 字典项, TargetNullValue=字典项}"
                           FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" Foreground="{StaticResource SuccessBrush}" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0" />
                <!-- R12：批量删除（仅已停用项可删；按住 Ctrl / Shift 多选） -->
                <!-- R14：点击后进入选择模式（勾选框列才显示），文案切换为「删除所选」 -->
                <Button DockPanel.Dock="Right" Style="{StaticResource ButtonSecondary}" Command="{Binding BatchDeleteCommand}"
                        Padding="14,4" Margin="0,0,10,0" Height="32" ToolTip="点击后显示勾选框列；仅已停用的字典项可删除">
                    <TextBlock Text="{Binding BatchDeleteButtonText}" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource DangerBrush}" />
                </Button>
                <!-- CHG-v1.1.2-26：计量变量分类的批量删除（点击后显示勾选框列；内置变量不可删） -->
                <Button DockPanel.Dock="Right" Style="{StaticResource ButtonSecondary}" Command="{Binding VariableBatchDeleteCommand}"
                        Padding="14,4" Margin="0,0,10,0" Height="32" ToolTip="点击后显示勾选框列；内置变量不可删除，仍被引用的变量不可删除"
                        Visibility="{Binding IsVariableType, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding VariableBatchDeleteText}" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource DangerBrush}" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelSelectionCommand}"
                        Padding="14,4" Margin="0,0,10,0" Height="32" FontSize="13"
                        Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolToVis}}" />
                <Button DockPanel.Dock="Right" Command="{Binding NewCommand}" Padding="14,4" Height="32">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Plus}" Style="{StaticResource IconStroke}" Stroke="White" Width="13" Height="13" VerticalAlignment="Center" />
                        <TextBlock Text="新增字典项" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13" />
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVariableType}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource ButtonPrimary}" Command="{Binding NewVariableCommand}" Padding="14,4" Height="32"
                        Visibility="{Binding IsVariableType, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Plus}" Style="{StaticResource IconStroke}" Stroke="White" Width="13" Height="13" VerticalAlignment="Center" />
                        <TextBlock Text="新增变量" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13" />
                    </StackPanel>
                </Button>
            </DockPanel>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0" VerticalAlignment="Top">
                <Grid>
                <DataGrid x:Name="DictItemsGrid" Style="{StaticResource GridStyle}" ItemsSource="{Binding Items}" IsReadOnly="True" MaxHeight="560"
                          Visibility="{Binding IsNotVariableType, Converter={StaticResource BoolToVis}}">
                    <DataGrid.Columns>
                        <!-- R13：勾选框列（表头可全选，支持单选） -->
                        <DataGridTemplateColumn Width="56" MinWidth="56" CellStyle="{StaticResource GridCheckCell}"
                                                Visibility="{Binding Data.IsSelectionMode, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVis}}">
                            <DataGridTemplateColumn.Header>
                                <CheckBox IsChecked="{Binding DataContext.IsAllItemsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=TwoWay}"
                                          Style="{StaticResource GridCheckBox}" ToolTip="全选 / 取消全选" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- 只读 DataGrid 中 CheckBox 的 IsChecked 绑定不会写回源，由 Click 显式同步到行对象 -->
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}" Style="{StaticResource GridCheckBox}"
                                              Click="DictItemCheck_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="编码" Width="112" Binding="{Binding ItemCode}" ElementStyle="{StaticResource DictCellText}" />
                        <DataGridTextColumn Header="名称" Width="106" Binding="{Binding ItemName}" ElementStyle="{StaticResource DictCellText}" />
                        <DataGridTextColumn Header="显示值" Width="132" Binding="{Binding DisplayValue}" ElementStyle="{StaticResource DictCellText}" />
                        <DataGridTextColumn Header="备注" Width="*" Binding="{Binding Remark}" ElementStyle="{StaticResource DictCellText}" />
                        <DataGridTextColumn Header="修改人" Width="84" Binding="{Binding ModifiedBy}" ElementStyle="{StaticResource DictCellText}" />
                        <DataGridTextColumn Header="修改时间" Width="100" Binding="{Binding ModifiedAtText}" ElementStyle="{StaticResource DictCellText}" />
                        <DataGridTemplateColumn Header="操作" Width="132">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- CHG-v1.1.0-17：系统固定缴费对象（房产/车位/业主）只读标记，不提供停用 -->
                                        <TextBlock Text="系统固定" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                                   Visibility="{Binding IsSystemFixed, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource LinkButton}" Content="编辑" Padding="4,2"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource LinkButton}" Content="停用" Foreground="{StaticResource DangerBrush}" Padding="4,2" Margin="4,0,0,0"
                                                Visibility="{Binding IsDisableVisible, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.DisableCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource LinkButton}" Content="恢复" Foreground="{StaticResource SuccessBrush}" Padding="4,2" Margin="4,0,0,0"
                                                Visibility="{Binding IsDisabledVisible, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <!-- CHG-v1.1.2-26：计量变量（定义侧）—— 单位 / 类型 / 来源 / 默认值 / 适用对象 -->
                <DataGrid x:Name="ChargeVariableGrid" Style="{StaticResource GridStyle}" ItemsSource="{Binding VariableItems}" IsReadOnly="True" MaxHeight="560"
                          Visibility="{Binding IsVariableType, Converter={StaticResource BoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="56" MinWidth="56" CellStyle="{StaticResource GridCheckCell}"
                                                Visibility="{Binding Data.IsSelectionMode, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVis}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}" Style="{StaticResource GridCheckBox}"
                                              Click="ChargeVariableCheck_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- CHG-v1.1.2-55：列宽按「右表可用宽 ≈ 980 − 纵向滚动条」重排：
                             固定列合计 872 → 引用列（*）仍有 ~95px，彻底消除表头/标签被裁与引用列塌陷。 -->
                        <DataGridTextColumn Header="编码" Width="72" Binding="{Binding VarCode}" ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTextColumn Header="变量名" Width="96" Binding="{Binding VarName}" ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTextColumn Header="单位" Width="66" Binding="{Binding UnitText}" ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTextColumn Header="类型" Width="66" Binding="{Binding TypeText}" ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTextColumn Header="来源" Width="88" Binding="{Binding SourceText}" ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTextColumn Header="默认值" Width="78" Binding="{Binding DefaultText}" ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTextColumn Header="适用对象" Width="82" Binding="{Binding ScopeText}" ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTextColumn Header="引用" Width="*" MinWidth="90" Binding="{Binding UsedText}" ElementStyle="{StaticResource GridCellText}" />
                        <DataGridTemplateColumn Header="状态" Width="76">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusBg}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="操作" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding BuiltinText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <Button Style="{StaticResource LinkButton}" Padding="4,2"
                                                Command="{Binding DataContext.EditVariableCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="编辑" FontSize="12" Foreground="{StaticResource PrimaryBrush}" />
                                        </Button>
                                        <Button Style="{StaticResource LinkButton}" Padding="4,2" Margin="4,0,0,0"
                                                Command="{Binding DataContext.ToggleVariableCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding ToggleText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </Button>
                                        <Button Style="{StaticResource LinkButton}" Padding="4,2" Margin="4,0,0,0"
                                                Command="{Binding DataContext.DeleteVariableCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="删除" FontSize="12" Foreground="{StaticResource DangerBrush}" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </Grid>
            </Border>

            <!-- 交互标注（原型 PG-COM-01） -->
            <Border Grid.Row="4" Background="#F7F5FE" CornerRadius="6" Padding="12,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Eye}" Style="{StaticResource IconStroke}" Stroke="#5B3DF5" Width="12" Height="12" />
                        <TextBlock Text="交互标注" Foreground="#5B3DF5" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="· 编辑字典项 → 确认弹窗“修改将影响相关业务展示，确认保存？”→ 写审计日志" Foreground="#4A3AB0" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="· 停用需二次确认（可随时恢复）；批量删除仅支持已停用字典项，未停用时弹窗提示无法删除（软删）" Foreground="#4A3AB0" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 新增/编辑弹层 -->
        <Border Grid.ColumnSpan="3" Background="#66000000" Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />
                    <TextBlock Text="编码" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding FormItemCode, Mode=OneWay}" IsEnabled="False" Height="32" Margin="0,6,0,0"
                             hc:InfoElement.Placeholder="保存后由系统自动生成（如 JFFS-01）" />
                    <TextBlock Text="名称" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" />
                    <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,6,0,0" hc:InfoElement.Placeholder="字典项名称（必填）" />
                    <TextBlock Text="显示值" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" />
                    <TextBox Text="{Binding FormDisplayValue, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,6,0,0" hc:InfoElement.Placeholder="业务展示用，默认与名称一致" />
                    <TextBlock Text="备注" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" />
                    <TextBox Text="{Binding FormRemark, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,6,0,0" hc:InfoElement.Placeholder="附加信息（选填）" />
                    <TextBlock Text="排序" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" />
                    <TextBox Text="{Binding FormSort, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,6,0,0" hc:InfoElement.Placeholder="数字，越小越靠前" />
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelCommand}" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="保存" Command="{Binding SaveCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- 编辑保存 / 停用 二次确认弹层 -->
        <!-- CHG-v1.1.2-26：计量变量新增 / 编辑（名称 / 单位 / 类型 / 来源 / 默认值 / 适用对象） -->
        <Border Grid.ColumnSpan="3" Background="#66000000" Visibility="{Binding IsVariableFormVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="{Binding VariableFormTitle}" FontSize="16" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock Text="计量变量是价目表公式的计量维度：单价单位与出账输入项均由变量自动生成" FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14" TextWrapping="Wrap" />

                    <TextBlock Text="变量名称" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding FormVariableName, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,6,0,0"
                             hc:InfoElement.Placeholder="如：桶数 / 台数 / 人次（仅中文或字母，不可含数字与符号）" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="单位" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding FormVariableUnit, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,6,0,0"
                                     hc:InfoElement.Placeholder="桶 / 台 / 人次 / 度" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="值类型" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <ComboBox Height="32" Margin="0,6,0,0" SelectedIndex="{Binding FormVariableTypeIndex}">
                                <ComboBoxItem Content="整数" />
                                <ComboBoxItem Content="小数" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="取值来源" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" />
                    <ComboBox Height="32" Margin="0,6,0,0" SelectedIndex="{Binding FormVariableSourceIndex}">
                        <ComboBoxItem Content="手填（出账时输入）" />
                        <ComboBoxItem Content="固定值（不显示输入项）" />
                    </ComboBox>
                    <TextBlock Text="{Binding FormVariableSourceHint}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="「档案自动 / 周期派生」为系统内置专用（与档案字段强绑定），自建变量不开放" FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="默认值（选填）" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding FormVariableDefault, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,6,0,0"
                                     hc:InfoElement.Placeholder="如 1（按次计价）" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="适用对象" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <ComboBox Height="32" Margin="0,6,0,0" SelectedIndex="{Binding FormVariableScopeIndex}">
                                <ComboBoxItem Content="房产" />
                                <ComboBoxItem Content="车位" />
                                <ComboBoxItem Content="业主" />
                                <ComboBoxItem Content="自定义缴费对象" />
                                <ComboBoxItem Content="不限" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="备注" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" />
                    <TextBox Text="{Binding FormVariableRemark, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,6,0,0"
                             hc:InfoElement.Placeholder="典型场景说明（选填）" />

                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelVariableCommand}" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="保存" Command="{Binding SaveVariableCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.ColumnSpan="3" Background="#66000000" Visibility="{Binding IsConfirmVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="{Binding ConfirmTitle}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding ConfirmMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelConfirmCommand}" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="确认" Command="{Binding ConfirmCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- 提示弹层（单按钮）：批量删除被拒绝等 -->
        <Border Grid.ColumnSpan="3" Background="#66000000" Visibility="{Binding IsNoticeVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="{Binding NoticeTitle}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding NoticeMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource ButtonPrimary}" Content="知道了" Command="{Binding CloseNoticeCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>

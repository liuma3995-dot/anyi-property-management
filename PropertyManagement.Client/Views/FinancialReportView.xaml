<UserControl x:Class="PropertyManagement.Client.Views.FinancialReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             FontFamily="微软雅黑">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 左：报表参数卡片（原型 PG-FIN-07 / quanju.pen eUvNG 1:1） ============ -->
        <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16,18"
                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="报表参数" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <TextBlock Text="报表类型" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,16,0,4" />
                <ComboBox Height="34" FontSize="12" VerticalContentAlignment="Center"
                          SelectedIndex="{Binding PeriodType}">
                    <ComboBoxItem Content="月报" />
                    <ComboBoxItem Content="季报" />
                    <ComboBoxItem Content="年报" />
                </ComboBox>

                <!-- CHG-v1.3.1-06：「回到本期」——口径同仪表盘「回到本月」（当前报表类型 → 当前期，对比期 → 上一期） -->
                <Grid Margin="0,12,0,4">
                    <TextBlock Text="会计期间" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Content="回到本期" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Padding="2,0" FontSize="11"
                            Command="{Binding GoToCurrentPeriodCommand}"
                            ToolTip="按当前报表类型回到当前期，对比期回到上一期" />
                </Grid>
                <Border Height="34" Background="#F7F4EE" BorderBrush="{StaticResource BorderBrushColor}"
                        BorderThickness="1" CornerRadius="6">
                    <TextBox Style="{StaticResource SearchTextBox}" Text="{Binding Period, UpdateSourceTrigger=PropertyChanged}"
                             hc:InfoElement.Placeholder="2026-08 / 2026-Q3 / 2026" VerticalContentAlignment="Center" />
                </Border>

                <TextBlock Text="对比期间" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4" />
                <Border Height="34" Background="#F7F4EE" BorderBrush="{StaticResource BorderBrushColor}"
                        BorderThickness="1" CornerRadius="6">
                    <TextBox Style="{StaticResource SearchTextBox}" Text="{Binding ComparePeriod, UpdateSourceTrigger=PropertyChanged}"
                             hc:InfoElement.Placeholder="2026-07 / 2026-Q2 / 2025" VerticalContentAlignment="Center" />
                </Border>

                <TextBlock Text="收费项目" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4" />
                <ComboBox Height="34" FontSize="12" VerticalContentAlignment="Center"
                          ItemsSource="{Binding ChargeItems}" DisplayMemberPath="Name" SelectedIndex="{Binding ChargeItemFilter}" />

                <TextBlock Text="含退费冲销" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,4" />
                <Border Height="34" Background="#F7F4EE" BorderBrush="{StaticResource BorderBrushColor}"
                        BorderThickness="1" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                        <CheckBox IsChecked="{Binding IncludeRefund}" VerticalAlignment="Center" />
                        <TextBlock Text="计入（冲减收入）" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="8,0,0,0" />
                    </StackPanel>
                </Border>

                <Button Margin="0,20,0,0" Style="{StaticResource ButtonPrimary}" Height="34" Content="生成报表"
                        Command="{Binding GenerateCommand}" />
                <!-- CHG-v1.2.0-38：ButtonSecondary 模板的内边距（16,8）在 Height=34 时只剩 16px 内容高度，
                     14px 中文字被上下裁掉（「导」字首笔被遮挡）→ 本页两个导出按钮改用纵向 0 内边距 -->
                <Button Margin="0,10,0,0" Style="{StaticResource ButtonSecondary}" Height="34" Padding="16,0"
                        FontSize="13" Content="导出 Excel" Command="{Binding ExportExcelCommand}" />
                <Button Margin="0,10,0,0" Style="{StaticResource ButtonSecondary}" Height="34" Padding="16,0"
                        FontSize="13" Content="导出 PDF" Command="{Binding ExportPdfCommand}" />
                <!-- CHG-v1.3.1-05：报表与导出留痕（导出缓存）清单 —— 年度/季度/月度清算用；
                     删除 = 留痕软删 + 服务端生成文件物理删除，与账目无关 -->
                <Button Margin="0,10,0,0" Style="{StaticResource ButtonSecondary}" Height="34" Padding="16,0"
                        FontSize="13" Content="报表与导出留痕" Command="{Binding OpenTracePanelCommand}"
                        ToolTip="清理只增不减的导出缓存（留痕 + 服务端生成文件）" />
            </StackPanel>
        </Border>

        <!-- ============ 右：统计卡 + 项目汇总表 ============ -->
        <Grid Grid.Column="2" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0" Columns="4">
                <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,7,0">
                    <StackPanel>
                        <TextBlock Text="本期收入" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding IncomeText}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"
                                   Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="{Binding IncomeSubText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="7,0">
                    <StackPanel>
                        <TextBlock Text="本期支出" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding ExpenseText}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"
                                   Foreground="{StaticResource DangerBrush}" />
                        <TextBlock Text="{Binding ExpenseSubText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="7,0">
                    <StackPanel>
                        <TextBlock Text="本期结余" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding BalanceText}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding BalanceSubText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="7,0,0,0">
                    <StackPanel>
                        <TextBlock Text="累计应收未收" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding UnpaidText}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"
                                   Foreground="{StaticResource WarningBrush}" />
                        <TextBlock Text="见欠费台账" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding TableTitle}" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="16,0,0,0" VerticalAlignment="Center" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding SummaryRows}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="项目" Width="*" Binding="{Binding Category}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="本期金额" Width="150" Binding="{Binding CurrentAmountText}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="上期金额" Width="150" Binding="{Binding PreviousAmountText}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="环比" Width="100" Binding="{Binding MoMText}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Width="150" Binding="{Binding QuarterTotalText}" Header="{Binding DataContext.PeriodCumulativeLabel, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="备注" Width="140" Binding="{Binding Remark}" ElementStyle="{StaticResource GridCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ 状态/错误条 ============ -->
        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding StatusText}"
                   FontSize="11" Foreground="{StaticResource SuccessBrush}" />
        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding ErrorText}"
                   FontSize="11" Foreground="{StaticResource DangerBrush}" />

        <!-- ============ CHG-v1.3.1-05：报表与导出留痕清单（缓存清理） ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3"
              Visibility="{Binding IsTracePanelVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="1000" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource CardBorder}" Padding="24,20">
                <StackPanel>
                    <TextBlock Text="报表与导出留痕" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="删除 = 留痕软删 + 服务端生成文件物理删除（释放磁盘）；仅清理导出缓存，账单 / 收款 / 退款 / 报表金额均不受影响"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,12"
                               TextWrapping="Wrap" />
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="{Binding TraceSummaryText}" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="勾选后点「批量删除」；表头可全选" FontSize="11" HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Border Height="330" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="8">
                        <DataGrid ItemsSource="{Binding ExportTraces}" IsReadOnly="True" AutoGenerateColumns="False"
                                  HeadersVisibility="Column" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="46">
                                    <DataGridTemplateColumn.Header>
                                        <CheckBox IsChecked="{Binding DataContext.IsTraceSelectAll, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=TwoWay}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      Click="RowCheckBox_Click"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="来源" Width="78" Binding="{Binding SourceText}" ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="类型" Width="104" Binding="{Binding KindText}" ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="期间" Width="86" Binding="{Binding PeriodText}" ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="格式" Width="56" Binding="{Binding FormatText}" ElementStyle="{StaticResource GridCellText}" />
                                <!-- 文件名最长（含时间戳），给足宽度并加悬停提示，避免截断 -->
                                <DataGridTextColumn Header="文件名" Width="*" Binding="{Binding FileNameText}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                            <Setter Property="ToolTip" Value="{Binding FileNameText}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="大小" Width="74" Binding="{Binding SizeText}" ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="生成时间" Width="132" Binding="{Binding CreatedText}" ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="服务端文件" Width="86" Binding="{Binding FileStateText}" ElementStyle="{StaticResource GridCellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <TextBlock Text="{Binding ErrorText}" FontSize="11" Foreground="{StaticResource DangerBrush}"
                               Margin="0,8,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Style="{StaticResource ButtonSecondary}" Content="关闭" Command="{Binding CloseTracePanelCommand}" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="批量删除" Margin="10,0,0,0"
                                Command="{Binding RequestDeleteTracesCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 删除确认（提醒先备份归档） -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3"
              Visibility="{Binding IsTraceConfirmVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource CardBorder}" Padding="24,20">
                <StackPanel>
                    <TextBlock Text="确认清理报表/导出留痕？" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding TraceConfirmText}" FontSize="12" Margin="0,10,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelDeleteTracesCommand}" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="确认清理" Margin="10,0,0,0"
                                Command="{Binding ConfirmDeleteTracesCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

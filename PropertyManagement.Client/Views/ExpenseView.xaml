<UserControl x:Class="PropertyManagement.Client.Views.ExpenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:conv="clr-namespace:PropertyManagement.Client.Converters"
             xmlns:controls="clr-namespace:PropertyManagement.Client.Assets.Controls"
             FontFamily="微软雅黑">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- v1.1.0-⑤：把视图 DataContext 传给不在可视化树内的 DataGridColumn（控制勾选框列显隐） -->
        <conv:BindingProxy x:Key="VmProxy" Data="{Binding}" />
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="118" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 统计卡（4） ============ -->
        <UniformGrid Grid.Row="0" Columns="4">
            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="本月支出合计" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding MonthTotalText}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"
                               Foreground="{StaticResource DangerBrush}" />
                    <TextBlock Text="登记即生效（无审批流）" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="7,0">
                <StackPanel>
                    <TextBlock Text="支出笔数" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding CountText}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="未删除记录" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="7,0">
                <StackPanel>
                    <TextBlock Text="待审批" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding PendingText}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="本期无审批流（登记+权限控制）" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="7,0,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="本月预算" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource LinkButton}" Content="设置预算" FontSize="11"
                                Command="{Binding OpenBudgetCommand}" ToolTip="设置月度支出预算（系统参数 finance.budget.monthly）" />
                    </Grid>
                    <TextBlock Text="{Binding BudgetText}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding BudgetSubText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ============ 工具栏 ============ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="34" Background="#F7F4EE" BorderBrush="{StaticResource BorderBrushColor}"
                        BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Style="{StaticResource IconStroke}"
                              Stroke="{StaticResource TextMutedBrush}" Width="14" Height="14" Margin="10,0,0,0"
                              VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Style="{StaticResource SearchTextBox}"
                                 Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                                 hc:InfoElement.Placeholder="搜索支出编号 / 收款方"
                                 Margin="8,0,0,0" KeyDown="SearchBox_KeyDown" />
                    </Grid>
                </Border>
                <TextBlock Grid.Column="1" Text="类别" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="14,0,8,0" />
                <ComboBox Grid.Column="2" Height="32" FontSize="12" VerticalContentAlignment="Center"
                          ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Name"
                          SelectedIndex="{Binding SelectedFilterIndex}" SelectionChanged="Filter_SelectionChanged" />
                <TextBlock Grid.Column="3" Text="状态" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="14,0,8,0" />
                <ComboBox Grid.Column="4" Height="32" FontSize="12" VerticalContentAlignment="Center"
                          SelectedIndex="{Binding SelectedStatusFilter}" SelectionChanged="Filter_SelectionChanged">
                    <ComboBoxItem Content="全部" />
                    <ComboBoxItem Content="已支付" />
                    <ComboBoxItem Content="已删除" />
                </ComboBox>
                <Button Grid.Column="6" Style="{StaticResource ButtonPrimary}" Content="登记支出"
                        Command="{Binding OpenFormCommand}" Margin="0,0,10,0" />
                <!-- v1.1.0-⑤：批量删除记录（按钮尺寸与间距与「导出」一致：同 LinkButton 样式 / FontSize 13 / 间距 10 / 垂直居中） -->
                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Style="{StaticResource LinkButton}" FontSize="13" VerticalAlignment="Center"
                            Command="{Binding BatchDeleteRecordsCommand}"
                            ToolTip="点击后显示勾选框列（可勾选单条，也可勾选表头全选）">
                        <TextBlock Text="{Binding BatchDeleteButtonText}" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{StaticResource DangerBrush}" />
                    </Button>
                    <Button Style="{StaticResource LinkButton}" Content="取消" FontSize="13" VerticalAlignment="Center"
                            Margin="10,0,0,0" Command="{Binding CancelSelectionCommand}"
                            Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <!-- CHG-v1.2.0-25：导出改为真实实现（PDF，按当前筛选条件导出明细） -->
                <Button Grid.Column="8" Style="{StaticResource LinkButton}" Content="导出" FontSize="13"
                        VerticalAlignment="Center" Command="{Binding ExportCommand}" />
            </Grid>
        </Border>

        <!-- ============ 支出表格 ============ -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid ItemsSource="{Binding Items}" IsReadOnly="True">
                <DataGrid.Columns>
                    <!-- v1.1.0-⑤：勾选框列（表头全选，支持单选；仅点击「批量删除记录」后显示；已删除行不可勾选） -->
                    <DataGridTemplateColumn Width="56" MinWidth="56" CellStyle="{StaticResource GridCheckCell}"
                                            Visibility="{Binding Data.IsSelectionMode, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVis}}">
                        <DataGridTemplateColumn.Header>
                            <CheckBox IsChecked="{Binding DataContext.IsAllRecordsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=TwoWay}"
                                      Style="{StaticResource GridCheckBox}" ToolTip="全选 / 取消全选（不含已删除记录）" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- 只读 DataGrid 中 CheckBox 的 IsChecked 绑定不会写回源，由 Click 显式同步到行对象 -->
                                <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}" Style="{StaticResource GridCheckBox}"
                                          Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                          Click="ExpenseCheckBox_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="支出编号" Width="100" Binding="{Binding NoText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="日期" Width="100" Binding="{Binding DateText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="类别" Width="110" Binding="{Binding CategoryName}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="摘要" Width="*" Binding="{Binding Note}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="金额" Width="120" Binding="{Binding AmountText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="收款方" Width="110" Binding="{Binding PayeeText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTemplateColumn Header="状态" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBg}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding StatusBrush}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="操作" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource LinkButton}" Content="查看"
                                            Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource LinkButton}" Content="删除"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ============ 状态/错误条 ============ -->
        <!-- CHG-v1.1.2-11：状态/错误条改为可换行容器，长提示不再被右侧裁切 -->
        <StackPanel Grid.Row="6">
            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorText}" FontSize="11" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ============ 登记表单浮层 ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="7" Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="登记支出" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <!-- CHG-v1.1.2-10：清除用户可见的 mock 编号 -->
                    <TextBlock Text="支出分类必选、可在表单内新增/删除；登记即支付并联动收支明细流水"
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,18" TextWrapping="Wrap" />

                    <TextBlock Text="支出分类" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <ComboBox Height="34" Margin="0,8,0,14" FontSize="12" VerticalContentAlignment="Center"
                              ItemsSource="{Binding Categories}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedCategory}" />

                    <!-- v1.1.0 第 7 轮：分类维护（新增 / 删除当前分类），保证「分类为空」不再阻断登记 -->
                    <Grid Margin="0,-6,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="30" Background="#F7F4EE" BorderBrush="{StaticResource BorderBrushColor}"
                                BorderThickness="1" CornerRadius="6">
                            <TextBox Style="{StaticResource SearchTextBox}" FontSize="12"
                                     Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"
                                     hc:InfoElement.Placeholder="输入新分类名称，如：绿化养护" />
                        </Border>
                        <Button Grid.Column="1" Style="{StaticResource ButtonSecondary}" Content="新增分类" Height="30" Padding="10,2"
                                FontSize="12" Margin="8,0,0,0" Command="{Binding AddCategoryCommand}"
                                ToolTip="新增支出分类并自动选中" />
                        <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="删除分类" FontSize="12"
                                Foreground="{StaticResource DangerBrush}" Margin="8,0,0,0" VerticalAlignment="Center"
                                Command="{Binding DeleteCategoryCommand}"
                                ToolTip="删除当前选中分类；被支出记录引用时不可删除（可停用）" />
                    </Grid>
                    <TextBlock Text="{Binding CategoryHintText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,-8,0,12" TextWrapping="Wrap" />

                    <TextBlock Text="金额（元）" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <Border Height="34" Margin="0,8,0,14" Background="#F7F4EE" BorderBrush="{StaticResource BorderBrushColor}"
                            BorderThickness="1" CornerRadius="6">
                        <!-- CHG-v1.1.2-08：改用 DecimalTextBox（原 StringFormat 绑定会边输边格式化） -->
                        <controls:DecimalTextBox Style="{StaticResource SearchTextBox}"
                                 Value="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>

                    <TextBlock Text="支出日期" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <DatePicker Height="34" Margin="0,8,0,14" FontSize="12" SelectedDate="{Binding ExpenseDate}" />

                    <TextBlock Text="摘要" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <Border Height="64" Margin="0,8,0,20" Background="#F7F4EE" BorderBrush="{StaticResource BorderBrushColor}"
                            BorderThickness="1" CornerRadius="6">
                        <TextBox Style="{StaticResource SearchTextBox}" Height="64" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10,8"
                                 Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                 hc:InfoElement.Placeholder="如：3 单元电梯钢丝绳更换" />
                    </Border>

                    <TextBlock Text="收款方" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <Border Height="34" Margin="0,8,0,20" Background="#F7F4EE" BorderBrush="{StaticResource BorderBrushColor}"
                            BorderThickness="1" CornerRadius="6">
                        <TextBox Style="{StaticResource SearchTextBox}"
                                 Text="{Binding Payee, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonPrimary}" Content="保存" Command="{Binding SaveCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="取消" FontSize="13"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding CancelCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <!-- ============ 支出详情弹层（T4F-5-1 查看） ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="7" Visibility="{Binding IsDetailVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="支出详情" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="支出编号" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedRow.NoText}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="日期" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedRow.DateText}" FontSize="12" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="类别" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedRow.CategoryName}" FontSize="12" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="金额" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedRow.AmountText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="收款方" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedRow.PayeeText}" FontSize="12" />
                        <TextBlock Grid.Row="10" Grid.Column="0" Text="状态" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding SelectedRow.StatusText}" FontSize="12" />
                        <TextBlock Grid.Row="12" Grid.Column="0" Text="摘要" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Top" />
                        <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding SelectedRow.Note}" FontSize="12" TextWrapping="Wrap" />
                    </Grid>
                    <Button Style="{StaticResource ButtonPrimary}" Content="关闭" Margin="0,20,0,0"
                            HorizontalAlignment="Center" Command="{Binding CloseDetailCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 删除二次确认弹层（T4F-5-1，BR-FIN-10 软删除） ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="7" Visibility="{Binding IsConfirmVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="确认删除" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="确认删除这笔支出（" /><Run Text="{Binding ConfirmRow.NoText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ConfirmRow.AmountText, Mode=OneWay}" /><Run Text="）？删除为软删除，保留记录轨迹。" />
                    </TextBlock>
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonPrimary}" Content="确认删除" Command="{Binding ConfirmDeleteCommand}" />
                        <Button Grid.Column="2" Content="取消" FontSize="13" Command="{Binding CancelDeleteCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 批量删除二次确认弹层（v1.1.0-⑤，BR-FIN-10 软删留痕） ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="7" Visibility="{Binding IsBatchConfirmVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="批量删除支出记录" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding BatchConfirmText}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" />
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonPrimary}" Background="{StaticResource DangerBrush}"
                                Content="确认删除" Command="{Binding ConfirmBatchDeleteCommand}" />
                        <Button Grid.Column="2" Content="取消" FontSize="13" Command="{Binding CancelBatchDeleteConfirmCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ v1.1.0 第 7 轮：设置本月预算（系统参数 finance.budget.monthly） ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="7" Visibility="{Binding IsBudgetFormVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="设置本月预算" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="月度支出预算用于「本月预算」卡片展示已用进度；填 0 表示清除预算。"
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,16" />

                    <TextBlock Text="月度预算（元）" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <Border Height="34" Margin="0,8,0,16" Background="#F7F4EE" BorderBrush="{StaticResource BorderBrushColor}"
                            BorderThickness="1" CornerRadius="6">
                        <TextBox Style="{StaticResource SearchTextBox}" AutomationProperties.AutomationId="BudgetInputBox"
                                 Text="{Binding BudgetInput, UpdateSourceTrigger=PropertyChanged}"
                                 hc:InfoElement.Placeholder="如：50000" />
                    </Border>

                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonPrimary}" Content="保存" Command="{Binding SaveBudgetCommand}" />
                        <Button Grid.Column="2" Content="取消" FontSize="13" Command="{Binding CancelBudgetCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<!-- 已下线（R4 变更）：复盘记录页视图存档，未加入工程文件（不参与编译）。 -->
<UserControl x:Class="PropertyManagement.Client.Views.EmergencyReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             FontFamily="微软雅黑">
    <UserControl.Resources>
        <!-- 复盘状态标签 -->
        <Style x:Key="ReviewStatusTag" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusText}" Value="进行中">
                    <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="已完成">
                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ReviewStatusTagText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusText}" Value="进行中">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="已完成">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 改进项逾期标红（期限早于今天且未完成） -->
        <Style x:Key="ItemCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左列：复盘列表 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,14,16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="复盘列表" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Style="{StaticResource ButtonPrimary}" Content="新增复盘" Height="36"
                                Command="{Binding OpenNewReviewCommand}" />
                    </Grid>
                    <Border Grid.Row="1" Margin="16,0,16,0" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6">
                        <DataGrid Style="{StaticResource GridStyle}" ItemsSource="{Binding Reviews}" IsReadOnly="True"
                                  SelectedItem="{Binding SelectedReview, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="复盘编号" Width="90" Binding="{Binding ReviewNo}" ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="关联事件" Width="118" Binding="{Binding EventNo}" ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="复盘日期" Width="88" Binding="{Binding PlanDateText}" ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="主持人" Width="80" Binding="{Binding HostName}" ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="改进项" Width="64" Binding="{Binding ItemCountText}" ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTextColumn Header="完成度" Width="60" Binding="{Binding CompletionText}" ElementStyle="{StaticResource GridCellText}" />
                                <DataGridTemplateColumn Header="状态" Width="78">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ReviewStatusTag}">
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource ReviewStatusTagText}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <!-- 提醒条（原型行 184-186） -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,10,16,14">
                        <Path Data="{StaticResource Icon.ClockAlert}" Style="{StaticResource IconStroke}"
                              Stroke="{StaticResource WarningBrush}" Width="14" Height="14" VerticalAlignment="Top" />
                        <TextBlock Text="事件结案后 7 日内未建复盘 → 仪表盘待办与工作台顶部双重提醒；补录事件同样纳入。"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   VerticalAlignment="Top" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右列：复盘详情 -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- 详情头 -->
                    <Grid Grid.Row="0" Margin="16,14,16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="{Binding DetailTitle}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource ReviewStatusTag}" Margin="10,0,0,0" DataContext="{Binding Detail}"
                                    Visibility="{Binding DataContext.HasDetailVisibility, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource ReviewStatusTagText}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="暂无复盘记录：点击「新增复盘」关联已结案事件"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding NoDetailVisibility}" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasDetailVisibility}">
                        <StackPanel Margin="16,0,16,14">
                            <!-- 事件概要 -->
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="事件概要" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding EventSummary}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="16,0,0,0" TextWrapping="Wrap" MaxWidth="420" VerticalAlignment="Top" />
                                </StackPanel>
                            </Border>
                            <!-- 问题与根因 -->
                            <TextBlock Text="问题与根因" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding CauseBullets}" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <Ellipse Width="5" Height="5" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                                       Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="460" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- 改进措施 -->
                            <TextBlock Text="改进措施" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <Border BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6">
                                <DataGrid Style="{StaticResource GridStyle}" ItemsSource="{Binding DetailItems}" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="措施" Width="*" Binding="{Binding Content}" ElementStyle="{StaticResource GridCellText}" />
                                        <DataGridTextColumn Header="责任人" Width="80" Binding="{Binding Owner}" ElementStyle="{StaticResource GridCellText}" />
                                        <DataGridTextColumn Header="期限" Width="88" Binding="{Binding DueText}" ElementStyle="{StaticResource ItemCell}" />
                                        <DataGridTextColumn Header="状态" Width="76" Binding="{Binding StatusText}" ElementStyle="{StaticResource ItemCell}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="4" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="11" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
        </DockPanel>

        <!-- 交互标注（原型行 246-251） -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Path Data="{StaticResource Icon.Check}" Style="{StaticResource IconStroke}"
                          Stroke="{StaticResource PrimaryBrush}" Width="12" Height="12" VerticalAlignment="Center" />
                    <TextBlock Text="交互标注" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Text="· 【新增复盘】→ 关联已结案事件 → 邀请参与人 → 生成改进项清单并跟踪至完成"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock Text="· 改进项逾期未完成 → 状态变红并计入负责人周报"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <!-- 新增复盘弹窗（关联已结案事件，不再固定写第一个事件） -->
        <Grid Grid.RowSpan="5" Visibility="{Binding IsNewReviewVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="620" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="新增复盘" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="【新增复盘】→ 关联已结案事件 → 生成改进项清单并跟踪至完成（原型交互标注）。" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,12" TextWrapping="Wrap" />
                        <TextBlock Text="已结案事件 *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding ClosedEvents}" SelectedItem="{Binding NewReviewTarget, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayText" Height="32" Margin="0,6,0,0" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="主持人" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding NewReviewHost, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,6,0,0"
                                         hc:InfoElement.Placeholder="为空默认当前登录用户" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="复盘日期（计划）" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                <DatePicker SelectedDate="{Binding NewReviewDate, Mode=TwoWay}" Height="32" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="问题与根因 *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0" />
                        <TextBox Text="{Binding NewReviewCause, UpdateSourceTrigger=PropertyChanged}" Height="72" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto"
                                 hc:InfoElement.Placeholder="逐条填写，每行一条，如：五方对讲音量小，被困人员首次呼叫未接通" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="改进措施（措施 / 责任人 / 期限）" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="添加措施" Command="{Binding AddItemRowCommand}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding FormItems}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" Height="30"
                                                 hc:InfoElement.Placeholder="措施内容" />
                                        <TextBox Grid.Column="1" Text="{Binding Owner, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="6,0,0,0"
                                                 hc:InfoElement.Placeholder="责任人" />
                                        <DatePicker Grid.Column="2" SelectedDate="{Binding DueDate, Mode=TwoWay}" Height="30" Margin="6,0,0,0" />
                                        <Button Grid.Column="3" Style="{StaticResource LinkButton}" Content="删除" Foreground="{StaticResource DangerBrush}"
                                                Margin="6,0,0,0" Command="{Binding DataContext.RemoveItemRowCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelNewReviewCommand}" />
                            <Button Style="{StaticResource ButtonPrimary}" Content="提交复盘" Command="{Binding SubmitReviewCommand}" Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

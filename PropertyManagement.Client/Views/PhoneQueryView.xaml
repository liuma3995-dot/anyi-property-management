<UserControl x:Class="PropertyManagement.Client.Views.PhoneQueryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             FontFamily="微软雅黑">
    <UserControl.Resources>
        <!-- 分类 tab 按钮（本地资源）：默认白底描边，选中态主色浅底高亮 -->
        <Style x:Key="CategoryTabButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F2F4F7" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 详情卡标签徽章（分类名 / 备注，如"物业服务中心 · 24 小时"） -->
        <Style x:Key="DetailTagBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,2" />
        </Style>

        <!-- 查询结果文本列：超出列宽时省略号，避免被裁剪遮挡（针对分类等固定列） -->
        <Style x:Key="GridCellTextTrim" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 大搜索框：输入即自动检索（参考电话条目维护模块） -->
        <Border Grid.Row="0" Height="44" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Style="{StaticResource IconStroke}" Stroke="{StaticResource TextMutedBrush}" Width="18" Height="18" Margin="14,0,0,0" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Style="{StaticResource SearchTextBox}" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" hc:InfoElement.Placeholder="搜索名称或号码，如：物业服务中心 / 119 / 电梯维保" FontSize="12" Margin="10,0,12,0" VerticalAlignment="Center">
                </TextBox>
            </Grid>
        </Border>

        <!-- 分类筛选：全部 + 五分类（SelectCategoryCommand + CommandParameter=categoryId，选中态高亮） -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <ItemsControl ItemsSource="{Binding CategoryTabs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CategoryTabButton}" Content="{Binding Name}" Margin="0,0,8,0"
                                Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                CommandParameter="{Binding Id}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- 主体区：左列查询结果 + 右列详情卡 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <!-- 左列：查询结果 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,12,14,0">
                        <TextBlock Text="查询结果（按置顶 + 拼音排序）" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding TotalText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,1,0,0" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" Style="{StaticResource GridStyle}" Margin="0,8,0,0" ItemsSource="{Binding Items}" IsReadOnly="True" SelectedItem="{Binding SelectedRow}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="★" Width="36" Binding="{Binding TopMark}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="名称" Width="*" Binding="{Binding Name}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="电话" Width="130" Binding="{Binding Phone}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="分类" Width="130" Binding="{Binding Category}" ElementStyle="{StaticResource GridCellTextTrim}" />
                            <DataGridTextColumn Header="备注" Width="*" Binding="{Binding Note}" ElementStyle="{StaticResource GridCellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 右列：详情卡（详情头 / 大号码 / 按钮组） -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16">
                <Grid>
                    <!-- 空态 -->
                    <TextBlock Text="请在左侧选择条目查看详情" Foreground="{StaticResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 详情主体 -->
                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 详情头：图标座 + 名称 + 标签行（分类名 · 备注） -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="46" Height="46" CornerRadius="10" Background="{StaticResource PrimarySoftBrush}">
                                <Path Data="{StaticResource Icon.PhoneCall}" Style="{StaticResource IconStroke}" Stroke="{StaticResource PrimaryBrush}" Width="24" Height="24" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedRow.Name}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <Border Style="{StaticResource DetailTagBorder}">
                                        <TextBlock Text="{Binding SelectedRow.Category}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                    <Border Style="{StaticResource DetailTagBorder}" Margin="6,0,0,0" Visibility="{Binding SelectedRow.HasNote, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding SelectedRow.Note}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 大号码（Phone 原文） -->
                        <TextBlock Grid.Row="1" Text="{Binding SelectedRow.Phone}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,16,0,0" TextTrimming="CharacterEllipsis" />

                        <!-- 按钮组：复制号码 / 置顶 -->
                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Height="36" Style="{StaticResource ButtonSecondary}" Padding="2,0" FontSize="13" Command="{Binding CopyCommand}" CommandParameter="{Binding SelectedRow}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.ClipboardCheck}" Style="{StaticResource IconStroke}" Stroke="{StaticResource TextSecondaryBrush}" Width="13" Height="13" />
                                    <TextBlock Text="复制号码" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Height="36" Style="{StaticResource ButtonSecondary}" Padding="2,0" FontSize="13"
                                    Command="{Binding TopCommand}" CommandParameter="{Binding SelectedRow}"
                                    IsEnabled="{Binding SelectedRow.CanTop}"
                                    ToolTip="紧急电话默认置顶，不可取消">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.ChevronUp}" Style="{StaticResource IconStroke}" Stroke="{StaticResource TextSecondaryBrush}" Width="13" Height="13" />
                                    <TextBlock Text="置顶" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态 / 错误行 -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource SuccessBrush}" FontSize="11" VerticalAlignment="Center" />
        </Grid>

        <!-- 交互标注 -->
        <Border Grid.Row="8" Background="#F7F5FE" CornerRadius="6" Padding="12,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Eye}" Style="{StaticResource IconStroke}" Stroke="#5B3DF5" Width="12" Height="12" />
                    <TextBlock Text="交互标注" Foreground="#5B3DF5" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Text="· 【复制】→ 号码入剪贴板并提示「已复制」；【置顶】→ 条目移至列表首位并加 ★ 标识" Foreground="#4A3AB0" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="· 搜索输入即自动检索，支持名称 / 号码片段 / 拼音首字母" Foreground="#4A3AB0" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="PropertyManagement.Client.Views.EmployeeListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             FontFamily="微软雅黑">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏：搜索（输入即自动联动）/ 部门 / 岗位（随部门联动）/ 在岗状态 + 新增员工 / 导出 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Height="32" Width="220" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </Grid.InputBindings>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Style="{StaticResource IconStroke}" Stroke="{StaticResource TextMutedBrush}" Width="14" Height="14" Margin="10,0,0,0" />
                        <TextBox Grid.Column="1" Style="{StaticResource SearchTextBox}" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" hc:InfoElement.Placeholder="搜索工号 / 姓名 / 电话" FontSize="11" Margin="8,0,12,0" />
                    </Grid>
                </Border>
                <ComboBox Height="32" Width="128" Margin="8,0,0,0" ItemsSource="{Binding DeptFilterItems}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding DeptFilter, Mode=TwoWay}" />
                <ComboBox Height="32" Width="128" Margin="8,0,0,0" ItemsSource="{Binding PositionFilterItems}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding PositionFilter, Mode=TwoWay}" />
                <ComboBox Height="32" Width="136" Margin="8,0,0,0" ItemsSource="{Binding StatusFilterItems}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding StatusFilter, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ButtonPrimary}" Content="新增员工" Command="{Binding NewCommand}" Visibility="{Binding IsNotBatchMode, Converter={StaticResource BoolToVis}}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsBatchMode, Converter={StaticResource BoolToVis}}">
                    <CheckBox Content="全选" IsChecked="{Binding IsAllChecked, Mode=TwoWay}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CheckedCountText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <Button Height="32" FontSize="13" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Content="确认删除" Command="{Binding ConfirmSelectionCommand}" Margin="10,0,0,0" />
                    <Button Height="32" FontSize="13" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Content="取消" Command="{Binding CancelBatchDeleteCommand}" Margin="6,0,0,0" />
                </StackPanel>
                <Button Height="32" FontSize="13" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Content="批量删除" Command="{Binding BatchDeleteCommand}" Margin="10,0,0,0" Visibility="{Binding IsNotBatchMode, Converter={StaticResource BoolToVis}}" />
                <Button Height="32" FontSize="13" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Content="导出" Command="{Binding ExportCommand}" Margin="10,0,0,0" Visibility="{Binding IsNotBatchMode, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Grid>

        <!-- 数据表 -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid Style="{StaticResource GridStyle}" ItemsSource="{Binding Items}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40">
                        <DataGridTemplateColumn.Header>
                            <CheckBox IsChecked="{Binding DataContext.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Mode=TwoWay}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="{Binding DataContext.IsBatchMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVis}}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="RowCheckBox_Click" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="{Binding DataContext.IsBatchMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVis}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="工号" Width="72" Binding="{Binding EmpNo}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="姓名" Width="90" Binding="{Binding Name}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="部门" Width="100" Binding="{Binding DeptName}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="岗位" Width="100" Binding="{Binding PositionName}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="入职日期" Width="104" Binding="{Binding HireDate}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="联系电话" Width="110" Binding="{Binding Phone}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTemplateColumn Header="状态" Width="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBg}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusFg}" FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="操作" Width="*" MinWidth="190">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource LinkButton}" Content="档案" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource LinkButton}" Content="交接记录" Visibility="{Binding ShowResignedOps, Converter={StaticResource BoolToVis}}" Command="{Binding DataContext.HandoverCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Margin="8,0,0,0" />
                                    <Button Style="{StaticResource LinkButton}" Content="离职" Foreground="{Binding ResignFg}" Visibility="{Binding ShowResign, Converter={StaticResource BoolToVis}}" Command="{Binding DataContext.ResignCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Margin="8,0,0,0" />
                                    <Button Style="{StaticResource LinkButton}" Content="删除档案" Foreground="{Binding ResignFg}" Visibility="{Binding ShowResignedOps, Converter={StaticResource BoolToVis}}" Command="{Binding DataContext.DeleteArchiveCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Margin="8,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 分页 + 状态 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding TotalText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SuccessBrush}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Height="24" FontSize="12" Background="Transparent" BorderThickness="0" Style="{StaticResource LinkButton}" Content="上一页" Command="{Binding PrevPageCommand}" />
                <Button Height="24" FontSize="12" Background="Transparent" BorderThickness="0" Style="{StaticResource LinkButton}" Content="下一页" Command="{Binding NextPageCommand}" Margin="6,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- 交互标注 -->
        <Border Grid.Row="6" Background="#F7F5FE" CornerRadius="6" Padding="12,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Eye}" Style="{StaticResource IconStroke}" Stroke="#5B3DF5" Width="12" Height="12" />
                    <TextBlock Text="交互标注" Foreground="#5B3DF5" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Text="· 【新增员工】→ 录入档案；【编辑】→ 修改员工信息" Foreground="#4A3AB0" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="· 【离职】→ 办理交接并保留档案；【删除档案/批量删除】→ 仅已离职员工可删除" Foreground="#4A3AB0" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- 新增 / 编辑员工 -->
        <Border Grid.RowSpan="7" Background="#66000000" Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="470" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,18" />
                    <TextBlock Text="部门" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                        <ComboBox SelectedValue="{Binding FormDeptId}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="180" ItemsSource="{Binding Departments}" />
                        <Button Style="{StaticResource LinkButton}" Content="＋新增" Command="{Binding OpenNewDeptCommand}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Button Style="{StaticResource LinkButton}" Content="删除" Command="{Binding DeleteDeptCommand}" Foreground="#D64545" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,12" Visibility="{Binding IsDeptAdd, Converter={StaticResource BoolToVis}}">
                        <TextBox Text="{Binding NewDeptName, UpdateSourceTrigger=PropertyChanged}" Height="32" Width="220" hc:InfoElement.Placeholder="输入部门名称，如 物业办" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="保存部门" Command="{Binding ConfirmNewDeptCommand}" Margin="8,0,0,0" />
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelNewDeptCommand}" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="岗位" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                        <ComboBox SelectedValue="{Binding FormPositionId}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="180" ItemsSource="{Binding Positions}" />
                        <Button Style="{StaticResource LinkButton}" Content="＋新增" Command="{Binding OpenNewPositionCommand}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Button Style="{StaticResource LinkButton}" Content="删除" Command="{Binding DeletePositionCommand}" Foreground="#D64545" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,12" Visibility="{Binding IsPositionAdd, Converter={StaticResource BoolToVis}}">
                        <TextBox Text="{Binding NewPositionName, UpdateSourceTrigger=PropertyChanged}" Height="32" Width="220" hc:InfoElement.Placeholder="输入岗位名称，如 客服专员" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="保存岗位" Command="{Binding ConfirmNewPositionCommand}" Margin="8,0,0,0" />
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelNewPositionCommand}" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="姓名" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,6,0,12" />
                    <TextBlock Text="联系电话" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,6,0,12" />
                    <TextBlock Text="入职日期" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <hc:DatePicker SelectedDate="{Binding FormHireDate, Mode=TwoWay}" Height="32" Margin="0,6,0,12" />
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelCommand}" />
                            <Button Style="{StaticResource ButtonPrimary}" Content="保存" Command="{Binding SaveCommand}" Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <!-- 确认办理离职（BR-ORG-02：档案保留 + 账号停用 + 权限回收 + 电话簿联动） -->
        <Border Grid.RowSpan="7" Background="#66000000" Visibility="{Binding IsResignVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="确认办理离职？" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" />
                    <TextBlock Text="{Binding ResignRow.Name, StringFormat=员工：{0}}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="离职后将办理工作交接、回收系统权限、停用登录账号与门禁，便民电话簿对应条目自动停用；档案保留，可随时查阅。" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelResignCommand}" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="确认离职" Command="{Binding ConfirmResignCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- 删除档案（仅已离职员工） -->
        <Border Grid.RowSpan="7" Background="#66000000" Visibility="{Binding IsDeleteVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="确认删除档案？" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" />
                    <TextBlock Text="{Binding DeleteRow.Name, StringFormat=员工：{0}}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="仅已办理离职的员工可删除档案，删除后不可恢复。" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelDeleteArchiveCommand}" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="确认删除" Command="{Binding ConfirmDeleteArchiveCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- 交接 / 状态记录 -->
        <Border Grid.RowSpan="7" Background="#66000000" Visibility="{Binding IsLogVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="交接 / 状态记录" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding LogRow.Name, StringFormat=员工：{0}}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding LogRows}" MaxHeight="220" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,0,1" Padding="0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ChangedAtText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Style="{StaticResource ButtonSecondary}" Content="关闭" Command="{Binding CloseHandoverCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- 确认批量删除员工 -->
        <Border Grid.RowSpan="7" Background="#66000000" Visibility="{Binding IsBatchConfirmVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="确认批量删除员工？" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" />
                    <TextBlock Text="{Binding BatchConfirmMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="仅已办理离职的员工可删除档案，在职员工将跳过；删除后不可恢复。" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelBatchDeleteCommand}" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="确认删除" Command="{Binding ConfirmBatchDeleteCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- 确认删除部门 -->
        <Border Grid.RowSpan="7" Background="#66000000" Visibility="{Binding IsDeptDeleteVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="确认删除部门？" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" />
                    <TextBlock Text="{Binding DeleteDeptName, StringFormat=部门：{0}}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="仅部门下无员工时可删除；删除后不可恢复。" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelDeleteDeptCommand}" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="确认删除" Command="{Binding ConfirmDeleteDeptCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- 确认删除岗位 -->
        <Border Grid.RowSpan="7" Background="#66000000" Visibility="{Binding IsPositionDeleteVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="确认删除岗位？" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" />
                    <TextBlock Text="{Binding DeletePositionName, StringFormat=岗位：{0}}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="仅岗位下无员工时可删除；删除后不可恢复。" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelDeletePositionCommand}" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="确认删除" Command="{Binding ConfirmDeletePositionCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>

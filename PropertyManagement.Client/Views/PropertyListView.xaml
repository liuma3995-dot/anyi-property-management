<UserControl x:Class="PropertyManagement.Client.Views.PropertyListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:controls="clr-namespace:PropertyManagement.Client.Assets.Controls"
             FontFamily="微软雅黑">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Height="32" Width="200" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Style="{StaticResource IconStroke}" Stroke="{StaticResource TextMutedBrush}" Width="14" Height="14" Margin="10,0,0,0" />
                        <TextBox Grid.Column="1" Style="{StaticResource SearchTextBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" hc:InfoElement.Placeholder="搜索房号 / 业主 / 电话" FontSize="11" Margin="8,0,12,0" />
                    </Grid>
                </Border>
                <ComboBox Height="32" MinWidth="120" Margin="8,0,0,0" ItemsSource="{Binding BuildingFilterItems}" DisplayMemberPath="BuildingNo" SelectedValuePath="Id" SelectedValue="{Binding BuildingFilter, Mode=TwoWay}" />
                <ComboBox Height="32" Width="120" Margin="8,0,0,0" SelectedIndex="{Binding StatusFilter, Mode=TwoWay}">
                    <ComboBoxItem Content="状态：全部" />
                    <ComboBoxItem Content="状态：已入住" />
                    <ComboBoxItem Content="状态：装修中" />
                    <ComboBoxItem Content="状态：空置" />
                </ComboBox>
                <ComboBox Height="32" Width="130" Margin="8,0,0,0" SelectedIndex="{Binding ArrearFilter, Mode=TwoWay}">
                    <ComboBoxItem Content="欠费：全部" />
                    <ComboBoxItem Content="欠费：仅看欠费" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource ButtonPrimary}" Content="新增房产" Command="{Binding NewCommand}" />
                <Button Height="32" FontSize="13" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Content="批量删除" Command="{Binding BatchDeleteCommand}" Margin="10,0,0,0" />
                <Button Height="32" FontSize="13" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Content="导出 Excel" Command="{Binding ExportCommand}" Margin="10,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- 数据表 -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid Style="{StaticResource GridStyle}" ItemsSource="{Binding Items}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding DataContext.IsSelectAll, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Mode=TwoWay}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="全选" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="RowCheckBox_Click" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="房产编号" Width="100" Binding="{Binding NoText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="房号" Width="*" Binding="{Binding Path}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="建筑面积" Width="86" Binding="{Binding AreaText}" ElementStyle="{StaticResource GridCellText}" />
                    <!-- CHG-v1.1.2-48：新增「用途」列（收费规格适用条件按房产用途判定，列表此前看不到该维度） -->
                    <DataGridTextColumn Header="用途" Width="72" Binding="{Binding UsageText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="业主" Width="*" Binding="{Binding OwnerName}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="联系电话" Width="116" Binding="{Binding OwnerPhone}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTemplateColumn Header="状态" Width="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBg}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="当前欠费" Width="92">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ArrearText}" Foreground="{Binding ArrearBrush}" FontSize="12" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="操作" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource LinkButton}" Content="查看" Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource LinkButton}" Content="删除" Foreground="{StaticResource DangerBrush}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 分页 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding TotalText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SuccessBrush}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Height="24" FontSize="12" Background="Transparent" BorderThickness="0" Style="{StaticResource LinkButton}" Content="上一页" Command="{Binding PrevPageCommand}" />
                <Button Height="24" FontSize="12" Background="Transparent" BorderThickness="0" Style="{StaticResource LinkButton}" Content="下一页" Command="{Binding NextPageCommand}" Margin="6,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- 交互标注 -->
        <Border Grid.Row="5" Background="#F7F5FE" CornerRadius="6" Padding="12,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Eye}" Style="{StaticResource IconStroke}" Stroke="#5B3DF5" Width="12" Height="12" />
                    <TextBlock Text="交互标注" Foreground="#5B3DF5" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Text="· 点击行或【查看】→ 打开房产详情（含业主档案、缴费记录）；【导出 Excel】按当前筛选结果导出" Foreground="#4A3AB0" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="· 【新增房产】→ 弹窗录入楼栋/单元/房号/面积 → 保存校验房号唯一性" Foreground="#4A3AB0" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                <TextBlock Text="· 【删除】→ 软删前校验跨模块引用：存在业主绑定关系 / 未删除账单 / 绑定车位时禁止删除并提示先处理（避免清理留痕后账单、车位失去主体）" Foreground="#4A3AB0" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- 房产详情 -->
        <Border Grid.RowSpan="6" Background="#66000000" Visibility="{Binding IsViewVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="房产详情" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding ViewRow.NoText}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="房号" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                            <TextBlock Text="{Binding ViewRow.Path}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="建筑面积" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                            <TextBlock Text="{Binding ViewRow.AreaText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="业主" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                            <TextBlock Text="{Binding ViewRow.OwnerName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="联系电话" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                            <TextBlock Text="{Binding ViewRow.OwnerPhone}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="状态" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                            <Border Background="{Binding ViewRow.StatusBg}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <TextBlock Text="{Binding ViewRow.StatusText}" Foreground="{Binding ViewRow.StatusBrush}" FontSize="11" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="当前欠费" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                            <TextBlock Text="{Binding ViewRow.ArrearText}" Foreground="{Binding ViewRow.ArrearBrush}" FontSize="13" FontWeight="Bold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource ButtonSecondary}" Content="编辑" Command="{Binding EditCommand}" CommandParameter="{Binding ViewRow}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="关闭" Command="{Binding CloseViewCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- 新增/编辑弹层 -->
        <Border Grid.RowSpan="6" Background="#66000000" Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,18" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="所属楼栋" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                        <Button Style="{StaticResource LinkButton}" Content="＋新增" Command="{Binding OpenNewBuildingCommand}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Button Style="{StaticResource LinkButton}" Content="删除" Foreground="{StaticResource DangerBrush}" Command="{Binding DeleteBuildingCommand}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding Buildings}" DisplayMemberPath="BuildingNo" SelectedValuePath="Id" SelectedValue="{Binding FormBuildingId, Mode=TwoWay}" Margin="0,6,0,12" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Visibility="{Binding IsBuildingAdd, Converter={StaticResource BoolToVis}}">
                        <TextBox Text="{Binding NewBuildingNo, UpdateSourceTrigger=PropertyChanged}" Height="32" Width="180" hc:InfoElement.Placeholder="输入楼栋号，如 6号楼" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="保存楼栋" Command="{Binding ConfirmNewBuildingCommand}" Margin="8,0,0,0" />
                        <Button Style="{StaticResource LinkButton}" Content="取消" Command="{Binding CancelNewBuildingCommand}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="所属单元（选填）" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                        <Button Style="{StaticResource LinkButton}" Content="＋新增" Command="{Binding OpenNewUnitCommand}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Button Style="{StaticResource LinkButton}" Content="删除" Foreground="{StaticResource DangerBrush}" Command="{Binding DeleteUnitCommand}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding Units}" DisplayMemberPath="UnitNo" SelectedValuePath="Id" SelectedValue="{Binding FormUnitId, Mode=TwoWay}" Margin="0,6,0,12" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Visibility="{Binding IsUnitAdd, Converter={StaticResource BoolToVis}}">
                        <TextBox Text="{Binding NewUnitNo, UpdateSourceTrigger=PropertyChanged}" Height="32" Width="180" hc:InfoElement.Placeholder="输入单元号，如 2单元" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="保存单元" Command="{Binding ConfirmNewUnitCommand}" Margin="8,0,0,0" />
                        <Button Style="{StaticResource LinkButton}" Content="取消" Command="{Binding CancelNewUnitCommand}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="房号" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBox x:Name="RoomNoBox" Text="{Binding FormRoomNo, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,6,0,12" />
                    <TextBlock Text="建筑面积（㎡，最多 2 位小数）" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <!-- CHG-v1.1.2-08：建筑面积收敛到公共小数控件（原为页面局部实现，同类缺陷因此在别处复发） -->
                    <controls:DecimalTextBox x:Name="AreaBox" Text="{Binding FormAreaText, UpdateSourceTrigger=PropertyChanged}"
                             Height="32" Margin="0,6,0,0" />
                    <TextBlock x:Name="AreaError" Text="{Binding FormAreaError}" Foreground="{StaticResource DangerBrush}" FontSize="11" Margin="0,4,0,12" />
                    <TextBlock Text="用途 / 状态" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,18">
                        <ComboBox SelectedValue="{Binding FormUsage}" SelectedValuePath="Tag" Width="150">
                            <ComboBoxItem Content="住宅" Tag="Residential" />
                            <ComboBoxItem Content="商铺" Tag="Commercial" />
                            <!-- CHG-v1.1.2-48：用途支持「空置」（与「状态」维度区分：用途=空置用于按空置定价的规格条件） -->
                            <ComboBoxItem Content="空置" Tag="Vacant" />
                        </ComboBox>
                        <ComboBox SelectedValue="{Binding FormStatus}" SelectedValuePath="Tag" Width="150" Margin="10,0,0,0">
                            <ComboBoxItem Content="空置" Tag="Vacant" />
                            <ComboBoxItem Content="已入住" Tag="Occupied" />
                            <ComboBoxItem Content="装修中" Tag="Renovating" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelCommand}" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="保存" Command="{Binding SaveCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- 删除确认 -->
        <Border Grid.RowSpan="6" Background="#66000000" Visibility="{Binding IsDeleteConfirmVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="{Binding DeleteConfirmTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" />
                    <TextBlock Text="{Binding DeleteConfirmMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="删除为软删除，删除后从列表移除并留痕。" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelDeleteCommand}" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="确认删除" Command="{Binding ConfirmDeleteCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>

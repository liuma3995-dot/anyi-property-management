<UserControl x:Class="PropertyManagement.Client.Views.PhoneEntryMaintainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             FontFamily="微软雅黑">
    <UserControl.Resources>
        <!-- 分页页码按钮：当前页主色浅底高亮 -->
        <Style x:Key="PageNumberButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="6,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E9F0EE" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏：筛选区（搜索/分类/来源/状态）+ 新增条目/同步员工通讯录 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Height="32" Width="200" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Style="{StaticResource IconStroke}" Stroke="{StaticResource TextMutedBrush}" Width="14" Height="14" Margin="10,0,0,0" />
                        <TextBox Grid.Column="1" Style="{StaticResource SearchTextBox}" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" hc:InfoElement.Placeholder="搜索名称 / 号码" FontSize="11" Margin="8,0,12,0" />
                    </Grid>
                </Border>
                <ComboBox Height="32" Width="130" Margin="8,0,0,0" ItemsSource="{Binding FilterCategories}" SelectedValue="{Binding CategoryFilter, Mode=TwoWay}" SelectedValuePath="Id" DisplayMemberPath="Name" />
                <ComboBox Height="32" Width="130" Margin="8,0,0,0" SelectedIndex="{Binding SourceFilter, Mode=TwoWay}">
                    <ComboBoxItem Content="来源：全部" />
                    <ComboBoxItem Content="来源：手工" />
                    <ComboBoxItem Content="来源：员工通讯录" />
                </ComboBox>
                <ComboBox Height="32" Width="120" Margin="8,0,0,0" SelectedIndex="{Binding StatusFilter, Mode=TwoWay}">
                    <ComboBoxItem Content="状态：全部" />
                    <ComboBoxItem Content="状态：启用" />
                    <ComboBoxItem Content="状态：停用" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsBatchMode, Converter={StaticResource BoolToVis}}">
                    <CheckBox Content="全选" IsChecked="{Binding IsAllChecked, Mode=TwoWay}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CheckedCountText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Height="32" FontSize="13" Background="{StaticResource DangerSoftBrush}" Foreground="{StaticResource DangerBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Content="批量停用" Command="{Binding EnterBatchModeCommand}" Visibility="{Binding ShowBatchStart, Converter={StaticResource BoolToVis}}" />
                <Button Height="32" FontSize="13" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Content="取消" Command="{Binding CancelBatchCommand}" Margin="10,0,0,0" Visibility="{Binding IsBatchMode, Converter={StaticResource BoolToVis}}" />
                <Button Height="32" FontSize="13" Background="{StaticResource DangerSoftBrush}" Foreground="{StaticResource DangerBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Content="确认停用" Command="{Binding BatchDisableCommand}" IsEnabled="{Binding HasChecked}" Margin="8,0,0,0" Visibility="{Binding IsBatchMode, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource ButtonPrimary}" Content="新增条目" Command="{Binding NewCommand}" Margin="10,0,0,0" />
                <Button Height="32" FontSize="13" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Content="同步员工通讯录" Command="{Binding SyncCommand}" Margin="10,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- 数据表：分类/名称/电话/来源/置顶/状态/更新时间/操作 -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid x:Name="EntriesGrid" Style="{StaticResource GridStyle}" ItemsSource="{Binding Items}" IsReadOnly="True" SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40">
                        <DataGridTemplateColumn.Header>
                            <CheckBox IsChecked="{Binding DataContext.IsAllChecked, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Mode=TwoWay}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="{Binding DataContext.IsBatchMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVis}}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="BatchCheckBox_Click" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsEnabled="{Binding CanSelect}"
                                          Visibility="{Binding DataContext.IsBatchMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource BoolToVis}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="分类" Width="110" Binding="{Binding Category}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="名称" Width="*" Binding="{Binding Name}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="电话" Width="130" Binding="{Binding Phone}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="来源" Width="100" Binding="{Binding Source}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTemplateColumn Header="置顶" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="8,3" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EEF2F7" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTop}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Path Data="{StaticResource Icon.Star}" Fill="{StaticResource WarningBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTop}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Text="—" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTop}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="状态" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="8,3" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#EEF2F7" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusText}" Value="启用">
                                                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusText}" Value="启用">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="更新时间" Width="100" Binding="{Binding UpdatedAt}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTemplateColumn Header="操作" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource LinkButton}" Content="编辑" Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource LinkButton}" Content="停用" Foreground="{StaticResource DangerBrush}" Visibility="{Binding CanDeactivate, Converter={StaticResource BoolToVis}}" Command="{Binding DataContext.DeactivateCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Margin="8,0,0,0" />
                                    <Button Style="{StaticResource LinkButton}" Content="恢复" Visibility="{Binding CanActivate, Converter={StaticResource BoolToVis}}" Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Margin="8,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 分页条：总数/页码 + 状态/错误 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding TotalText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SuccessBrush}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Height="24" FontSize="12" Background="Transparent" BorderThickness="0" Style="{StaticResource LinkButton}" Content="上一页" Command="{Binding PrevPageCommand}" />
                <ItemsControl ItemsSource="{Binding PageNumbers}" Margin="4,0" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PageNumberButton}" Content="{Binding Number}" Margin="2,0"
                                    Command="{Binding DataContext.GotoPageCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding Number}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Height="24" FontSize="12" Background="Transparent" BorderThickness="0" Style="{StaticResource LinkButton}" Content="下一页" Command="{Binding NextPageCommand}" Margin="4,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- 交互标注 -->
        <Border Grid.Row="6" Background="#F7F5FE" CornerRadius="6" Padding="12,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Eye}" Style="{StaticResource IconStroke}" Stroke="#5B3DF5" Width="12" Height="12" />
                    <TextBlock Text="交互标注" Foreground="#5B3DF5" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Text="· 员工离职 → 其通讯录来源条目自动【自动停用】并通知管理员确认（UC-TEL-005）" Foreground="#4A3AB0" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="· 新增/编辑时校验号码重复与格式；【同步员工通讯录】→ 按在岗员工批量刷新" Foreground="#4A3AB0" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- 新增/编辑弹窗 -->
        <Border Grid.RowSpan="9" Background="#66000000" Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="440" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,18" />
                    <TextBlock Text="分类" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,3">
                        <ComboBox IsEditable="True" FontSize="12" FontWeight="Normal" SelectedValue="{Binding FormCategoryId, Mode=TwoWay}" SelectedValuePath="Id" DisplayMemberPath="Name" Width="210" ItemsSource="{Binding Categories}" Text="{Binding FormCategoryName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource LinkButton}" Content="＋新增" Command="{Binding OpenNewCategoryCommand}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Button Style="{StaticResource LinkButton}" Content="删除分类" Command="{Binding RequestDeleteCategoryCommand}" Foreground="#D64545" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,12" Visibility="{Binding IsCategoryAdd, Converter={StaticResource BoolToVis}}">
                        <TextBox Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" Height="32" Width="220" hc:InfoElement.Placeholder="输入分类名称，如 物业办" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="保存分类" Command="{Binding ConfirmNewCategoryCommand}" Margin="8,0,0,0" />
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelNewCategoryCommand}" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="类型" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,3">
                        <ComboBox IsEditable="True" FontSize="12" FontWeight="Normal" Width="210" SelectedValue="{Binding FormTypeId, Mode=TwoWay}" SelectedValuePath="Id" ItemsSource="{Binding TypeOptions}" DisplayMemberPath="Name" Text="{Binding FormTypeText, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ShowTypeSelector, Converter={StaticResource BoolToVis}}" />
                        <!-- BR-TEL-01：员工条目只来自同步，编辑时类型只读展示 -->
                        <TextBlock Text="员工通讯录（同步生成）" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="{Binding ShowEmployeeTypeHint, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource LinkButton}" Content="＋新增" Command="{Binding OpenNewTypeCommand}" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding ShowTypeButtons, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource LinkButton}" Content="删除类型" Command="{Binding RequestDeleteTypeCommand}" Foreground="#D64545" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="{Binding ShowTypeButtons, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,12" Visibility="{Binding IsTypeAdd, Converter={StaticResource BoolToVis}}">
                        <TextBox Text="{Binding NewTypeName, UpdateSourceTrigger=PropertyChanged}" Height="32" Width="220" hc:InfoElement.Placeholder="输入类型名称，如 消防" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="保存类型" Command="{Binding ConfirmNewTypeCommand}" Margin="8,0,0,0" />
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelNewTypeCommand}" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="名称" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,6,0,12" />
                    <TextBlock Text="电话号码" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,6,0,12" />
                    <TextBlock Text="备注" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <TextBox Text="{Binding FormNote, UpdateSourceTrigger=PropertyChanged}" Height="60" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,6,0,12" />
                    <CheckBox Content="置顶 ★" IsChecked="{Binding FormIsTop, Mode=TwoWay}" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelCommand}" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="保存" Command="{Binding SaveCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <!-- 删除分类 二次确认浮层 -->
        <Grid Grid.RowSpan="9" Visibility="{Binding IsCategoryDeleteVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="删除分类" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" />
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="13">
                        <Run Text="确认删除分类「" />
                        <Run Text="{Binding DeleteCategoryName, Mode=OneWay}" />
                        <Run Text="」？" />
                    </TextBlock>
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelDeleteCategoryCommand}" />
                        <Button Height="34" FontSize="13" Background="{StaticResource DangerSoftBrush}" Foreground="{StaticResource DangerBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Content="确认删除" Command="{Binding ConfirmDeleteCategoryCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 删除类型 二次确认浮层 -->
        <Grid Grid.RowSpan="9" Visibility="{Binding IsTypeDeleteVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="删除类型" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" />
                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="13">
                        <Run Text="确认删除类型「" />
                        <Run Text="{Binding DeleteTypeName, Mode=OneWay}" />
                        <Run Text="」？" />
                    </TextBlock>
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelDeleteTypeCommand}" />
                        <Button Height="34" FontSize="13" Background="{StaticResource DangerSoftBrush}" Foreground="{StaticResource DangerBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Content="确认删除" Command="{Binding ConfirmDeleteTypeCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

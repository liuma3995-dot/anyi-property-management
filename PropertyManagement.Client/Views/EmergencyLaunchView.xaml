<!-- 已下线（R4 变更）：应急发起页视图存档，未加入工程文件（不参与编译）。 -->
<UserControl x:Class="PropertyManagement.Client.Views.EmergencyLaunchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             FontFamily="微软雅黑">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <!-- 场景卡区（仅启用场景） -->
                <ItemsControl ItemsSource="{Binding Scenes}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="248" Padding="14,12" Margin="0,0,10,10" CornerRadius="10" BorderThickness="1" Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource PrimarySoftBrush}" VerticalAlignment="Center">
                                            <Path Data="{StaticResource Icon.Siren}" Style="{StaticResource IconStroke}"
                                                  Stroke="{StaticResource PrimaryBrush}" Width="18" Height="18" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Path Data="{StaticResource Icon.Check}" Style="{StaticResource IconStroke}"
                                              Stroke="{StaticResource PrimaryBrush}" Width="11" Height="11" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FootText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="5,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectSceneCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" />
                                </Border.InputBindings>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 发起面板：左 事件信息 / 右 自动匹配责任人 -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <!-- 事件信息 -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="{Binding FormTitle}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />
                            <TextBlock Text="事发地点" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox Text="{Binding LocationText, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,6,0,12" hc:InfoElement.Placeholder="如 1 栋 2 单元" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="详细位置" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBox Text="{Binding DetailLocation, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,6,0,0" hc:InfoElement.Placeholder="如 3 层楼梯间配电井旁" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="事发时间" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <hc:DateTimePicker SelectedDateTime="{Binding EventTime, Mode=TwoWay}" Height="32" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="情况描述" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" />
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="56" AcceptsReturn="True" TextWrapping="Wrap"
                                     Margin="0,6,0,0" VerticalContentAlignment="Top" hc:InfoElement.Placeholder="如 巡逻发现楼梯间有烟雾，疑似配电井过热，无明火。" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="事件级别" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <ComboBox SelectedIndex="{Binding LevelIndex, Mode=TwoWay}" Height="32" Margin="0,6,0,0">
                                        <ComboBoxItem Content="Ⅰ 级（重大）" /><ComboBoxItem Content="Ⅱ 级（较大）" /><ComboBoxItem Content="Ⅲ 级（一般）" />
                                    </ComboBox>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="10,6"
                                        VerticalAlignment="Bottom" Margin="12,6,0,0" HorizontalAlignment="Left">
                                    <TextBlock Text="自动按场景默认，可调" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
                            <Button Style="{StaticResource ButtonPrimary}" Content="一键发起应急事件" Command="{Binding LaunchCommand}"
                                    Height="44" FontSize="14" Margin="0,14,0,0" />
                            <TextBlock Text="发起后将：① 全员广播提醒 ② 推送主责/备选责任人 ③ 生成事件编号并开始计时"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap" />
                            <!-- 1 分钟内撤销（留痕） -->
                            <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="6" Padding="10,8" Margin="0,10,0,0"
                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource WarningBrush}"
                                               VerticalAlignment="Center" MaxWidth="330" TextWrapping="Wrap" />
                                    <Button Style="{StaticResource ButtonPrimary}" Content="{Binding CancelCountdownText}" Command="{Binding CancelEventCommand}"
                                            Height="30" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 自动匹配责任人 -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="自动匹配责任人" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="4" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="按角色+当日排班" FontSize="10" Foreground="{StaticResource PrimaryBrush}" />
                                </Border>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Matches}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{StaticResource PrimarySoftBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Initial}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayLine}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource ButtonSecondary}" Height="28" Padding="12,0" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.DialCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Icon.PhoneCall}" Style="{StaticResource IconStroke}"
                                                          Stroke="{StaticResource PrimaryBrush}" Width="12" Height="12" VerticalAlignment="Center" />
                                                    <TextBlock Text="拨打" FontSize="12" Margin="5,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- 无匹配占位（HasMatches=false 时显示） -->
                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="角色无人当班或暂无匹配：可先发起，随后在事件工作台人工指派（P-07 不阻塞发起）。">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMatches}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Path Data="{StaticResource Icon.PhoneCall}" Style="{StaticResource IconStroke}"
                                      Stroke="{StaticResource PrimaryBrush}" Width="13" Height="13" VerticalAlignment="Top" />
                                <TextBlock Text="拨打走系统话机并自动生成通话记录（时长/结果）写入事件" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="300" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource ButtonSecondary}" Content="拨打 119" Command="{Binding DialServiceCommand}" CommandParameter="119" Height="38" />
                                <Button Style="{StaticResource ButtonSecondary}" Content="拨打 110" Command="{Binding DialServiceCommand}" CommandParameter="110" Height="38" Margin="10,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 交互标注（原型行 214-219） -->
                <Border Style="{StaticResource CardBorder}" Padding="16,10" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Path Data="{StaticResource Icon.Check}" Style="{StaticResource IconStroke}"
                                  Stroke="{StaticResource PrimaryBrush}" Width="12" Height="12" VerticalAlignment="Center" />
                            <TextBlock Text="交互标注" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="· 【一键发起】→ 确认弹窗“确认发起火灾应急事件（Ⅱ 级）？”→ 广播 + 推送 + 计时 → 跳转 PG-EMG-03"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="· 角色无人当班 → 弹窗提示并允许手动指派；误发起可在 1 分钟内撤销（留痕）"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 一键发起确认弹窗 -->
        <Grid Visibility="{Binding IsConfirmVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="430" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="发起确认" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding ConfirmText}" FontSize="14" TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,14,0,10" />
                    <TextBlock Text="发起后将全员广播提醒、推送责任人并开始计时。" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonPrimary}" Content="确认发起" Command="{Binding ConfirmLaunchCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelConfirmCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

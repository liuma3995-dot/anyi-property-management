<UserControl x:Class="PropertyManagement.Client.Views.ArrearView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             FontFamily="微软雅黑">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="118" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 统计卡（4） ============ -->
        <UniformGrid Grid.Row="0" Columns="4">
            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="欠费总额" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding TotalText}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"
                               Foreground="{StaticResource DangerBrush}" />
                    <TextBlock Text="{Binding TotalSubText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="7,0">
                <StackPanel>
                    <TextBlock Text="账龄 1-30 天" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding Bucket1Text}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="待缴/未到期" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="7,0">
                <StackPanel>
                    <TextBlock Text="账龄 31-90 天" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding Bucket2Text}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"
                               Foreground="{StaticResource WarningBrush}" />
                    <TextBlock Text="应重点催缴" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="7,0,0,0">
                <StackPanel>
                    <TextBlock Text="账龄 >90 天" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding Bucket3Text}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"
                               Foreground="{StaticResource DangerBrush}" />
                    <TextBlock Text="{Binding Bucket3SubText}" FontSize="10" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ============ 工具栏 ============ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="34" Background="#F7F4EE" BorderBrush="{StaticResource BorderBrushColor}"
                        BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Style="{StaticResource IconStroke}"
                              Stroke="{StaticResource TextMutedBrush}" Width="14" Height="14" Margin="10,0,0,0"
                              VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Style="{StaticResource SearchTextBox}"
                                 Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                                 hc:InfoElement.Placeholder="搜索房号/业主" Margin="8,0,0,0"
                                 KeyDown="KeywordBox_KeyDown" />
                    </Grid>
                </Border>
                <TextBlock Grid.Column="1" Text="楼栋" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="14,0,8,0" />
                <ComboBox Grid.Column="2" Height="32" FontSize="12" VerticalContentAlignment="Center"
                          ItemsSource="{Binding Buildings}" SelectedIndex="{Binding BuildingFilter}" />
                <TextBlock Grid.Column="3" Text="账龄" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="14,0,8,0" />
                <ComboBox Grid.Column="4" Height="32" FontSize="12" VerticalContentAlignment="Center"
                          SelectedIndex="{Binding AgingFilter}">
                    <ComboBoxItem Content="全部" />
                    <ComboBoxItem Content="1-30 天" />
                    <ComboBoxItem Content="31-90 天" />
                    <ComboBoxItem Content=">90 天" />
                </ComboBox>
                <TextBlock Grid.Column="5" Text="催缴状态" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="14,0,8,0" />
                <ComboBox Grid.Column="6" Height="32" FontSize="12" VerticalContentAlignment="Center"
                          SelectedIndex="{Binding RemindStateFilter}">
                    <ComboBoxItem Content="全部" />
                    <ComboBoxItem Content="待催缴" />
                    <ComboBoxItem Content="已催缴" />
                    <ComboBoxItem Content="免催缴" />
                </ComboBox>
                <Button Grid.Column="8" Style="{StaticResource LinkButton}" Content="批量催缴" FontSize="13"
                        VerticalAlignment="Center" Click="BatchRemindButton_Click" Margin="0,0,14,0" />
                <Button Grid.Column="9" Style="{StaticResource LinkButton}" Content="导出台账" FontSize="13"
                        VerticalAlignment="Center" Click="ExportButton_Click" />
                <!-- CHG-v1.1.2-03：已移出台账记录（可恢复）；台账「删除」语义已改为「移出台账」 -->
                <Button Grid.Column="10" Style="{StaticResource LinkButton}" Content="已移出记录" FontSize="13"
                        VerticalAlignment="Center" Command="{Binding OpenDismissedCommand}" Margin="14,0,0,0" />
                <Button Grid.Column="11" Height="32" FontSize="13" Background="{StaticResource SurfaceBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrushColor}"
                        BorderThickness="1" Content="批量移出" Command="{Binding BatchDeleteCommand}"
                        VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <!-- ============ 台账表格 ============ -->
        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid ItemsSource="{Binding Items}" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding DataContext.IsSelectAll, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Mode=TwoWay}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="全选" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="RowCheckBox_Click" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- CHG-v1.1.0-12：列头由「房产」改为「缴费对象」（含房产/车位/业主直缴，显示口径见 PropertyNo） -->
                    <DataGridTextColumn Header="缴费对象" Width="110" Binding="{Binding PropertyNo}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="业主" Width="100" Binding="{Binding OwnerName}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="欠费项目" Width="*" Binding="{Binding ChargeItemName}" ElementStyle="{StaticResource GridCellText}" />
                    <!-- CHG-v1.1.2-54：欠费期间改引用账单真实账期；同年账期压缩显示，悬停给完整起止 -->
                    <DataGridTemplateColumn Header="欠费期间" Width="152">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PeriodText}" Style="{StaticResource GridCellText}"
                                           ToolTip="{Binding PeriodFullText}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="欠费金额" Width="110" Binding="{Binding AmountText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="最早欠期" Width="100" Binding="{Binding EarliestDueText}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTemplateColumn Header="账龄" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding AgingBg}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding AgingText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding AgingBrush}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="催缴状态" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding RemindBg}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding RemindText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding RemindBrush}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="操作" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource LinkButton}" Content="催缴"
                                            Visibility="{Binding CanRemind, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.RemindCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource LinkButton}" Content="上门"
                                            Visibility="{Binding CanVisit, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.VisitCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource LinkButton}" Content="法务"
                                            Visibility="{Binding CanLegal, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.LegalCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource LinkButton}" Content="备注"
                                            Visibility="{Binding CanNote, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.NoteCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" />
                                    <Button Style="{StaticResource LinkButton}" Content="收款"
                                            Visibility="{Binding CanCollect, Converter={StaticResource BoolToVis}}"
                                            Click="CollectButton_Click" />
                                    <!-- CHG-v1.1.2-03：「删除」改为「移出台账」——只影响台账显示，不再删账单 -->
                                    <Button Style="{StaticResource LinkButton}" Content="移出台账" Foreground="{StaticResource DangerBrush}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ============ 状态/错误条 ============ -->
        <!-- CHG-v1.1.2-11：状态/错误条改为可换行容器，长提示不再被右侧裁切 -->
        <StackPanel Grid.Row="6">
            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorText}" FontSize="11" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ============ 催缴弹层 ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="7" Visibility="{Binding IsRemindVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="催缴登记" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding RemindTargetText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,6,0,18" TextWrapping="Wrap" />

                    <TextBlock Text="催缴渠道" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <ComboBox Height="34" Margin="0,8,0,14" FontSize="12" VerticalContentAlignment="Center"
                              SelectedIndex="{Binding RemindChannel}">
                        <ComboBoxItem Content="短信" />
                        <ComboBoxItem Content="电话" />
                        <ComboBoxItem Content="函件" />
                        <ComboBoxItem Content="上门" />
                        <ComboBoxItem Content="微信" />
                        <ComboBoxItem Content="法务" />
                        <ComboBoxItem Content="免催缴" />
                    </ComboBox>

                    <TextBlock Text="备注" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <Border Height="64" Margin="0,8,0,20" Background="#F7F4EE" BorderBrush="{StaticResource BorderBrushColor}"
                            BorderThickness="1" CornerRadius="6">
                        <TextBox Style="{StaticResource SearchTextBox}" Height="64" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10,8"
                                 Text="{Binding RemindNote, UpdateSourceTrigger=PropertyChanged}"
                                 hc:InfoElement.Placeholder="催缴记录留痕（如已电话通知业主）" />
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonPrimary}" Content="确认催缴"
                                Command="{Binding SubmitRemindCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="取消" FontSize="13"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding CloseRemindCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 移出台账确认弹层（CHG-v1.1.2-03） ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="7" Visibility="{Binding IsConfirmVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="确认移出台账" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="确认将欠费记录移出台账：" /><Run Text="{Binding ConfirmRow.PropertyNo, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ConfirmRow.OwnerName, Mode=OneWay}" /><Run Text=" · 欠费金额 " /><Run Text="{Binding ConfirmRow.AmountText, Mode=OneWay}" /><Run Text="？" />
                    </TextBlock>
                    <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Text="仅从欠费台账移除：账单、收款登记、退款记录、财务报表与收支流水均不受影响，可随时恢复。" />
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonPrimary}" Content="确认移出" Command="{Binding ConfirmDeleteCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelDeleteCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 批量移出台账确认 -->
        <Grid Grid.Row="0" Grid.RowSpan="7" Visibility="{Binding IsBatchConfirmVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="确认批量移出台账" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding BatchConfirmMessage}" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonPrimary}" Content="确认移出" Command="{Binding ConfirmBatchDeleteCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelBatchDeleteCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 已移出台账记录（CHG-v1.1.2-03：可恢复） ============ -->
        <Grid Grid.Row="0" Grid.RowSpan="7" Visibility="{Binding IsDismissedVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="760" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource CardBorder}" Padding="24,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="已移出台账的记录" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Grid.Row="1" Margin="0,8,0,12" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="这些账单仍然存在（账单工作台、收款登记、退款记录、财务报表、收支流水一切照旧），只是不再出现在欠费台账列表。点「恢复台账」即可放回。" />
                    <DataGrid Grid.Row="2" ItemsSource="{Binding DismissedItems}" IsReadOnly="True" MinHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="房号" Width="90" Binding="{Binding PropertyText}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="业主" Width="90" Binding="{Binding OwnerText}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="收费项目" Width="120" Binding="{Binding ChargeItemText}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="欠费金额" Width="100" Binding="{Binding AmountText}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="移出时间" Width="130" Binding="{Binding CreatedText}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="操作人" Width="90" Binding="{Binding OperatorText}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTemplateColumn Header="操作" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource LinkButton}" Content="恢复台账"
                                                Command="{Binding DataContext.RestoreDismissedCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="3" Style="{StaticResource ButtonSecondary}" Content="关闭" HorizontalAlignment="Right"
                            Margin="0,16,0,0" Command="{Binding CloseDismissedCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

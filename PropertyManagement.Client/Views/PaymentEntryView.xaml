<UserControl x:Class="PropertyManagement.Client.Views.PaymentEntryView"
             Loaded="Root_Loaded"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:controls="clr-namespace:PropertyManagement.Client.Assets.Controls"
             FontFamily="微软雅黑">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- CHG-v1.1.0-24：账单期间紧凑显示 + 悬停查看完整期间（应缴明细列宽有限，原日期被裁切） -->
        <Style x:Key="GridCellTextWithTip" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
            <Setter Property="ToolTip" Value="{Binding CyclePeriodFull}" />
        </Style>
        <!-- CHG-v1.1.2-16：应缴明细表头基样式（供 DataGrid 与勾选列表头共用）——
             勾选列单独设置 HeaderStyle 时会脱离 DataGrid.ColumnHeaderStyle，
             若不带 BasedOn 会丢掉表头底色/分隔线，出现「全选框背景被调色」的观感差异 -->
        <Style x:Key="BillHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FAF8F4" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="#FAFBFD" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowHeight" Value="44" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <StaticResource ResourceKey="BillHeaderStyle" />
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridRow">
                                    <Border x:Name="RowBg" Background="{TemplateBinding Background}">
                                        <DataGridCellsPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowBg" Property="Background" Value="#F2F7FE" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="RowBg" Property="Background" Value="#E7EBF0" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}" VerticalAlignment="Center">
                                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 主体：左表单 430 + 右侧明细/收据（PG-FIN-03 / iSnhQ） ============ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：收款登记表单 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="20,16">
                <!-- CHG-v1.1.0-13：内容区可滚动 + 底部按钮行固定，修复「确认收款」被内容顶出可视区（被遮挡） -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="收款登记" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />

                    <!-- CHG-v1.1.0-12：缴费对象（房产/车位/业主），下拉格式「姓名 → 楼栋 → 房号 → 欠费 N 笔」 -->
                    <TextBlock Text="缴费对象" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,14,0,4" />
                    <Border Height="34" Background="#F7F4EE" BorderBrush="{StaticResource BorderBrushColor}"
                            BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Style="{StaticResource IconStroke}"
                                  Stroke="{StaticResource TextMutedBrush}" Width="14" Height="14" Margin="10,0,0,0"
                                  VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Style="{StaticResource SearchTextBox}"
                                     Text="{Binding PropertySearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     hc:InfoElement.Placeholder="快捷搜索：姓名 / 楼栋 / 单元 / 房号 / 车位编号（如 张伟、101、B1-001）"
                                     Margin="8,0,0,0" />
                        </Grid>
                    </Border>
                    <!-- CHG-v1.2.0-33：缴费对象文案改为「姓名 · 楼栋/单元/房号 · 欠费 N 笔」，
                         更长 → 补悬停提示，避免左面板宽度不足时看不出完整缴费对象 -->
                    <ComboBox x:Name="PaymentObjectCombo" Height="34" FontSize="12" VerticalContentAlignment="Center"
                              ItemsSource="{Binding Properties}" SelectedItem="{Binding SelectedProperty}"
                              DisplayMemberPath="DisplayText"
                              ToolTip="{Binding SelectedProperty.DisplayText}" />

                    <!-- 三合计（应收/已收/未收） -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="应收合计" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding ReceivableTotalText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="已收合计" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding PaidTotalText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="未收合计" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding UnpaidTotalText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- 本次收款金额（主色输入区，对齐原型） -->
                    <TextBlock Text="本次收款金额（元）" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,14,0,6" />
                    <Border Height="40" Background="{StaticResource PrimarySoftBrush}" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="¥" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}" Margin="14,0,0,0"
                                       VerticalAlignment="Center" />
                            <!-- CHG-v1.1.2-08：改用 DecimalTextBox —— 输入 12.12 不再被格式化成 12.12.00 -->
                            <controls:DecimalTextBox Grid.Column="1" Style="{StaticResource SearchTextBox}"
                                     FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                                     Value="{Binding PayAmount, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="6,0,14,0" />
                        </Grid>
                    </Border>
                    <!-- CHG-v1.1.0-12：金额口径提示（单张可改 / 多张按勾选合计锁定） -->
                    <TextBlock Text="{Binding PayAmountHintText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="2,4,0,0" />
                    <!-- CHG-v1.1.2-51：原「多缴自动转入预存账户」提示已下线，此处改为「收款金额超限」止付提示 -->
                    <TextBlock Text="{Binding AmountWarnText}" FontSize="10" Foreground="#B76E00"
                               TextWrapping="Wrap" Margin="2,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AmountWarnText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 收款方式（CHG-v1.1.0-15：收据号字段前后端下线，本行只保留收款方式） -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="收款方式" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                            <ComboBox Height="34" FontSize="12" VerticalContentAlignment="Center"
                                      SelectedIndex="{Binding PayMethod}">
                                <ComboBoxItem Content="现金" />
                                <ComboBoxItem Content="转账" />
                                <ComboBoxItem Content="微信" />
                                <ComboBoxItem Content="银行转账" />
                                <ComboBoxItem Content="POS" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- 经手人 + 收款日期 -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="经手人" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                            <!-- CHG-v1.1.0-13：经手人改为可自行填写，留空时回落为当前管理员名称 -->
                            <Border Height="34" Background="#F7F4EE" BorderBrush="{StaticResource BorderBrushColor}"
                                    BorderThickness="1" CornerRadius="6">
                                <TextBox Style="{StaticResource SearchTextBox}" FontSize="12" Margin="8,0"
                                         Text="{Binding HandlerName, UpdateSourceTrigger=PropertyChanged}"
                                         hc:InfoElement.Placeholder="{Binding HandlerPlaceholderText}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="收款日期" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                            <DatePicker Height="34" FontSize="12" VerticalContentAlignment="Center"
                                        SelectedDate="{Binding PayDate}" />
                        </StackPanel>
                    </Grid>

                    <!-- 备注（T4R-3：可输入并随收款落库） -->
                    <TextBlock Text="备注" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,14,0,6" />
                    <Border Height="76" Background="#F7F4EE" BorderBrush="{StaticResource BorderBrushColor}"
                            BorderThickness="1" CornerRadius="8">
                        <TextBox Style="{StaticResource SearchTextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" FontSize="11"
                                 Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                                 hc:InfoElement.Placeholder="可填写本次收款备注（可选，如：代收、季度优惠说明）" />
                    </Border>
                </StackPanel>
                    </ScrollViewer>

                    <!-- 按钮组：确认收款 + 导出打印收据预览模板 -->
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonPrimary}" Content="确认收款"
                                Command="{Binding ConfirmCommand}" Height="34" />
                        <!-- CHG-v1.1.0-14：「打印收据」改为「导出打印收据预览模板」（收据号已下线，模板含逐项收款明细） -->
                        <Button Grid.Column="2" Height="34" FontSize="12" Content="导出打印收据预览模板"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Command="{Binding ExportReceiptTemplateCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanExportTemplate}" Value="False">
                                            <Setter Property="Foreground" Value="#B9C2CF" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- 右：应缴明细 + 收据预览（PG-FIN-03 / iSnhQ） -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- CHG-v1.1.0-12：标题只保留「应缴明细」，去掉括号与括号内内容 -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding BillsTitleText}" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding CheckedBillsText}" FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource PrimaryBrush}" />
                </Grid>

                <!-- CHG-v1.2.0-31/-32：应缴明细「记录管理」工具栏 —— 清理已结清记录（归档）+ 清理前导出归档件 -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding SettledBillCount, StringFormat=已结清记录 {0} 条（清理只从本列表移除，账务记录保留）}" />
                    <Button Grid.Column="2" Height="34" FontSize="12" Content="导出应缴明细 PDF"
                            VerticalAlignment="Center" Command="{Binding ExportArrearDetailsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="4" Height="34" FontSize="12" Content="批量删除已结清"
                            VerticalAlignment="Center" Command="{Binding RequestArchiveSettledCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanArchiveSettled}" Value="False">
                                        <Setter Property="Foreground" Value="#B9C2CF" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- 应缴明细表 -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
                    <!-- CHG-v1.1.0-24：列宽受 MinWidth 约束，窗口较窄时改为横向滚动（而非压缩列导致日期/金额被裁切） -->
                    <!-- CHG-v1.1.2-15：勾选列冻结（FrozenColumnCount=1）—— 应缴明细列宽超出副面板时会出现横向滚动，
                         原实现下滚动后「全选框」与行勾选框会被滚出可视区（负责人反馈的遮挡）；冻结后始终可见 -->
                    <DataGrid Style="{StaticResource GridStyle}" ItemsSource="{Binding Bills}" IsReadOnly="True"
                              FrozenColumnCount="1"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectionChanged="BillsGrid_SelectionChanged"
                              SelectedItem="{Binding SelectedBill}" RowHeight="34">
                        <DataGrid.Columns>
                            <!-- CHG-v1.1.0-14 / CHG-v1.1.2-09：勾选列改用已验证的 GridCheckCell + GridCheckBox
                                 （与「备份与恢复」「审计日志」同一套写法）；表头去掉内边距并居中，勾选框不再贴边 -->
                            <DataGridTemplateColumn Width="60" MinWidth="60" CellStyle="{StaticResource GridCheckCell}">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <!-- CHG-v1.1.2-16：BasedOn 表头基样式，保持与其它表头同底色/同分隔线 -->
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource BillHeaderStyle}">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding DataContext.IsSelectAllBills, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Mode=TwoWay}"
                                                  Style="{StaticResource GridCheckBox}" ToolTip="全选 / 取消全选" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}" Click="BillCheckBox_Click"
                                                  Style="{StaticResource GridCheckBox}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="账单号" Width="96" MinWidth="96" Binding="{Binding NoText}" ElementStyle="{StaticResource GridCellText}" />
                            <!-- CHG-v1.1.0-13：按业主聚合后，逐行标明欠费所属缴费对象（房/车位/业主直缴） -->
                            <!-- CHG-v1.1.0-24：缴费对象列 120→96（值约 4-6 字，96px 含 24px 内边距仍可完整显示），
                                 腾出的宽度补给「账单期间」与金额列，消除同表多列日期/金额被裁切 -->
                            <!-- CHG-v1.2.0-33：逐行缴费对象补出「单元」后文案更长 → 加宽至 118 并补悬停提示（完整值始终可查） -->
                            <DataGridTextColumn Header="缴费对象" Width="118" MinWidth="118" Binding="{Binding ObjectText}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                        <Setter Property="ToolTip" Value="{Binding ObjectText}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- CHG-v1.1.0-24：收费项目列设置最小宽度，避免列总宽超出面板时被压成 0（1366 窗口下横向滚动优于内容不可见） -->
                            <!-- CHG-v1.2.0-33：弹性列补悬停提示（长项目名在窄面板下仍可查看完整值） -->
                            <DataGridTextColumn Header="收费项目" Width="*" MinWidth="110" Binding="{Binding Dto.ChargeItemName}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
                                        <Setter Property="ToolTip" Value="{Binding Dto.ChargeItemName}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <!-- CHG-v1.1.0-24：账单期间紧凑显示 + 加宽至 148px（原 92px 减 24px 内边距后不足以显示完整期间，实测紧凑文本渲染 116px） -->
                            <!-- CHG-v1.2.0-33：缴费对象列补单元需 +22px，从本列回收 8px（同口径实测仍可完整显示
                                 「2026-01-01~12-31」紧凑文本与跨年账期 116px），保证 1366 下无横向滚动 -->
                            <DataGridTextColumn Header="账单期间" Width="140" MinWidth="140" Binding="{Binding CyclePeriodText}"
                                                ElementStyle="{StaticResource GridCellTextWithTip}" />
                            <DataGridTextColumn Header="应收" Width="86" MinWidth="86" Binding="{Binding Dto.Amount, StringFormat=¥{0:N2}}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="已收" Width="86" MinWidth="86" Binding="{Binding Dto.PaidAmount, StringFormat=¥{0:N2}}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="未收" Width="86" MinWidth="86" Binding="{Binding UnpaidAmount, StringFormat=¥{0:N2}}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTemplateColumn Header="状态" Width="70" MinWidth="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBg}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{Binding StatusBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- 收款收据（打印预览，套打模板 HP-58） -->
                <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="18,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="收据打印模板（预览）" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="#EEF2F7" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="套打模板 HP-58" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- CHG-v1.1.0-14：收据号下线，模板以「缴款人 / 收款方式 / 收款流水号」为口径 -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="缴款人" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ReceiptPayeeText}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="收款方式" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ReceiptMethodText}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="收款流水号" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding BatchNoText, TargetNullValue=—}" FontSize="11" Foreground="{StaticResource PrimaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="经手人" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ReceiptHandlerText}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="项目" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ReceiptItemText}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="收款单位" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ReceiptUnitText}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="金额（大写）" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ReceiptAmountCapitalText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="金额（小写）" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ReceiptAmountLowerText}" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- CHG-v1.1.0-14：收据号与打印次数随「打印收据」一并下线（改为导出打印模板） -->
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ 状态/错误条 ============ -->
        <!-- CHG-v1.1.2-11：状态/错误条改为可换行容器，长提示不再被右侧裁切 -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorText}" FontSize="11" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ============ 确认收款弹窗 ============ -->
        <Grid Grid.RowSpan="3" Background="#66000000" Visibility="{Binding IsConfirmVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="400" Style="{StaticResource CardBorder}" Padding="24,20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="确认收款" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ConfirmText}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,18,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonPrimary}" Content="确认入账"
                                Command="{Binding ConfirmPaymentCommand}" />
                        <Button Grid.Column="2" Content="取消" Command="{Binding CancelConfirmCommand}"
                                FontSize="13" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 清理已结清记录（归档）确认弹窗（CHG-v1.2.0-31） ============ -->
        <Grid Grid.RowSpan="3" Background="#66000000" Visibility="{Binding IsArchiveConfirmVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="460" Style="{StaticResource CardBorder}" Padding="24,20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="清理已结清记录" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ArchiveConfirmText}" FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,16,0,0"
                               HorizontalAlignment="Left" TextWrapping="Wrap" LineHeight="19" />
                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonPrimary}"
                                Content="确认清理" Command="{Binding ConfirmArchiveSettledCommand}" />
                        <Button Grid.Column="2" Content="取消" Command="{Binding CancelArchiveSettledCommand}"
                                FontSize="13" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

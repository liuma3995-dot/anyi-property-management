<UserControl x:Class="PropertyManagement.Client.Views.PaymentEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             FontFamily="微软雅黑">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="#FAFBFD" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowHeight" Value="44" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FAF8F4" />
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Height" Value="36" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridRow">
                                    <Border x:Name="RowBg" Background="{TemplateBinding Background}">
                                        <DataGridCellsPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowBg" Property="Background" Value="#F2F7FE" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="RowBg" Property="Background" Value="#E7EBF0" />
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}" VerticalAlignment="Center">
                                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{StaticResource TextPrimaryBrush}" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 主体：左表单 430 + 右侧明细/收据（PG-FIN-03 / iSnhQ） ============ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：收款登记表单 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="收款登记" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />

                    <TextBlock Text="缴费房产" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,14,0,4" />
                    <Border Height="34" Background="#F7F4EE" BorderBrush="{StaticResource BorderBrushColor}"
                            BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Style="{StaticResource IconStroke}"
                                  Stroke="{StaticResource TextMutedBrush}" Width="14" Height="14" Margin="10,0,0,0"
                                  VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Style="{StaticResource SearchTextBox}"
                                     Text="{Binding PropertySearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     hc:InfoElement.Placeholder="快捷搜索：房号 / 业主名（如 101 或 张三）"
                                     Margin="8,0,0,0" />
                        </Grid>
                    </Border>
                    <ComboBox Height="34" FontSize="12" VerticalContentAlignment="Center"
                              ItemsSource="{Binding Properties}" SelectedItem="{Binding SelectedProperty}"
                              DisplayMemberPath="DisplayText" />

                    <!-- 三合计（应收/已收/未收） -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="应收合计" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding ReceivableTotalText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="已收合计" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding PaidTotalText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="未收合计" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding UnpaidTotalText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- 本次收款金额（主色输入区，对齐原型） -->
                    <TextBlock Text="本次收款金额（元）" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,14,0,6" />
                    <Border Height="40" Background="{StaticResource PrimarySoftBrush}" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="¥" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}" Margin="14,0,0,0"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Style="{StaticResource SearchTextBox}"
                                     FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                                     Text="{Binding PayAmount, StringFormat={}{0:0.00}, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="6,0,14,0" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding PreDepositHintText}" FontSize="10" Foreground="#B76E00"
                               TextWrapping="Wrap" Margin="2,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PreDepositHintText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 收款方式 + 收据号 -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="收款方式" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                            <ComboBox Height="34" FontSize="12" VerticalContentAlignment="Center"
                                      SelectedIndex="{Binding PayMethod}">
                                <ComboBoxItem Content="现金" />
                                <ComboBoxItem Content="转账" />
                                <ComboBoxItem Content="微信" />
                                <ComboBoxItem Content="银行转账" />
                                <ComboBoxItem Content="POS" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="收据号" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                            <Border Height="34" Background="#F7F4EE" BorderBrush="{StaticResource BorderBrushColor}"
                                    BorderThickness="1" CornerRadius="6">
                                <TextBlock Text="{Binding ReceiptNo}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="10,0" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 经手人 + 收款日期 -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="经手人" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                            <Border Height="34" Background="#F7F4EE" BorderBrush="{StaticResource BorderBrushColor}"
                                    BorderThickness="1" CornerRadius="6">
                                <TextBlock Text="{Binding ReceiptHandlerText}" FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="10,0" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="收款日期" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" />
                            <DatePicker Height="34" FontSize="12" VerticalContentAlignment="Center"
                                        SelectedDate="{Binding PayDate}" />
                        </StackPanel>
                    </Grid>

                    <!-- 备注（T4R-3：可输入并随收款落库） -->
                    <TextBlock Text="备注" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,14,0,6" />
                    <Border Height="76" Background="#F7F4EE" BorderBrush="{StaticResource BorderBrushColor}"
                            BorderThickness="1" CornerRadius="8">
                        <TextBox Style="{StaticResource SearchTextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" FontSize="11"
                                 Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                                 hc:InfoElement.Placeholder="可填写本次收款备注（可选，如：代收、季度优惠说明）" />
                    </Border>

                    <!-- 按钮组：确认收款 + 打印收据 -->
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonPrimary}" Content="确认收款"
                                Command="{Binding ConfirmCommand}" Height="34" />
                        <Button Grid.Column="2" Height="34" FontSize="12" Content="打印收据"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Command="{Binding PrintCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasReceipt}" Value="False">
                                            <Setter Property="Foreground" Value="#B9C2CF" />
                                            <Setter Property="Cursor" Value="Arrow" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 右：应缴明细 + 收据预览（PG-FIN-03 / iSnhQ） -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding BillsTitleText}" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />

                <!-- 应缴明细表 -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
                    <DataGrid Style="{StaticResource GridStyle}" ItemsSource="{Binding Bills}" IsReadOnly="True"
                              SelectedItem="{Binding SelectedBill}" RowHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="账单号" Width="96" Binding="{Binding NoText}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="收费项目" Width="*" Binding="{Binding Dto.ChargeItemName}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="账单期间" Width="92" Binding="{Binding Dto.CyclePeriod}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="应收" Width="78" Binding="{Binding Dto.Amount, StringFormat=¥{0:N2}}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="已收" Width="78" Binding="{Binding Dto.PaidAmount, StringFormat=¥{0:N2}}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="未收" Width="78" Binding="{Binding UnpaidAmount, StringFormat=¥{0:N2}}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTemplateColumn Header="状态" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBg}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{Binding StatusBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- 收款收据（打印预览，套打模板 HP-58） -->
                <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="18,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="收款收据（打印预览）" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="#EEF2F7" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="套打模板 HP-58" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="收据编号" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ReceiptNo}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="缴款人" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ReceiptPayeeText}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="收款方式" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ReceiptMethodText}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="项目" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ReceiptItemText}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="收款单位" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ReceiptUnitText}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="经手人" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ReceiptHandlerText}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="金额（大写）" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ReceiptAmountCapitalText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="金额（小写）" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ReceiptAmountLowerText}" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Rectangle Height="1" Fill="{StaticResource BorderBrushColor}" Margin="0,12,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="本收据为电子打印凭证，与原始缴费记录一致（BR-FIN-08 补打保留原号）"
                                       FontSize="9" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{Binding PrintCountText}" FontSize="9"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,0" VerticalAlignment="Bottom" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ 状态/错误条 ============ -->
        <TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource SuccessBrush}" />
        <TextBlock Grid.Row="2" Text="{Binding ErrorText}" FontSize="11" Foreground="{StaticResource DangerBrush}" />

        <!-- ============ 确认收款弹窗 ============ -->
        <Grid Grid.RowSpan="3" Background="#66000000" Visibility="{Binding IsConfirmVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="400" Style="{StaticResource CardBorder}" Padding="24,20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="确认收款" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ConfirmText}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,18,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" />
                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonPrimary}" Content="确认入账"
                                Command="{Binding ConfirmPaymentCommand}" />
                        <Button Grid.Column="2" Content="取消" Command="{Binding CancelConfirmCommand}"
                                FontSize="13" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
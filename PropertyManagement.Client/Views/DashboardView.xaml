<UserControl x:Class="PropertyManagement.Client.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PropertyManagement.Client.ViewModels"
             FontFamily="微软雅黑">
    <UserControl.Resources>
        <vm:IconKeyConverter x:Key="IconConv" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="QuickCardButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#BBD4F5" />
                                <Setter TargetName="Bg" Property="Background" Value="#FBFDFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- R17：待办行可点击（仅提供透明的可点击容器，行内视觉沿用原 Border 布局） -->
        <Style x:Key="TodoRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- CHG-v1.2.0-21：月份下拉里的「月份格」（选中态高亮 = 当前统计口径月份） -->
        <Style x:Key="MonthCellButton" TargetType="Button">
            <Setter Property="Background" Value="#F7F4EE" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 月份格文字：选中态反白（与 PrimaryBrush 底色配套） -->
        <Style x:Key="MonthCellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- CHG-v1.2.0-26：「全年」格（年度口径）—— 高亮绑 IsAnnualPeriod（弹层 DataContext 为仪表盘 VM） -->
        <Style x:Key="AnnualCellButton" TargetType="Button">
            <Setter Property="Background" Value="#F7F4EE" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsAnnualPeriod}" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AnnualCellText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAnnualPeriod}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="14" />
            <RowDefinition Height="100" />
            <RowDefinition Height="14" />
            <RowDefinition Height="72" />
            <RowDefinition Height="14" />
            <RowDefinition Height="78" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ 仪表盘欢迎区 h54 ============ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding WelcomeTitle}" FontSize="21" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding WelcomeDate}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <!-- R17：月份选择器（可交互下拉，切换统计口径月份） -->
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <Button x:Name="MonthPickerButton" Command="{Binding ToggleMonthPickerCommand}"
                        AutomationProperties.Name="统计周期（月 / 年）"
                        ToolTip="切换统计周期：可选月份，也可选「全年」按年度统计"
                        Height="34" Padding="12,0" Cursor="Hand"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.CalendarDays}" Style="{StaticResource IconStroke}"
                              Stroke="{StaticResource TextSecondaryBrush}"
                              Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding MonthText}" FontSize="11"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                        <Path Data="{StaticResource Icon.ChevronDown}" Style="{StaticResource IconStroke}"
                              Stroke="{StaticResource TextMutedBrush}"
                              Width="14" Height="14" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Popup IsOpen="{Binding IsMonthPickerOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=MonthPickerButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="White" BorderBrush="{StaticResource BorderBrushColor}"
                            BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,6,0,0">
                        <!-- CHG-v1.2.0-21：月份下拉支持「选年份」—— 顶部 < 年份 > 翻年 + 12 个月份格 -->
                        <StackPanel Width="234">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding ShiftPickerYearCommand}" CommandParameter="-1"
                                        AutomationProperties.Name="上一年" Width="26" Height="26" Cursor="Hand"
                                        Background="#F7F4EE">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <Path Data="{StaticResource Icon.ChevronRight}" Style="{StaticResource IconStroke}"
                                                      Stroke="{StaticResource TextSecondaryBrush}" Width="14" Height="14"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <ScaleTransform ScaleX="-1" ScaleY="1" />
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Grid.Column="1" Text="{Binding PickerYearText}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Command="{Binding ShiftPickerYearCommand}" CommandParameter="1"
                                        AutomationProperties.Name="下一年" Width="26" Height="26" Cursor="Hand"
                                        IsEnabled="{Binding CanPickNextYear}" Background="#F7F4EE">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <Path Data="{StaticResource Icon.ChevronRight}" Style="{StaticResource IconStroke}"
                                                      Stroke="{StaticResource TextSecondaryBrush}" Width="14" Height="14" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- CHG-v1.2.0-26：全年（年度口径）—— 统计年度应收/已收/收缴率 -->
                            <Button Height="30" Margin="3,9,3,0" Cursor="Hand"
                                    Style="{StaticResource AnnualCellButton}"
                                    AutomationProperties.Name="全年"
                                    Command="{Binding SelectAnnualCommand}">
                                <TextBlock Text="全年（按年统计）" Style="{StaticResource AnnualCellText}" />
                            </Button>

                            <ItemsControl ItemsSource="{Binding Months}" Margin="0,9,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MonthCellButton}" Margin="3" Height="30"
                                                Command="{Binding DataContext.SelectMonthCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                AutomationProperties.Name="{Binding Period}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding Text}" Style="{StaticResource MonthCellText}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="回到本月" FontSize="11" Margin="3,9,3,0" Height="26" Cursor="Hand"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Command="{Binding BackToCurrentMonthCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#F2F7F5" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Grid>

        <!-- ============ 财务指标行 h100（4卡） ============ -->
        <UniformGrid Grid.Row="2" Columns="4">
            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,7,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" Background="{StaticResource PrimarySoftBrush}" CornerRadius="10">
                        <Path Data="{StaticResource Icon.ReceiptText}" Style="{StaticResource IconStroke}"
                              Stroke="{StaticResource PrimaryBrush}" Width="20" Height="20" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ReceivableLabelText}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding MonthReceivableText}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding ReceivableTrend}" FontSize="9"
                                   Foreground="{StaticResource SuccessBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="7,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" Background="{StaticResource SuccessSoftBrush}" CornerRadius="10">
                        <Path Data="{StaticResource Icon.BadgeCheck}" Style="{StaticResource IconStroke}"
                              Stroke="{StaticResource SuccessBrush}" Width="20" Height="20" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ReceivedLabelText}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding MonthReceivedText}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding ReceivedTrend}" FontSize="9"
                                   Foreground="{StaticResource SuccessBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="7,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" Background="{StaticResource DangerSoftBrush}" CornerRadius="10">
                        <Path Data="{StaticResource Icon.CircleDollarSign}" Style="{StaticResource IconStroke}"
                              Stroke="{StaticResource DangerBrush}" Width="20" Height="20" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="待收欠费" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                   ToolTip="欠费余额为实时口径，不随统计周期（月 / 年）切换" />
                        <TextBlock Text="{Binding ArrearAmountText}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding ArrearTrend}" FontSize="9"
                                   Foreground="{StaticResource DangerBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="16,14" Margin="7,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" Background="{StaticResource WarningSoftBrush}" CornerRadius="10">
                        <Path Data="{StaticResource Icon.ClockAlert}" Style="{StaticResource IconStroke}"
                              Stroke="{StaticResource WarningBrush}" Width="20" Height="20" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="逾期户数" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                   ToolTip="逾期户数为实时口径，不随统计周期（月 / 年）切换（环比按所选周期计算）" />
                        <TextBlock Text="{Binding OverdueCountText}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding OverdueTrend}" FontSize="9"
                                   Foreground="{StaticResource SuccessBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- ============ 运营指标行 h72（4卡） ============ -->
        <UniformGrid Grid.Row="4" Columns="4">
            <Border Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,0,7,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" Background="{StaticResource DangerSoftBrush}" CornerRadius="9">
                        <Path Data="{StaticResource Icon.Siren}" Style="{StaticResource IconStroke}"
                              Stroke="{StaticResource DangerBrush}" Width="18" Height="18" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="应急处理中" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding HandlingEmergency}" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="起" FontSize="9" Foreground="{StaticResource TextMutedBrush}"
                                       Margin="5,0,0,3" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </StackPanel>
                    <Path Grid.Column="2" Data="{StaticResource Icon.ChevronRight}" Style="{StaticResource IconStroke}"
                          Stroke="{StaticResource TextMutedBrush}" Width="15" Height="15" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="16,12" Margin="7,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" Background="#F1EDFF" CornerRadius="9">
                        <Path Data="{StaticResource Icon.MessagesSquare}" Style="{StaticResource IconStroke}"
                              Stroke="{StaticResource InfoBrush}" Width="18" Height="18" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="纠纷处理中" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding HandlingDisputes}" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="件" FontSize="9" Foreground="{StaticResource TextMutedBrush}"
                                       Margin="5,0,0,3" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </StackPanel>
                    <Path Grid.Column="2" Data="{StaticResource Icon.ChevronRight}" Style="{StaticResource IconStroke}"
                          Stroke="{StaticResource TextMutedBrush}" Width="15" Height="15" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="16,12" Margin="7,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" Background="{StaticResource WarningSoftBrush}" CornerRadius="9">
                        <Path Data="{StaticResource Icon.HardHat}" Style="{StaticResource IconStroke}"
                              Stroke="{StaticResource WarningBrush}" Width="18" Height="18" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="保养 / 年检到期" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding MaintenanceDue}" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="台" FontSize="9" Foreground="{StaticResource TextMutedBrush}"
                                       Margin="5,0,0,3" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </StackPanel>
                    <Path Grid.Column="2" Data="{StaticResource Icon.ChevronRight}" Style="{StaticResource IconStroke}"
                          Stroke="{StaticResource TextMutedBrush}" Width="15" Height="15" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardBorder}" Padding="16,12" Margin="7,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" Background="{StaticResource SuccessSoftBrush}" CornerRadius="9">
                        <Path Data="{StaticResource Icon.UsersRound}" Style="{StaticResource IconStroke}"
                              Stroke="{StaticResource SuccessBrush}" Width="18" Height="18" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="今日值班" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding DutyToday}" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="人" FontSize="9" Foreground="{StaticResource TextMutedBrush}"
                                       Margin="5,0,0,3" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </StackPanel>
                    <Path Grid.Column="2" Data="{StaticResource Icon.ChevronRight}" Style="{StaticResource IconStroke}"
                          Stroke="{StaticResource TextMutedBrush}" Width="15" Height="15" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </UniformGrid>

        <!-- ============ 快捷入口区 h78 ============ -->
        <StackPanel Grid.Row="6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="快捷入口" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="  常用业务一步直达" FontSize="10"
                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <Grid Margin="0,9,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- CHG-v1.2.0-22：快捷入口按「模块｜页面」精确跳转（原只传模块 key，落到模块首个子页 → 跳错页） -->
                <Button Grid.Column="0" Command="{Binding QuickEntryCommand}" CommandParameter="finance|收款登记"
                        Style="{StaticResource ButtonPrimary}" Height="38">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.HandCoins}" Style="{StaticResource IconStroke}"
                              Stroke="White" Width="17" Height="17" />
                        <TextBlock Text="收款登记" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                   Margin="9,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Command="{Binding QuickEntryCommand}" CommandParameter="emergency|场景与步骤维护"
                        Style="{StaticResource QuickCardButton}" Height="38">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Siren}" Style="{StaticResource IconStroke}"
                              Stroke="{StaticResource PrimaryBrush}" Width="17" Height="17" />
                        <TextBlock Text="场景与步骤维护" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="9,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Command="{Binding QuickEntryCommand}" CommandParameter="dispute|纠纷登记"
                        Style="{StaticResource QuickCardButton}" Height="38">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.FilePlus}" Style="{StaticResource IconStroke}"
                              Stroke="{StaticResource PrimaryBrush}" Width="17" Height="17" />
                        <TextBlock Text="纠纷登记" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="9,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="6" Command="{Binding QuickEntryCommand}" CommandParameter="phonebook|电话查询"
                        Style="{StaticResource QuickCardButton}" Height="38">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.PhoneCall}" Style="{StaticResource IconStroke}"
                              Stroke="{StaticResource PrimaryBrush}" Width="17" Height="17" />
                        <TextBlock Text="电话查询" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="9,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="8" Command="{Binding QuickEntryCommand}" CommandParameter="finance|账单工作台"
                        Style="{StaticResource QuickCardButton}" Height="38">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Icon.Files}" Style="{StaticResource IconStroke}"
                              Stroke="{StaticResource PrimaryBrush}" Width="17" Height="17" />
                        <TextBlock Text="生成账单" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="9,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- ============ 仪表盘下半区：待办 + 收缴概览 ============ -->
        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="342" />
            </Grid.ColumnDefinitions>

            <!-- 待办事项面板 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="16,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="待办事项" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <Border Grid.Column="1" Height="20" Background="{StaticResource PrimarySoftBrush}"
                                CornerRadius="10" Padding="7,0" Margin="8,0,0,0">
                            <TextBlock Text="{Binding PendingReminders}" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    <Button Grid.Column="3" Content="查看全部" FontSize="10" FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryBrush}" Cursor="Hand" Padding="4,2"
                            VerticalAlignment="Center" Command="{Binding ViewAllTodosCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    </Grid>

                    <TextBlock Text="{Binding LoadError}" FontSize="10" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LoadError}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding Reminders}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenTodoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        AutomationProperties.Name="{Binding Title}"
                                        CommandParameter="{Binding}" Style="{StaticResource TodoRowButton}">
                                    <Border Background="Transparent"
                                            BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,0,1"
                                            Padding="0,8" Margin="0,4,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                        <Setter Property="BorderThickness" Value="0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" Background="{Binding IconBackground}" CornerRadius="8">
                                            <Path Data="{Binding IconKey, Converter={StaticResource IconConv}}"
                                                  Style="{StaticResource IconStroke}"
                                                  Stroke="{Binding IconForeground}"
                                                  Width="16" Height="16" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Meta}" FontSize="9"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Height="22" Background="{Binding TagBackground}"
                                                CornerRadius="11" Padding="8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Tag}" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{Binding TagForeground}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Path Grid.Column="3" Data="{StaticResource Icon.ChevronRight}"
                                              Style="{StaticResource IconStroke}"
                                              Stroke="{StaticResource TextMutedBrush}"
                                              Width="14" Height="14" Margin="14,0,0,0"
                                              VerticalAlignment="Center" />
                                    </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 本月收缴概览 w342 -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding CollectionOverviewTitle}" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding MonthShortText}" FontSize="9"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CollectionRateText}" FontSize="30" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding CollectionTrend}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}"
                                   VerticalAlignment="Bottom" Margin="8,0,0,4" />
                    </Grid>

                    <!-- CHG-v1.1.2-56：进度条按收缴率显示（原填充宽度写死 245px，与 100%/30% 无关） -->
                    <ProgressBar Height="9" Margin="0,12,0,0" Minimum="0" Maximum="100"
                                 Value="{Binding CollectionRateValue, Mode=OneWay}"
                                 Background="#EAE5DA" Foreground="{StaticResource PrimaryBrush}"
                                 BorderThickness="0">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Grid>
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5" />
                                    <Border x:Name="PART_Track" />
                                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                            CornerRadius="5" HorizontalAlignment="Left" />
                                </Grid>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ReceivedLegendText}" FontSize="9"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="6,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                            <Ellipse Width="7" Height="7" Fill="#C8D3E1" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ArrearLegendText}" FontSize="9"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Height="1" Fill="{StaticResource BorderBrushColor}" Margin="0,12,0,0" />

                    <TextBlock Text="{Binding CollectionGapText}" FontSize="10"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0" />

                    <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="7" Padding="10,8" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Target}" Style="{StaticResource IconStroke}"
                                  Stroke="{StaticResource PrimaryBrush}"
                                  Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CollectionHintText}" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>


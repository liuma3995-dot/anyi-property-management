<UserControl x:Class="PropertyManagement.Client.Views.EmergencySceneStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:vm="clr-namespace:PropertyManagement.Client.ViewModels"
             FontFamily="微软雅黑">
    <UserControl.Resources>
        <vm:IconKeyConverter x:Key="IconConv" />
        <!-- 场景卡列表项（原型 PG-EMG-01 场景行） -->
        <Style x:Key="SceneItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ButtonDanger" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsBatchMode, Converter={StaticResource BoolToVis}}">
                    <CheckBox Content="全选" IsChecked="{Binding IsAllChecked, Mode=TwoWay}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CheckedCountText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource ButtonDanger}" Content="批量删除场景"
                            Command="{Binding BatchDeleteCommand}" Height="38"
                            Visibility="{Binding IsNotBatchMode, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource ButtonSecondary}" Content="取消" Height="38"
                            Command="{Binding CancelBatchDeleteCommand}"
                            Visibility="{Binding IsBatchMode, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource ButtonDanger}" Content="确认删除" Height="38" Margin="8,0,0,0"
                            Command="{Binding ConfirmSelectionCommand}" IsEnabled="{Binding HasScenesChecked}"
                            Visibility="{Binding IsBatchMode, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左列：应急场景库 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="应急场景库" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="16,14,16,10" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Scenes}" SelectedItem="{Binding SelectedScene}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource SceneItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,4,0"
                                              Visibility="{Binding DataContext.IsBatchMode, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                    <Border Grid.Column="1" Width="30" Height="30" CornerRadius="8"
                                            Background="{StaticResource PrimarySoftBrush}" VerticalAlignment="Center">
                                        <Path Data="{Binding IconKey, Converter={StaticResource IconConv}}" Style="{StaticResource IconStroke}"
                                              Stroke="{StaticResource PrimaryBrush}" Width="16" Height="16" />
                                    </Border>
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding TimeLimitText}" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Path Grid.Column="3" Data="{StaticResource Icon.ChevronRight}" Style="{StaticResource IconStroke}"
                                          Stroke="{StaticResource TextMutedBrush}" Width="13" Height="13" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="2" Style="{StaticResource ButtonSecondary}" Content="新增场景" Command="{Binding AddSceneCommand}"
                            Margin="16,10,16,14" Height="38" />
                </Grid>
            </Border>

            <!-- 右列：{场景} · 处置步骤 -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="0" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="16,14,16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding RightTitle}" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource ButtonSecondary}" Content="编辑步骤" Command="{Binding AddStepCommand}" Height="36" />
                            <Button Style="{StaticResource ButtonPrimary}" Content="{Binding ToggleStatusText}"
                                    Command="{Binding ToggleSceneStatusCommand}" Height="36" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <!-- 步骤行可拖拽调整顺序（代码后台 DragDrop → ReorderEmergencyStepsAsync 持久化） -->
                    <DataGrid x:Name="StepsGrid" Grid.Row="1" Style="{StaticResource GridStyle}" ItemsSource="{Binding Steps}"
                              IsReadOnly="True" AllowDrop="True" EnableRowVirtualization="False"
                              PreviewMouseLeftButtonDown="StepsGrid_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="StepsGrid_PreviewMouseMove"
                              Drop="StepsGrid_Drop" Margin="16,0,16,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号" Width="64" Binding="{Binding StepNo}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTextColumn Header="处置步骤" Width="*" Binding="{Binding Content}" ElementStyle="{StaticResource GridCellText}" />
                            <DataGridTemplateColumn Header="操作" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource LinkButton}" Content="编辑"
                                                    Command="{Binding DataContext.EditStepCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource LinkButton}" Content="删除" Foreground="{StaticResource DangerBrush}"
                                                    Command="{Binding DataContext.DeleteStepCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    CommandParameter="{Binding}" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- 步骤表说明 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,10,16,14">
                        <Path Data="{StaticResource Icon.ShieldCheck}" Style="{StaticResource IconStroke}"
                              Stroke="{StaticResource PrimaryBrush}" Width="14" Height="14" VerticalAlignment="Top" />
                        <TextBlock Text="· 处置步骤按序号依次执行；可用「编辑」「删除」维护步骤，删除后该步骤归档不再显示，历史版本保留。"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   VerticalAlignment="Top" Margin="8,0,0,0" MaxWidth="820" HorizontalAlignment="Left" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 交互标注（原型行 244-249） -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="16,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Path Data="{StaticResource Icon.Check}" Style="{StaticResource IconStroke}"
                          Stroke="{StaticResource PrimaryBrush}" Width="12" Height="12" VerticalAlignment="Center" />
                    <TextBlock Text="交互标注" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Text="· 步骤行可拖拽调整顺序；保存后实时刷新步骤表与场景库。"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock Text="· 场景停用后保留处置步骤历史，可随时恢复启用；每个场景可通过「新增场景」选择独立图标标识。"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="5" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="11" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
        </DockPanel>

        <!-- 场景停用/启用 二次确认浮层（BR-EMG-01） -->
        <Grid Grid.RowSpan="6" Visibility="{Binding IsStatusConfirmVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="430" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="场景状态确认" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding StatusConfirmText}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,14,0,22" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonPrimary}" Content="确认"
                                Command="{Binding ConfirmToggleSceneStatusCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource ButtonSecondary}" Content="取消"
                                Command="{Binding CancelToggleSceneStatusCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 处置步骤删除 二次确认浮层 -->
        <Grid Grid.RowSpan="6" Visibility="{Binding IsDeleteStepConfirmVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="430" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="删除处置步骤" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding DeleteStepConfirmText}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,14,0,22" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonDanger}" Content="确认删除"
                                Command="{Binding ConfirmDeleteStepCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource ButtonSecondary}" Content="取消"
                                Command="{Binding CancelDeleteStepCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 批量删除场景 二次确认浮层 -->
        <Grid Grid.RowSpan="6" Visibility="{Binding IsBatchConfirmVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="430" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="批量删除场景" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding BatchConfirmText}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,14,0,22" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonSecondary}" Content="取消"
                                Command="{Binding CancelBatchDeleteCommand}" />
                        <Button Grid.Column="2" Style="{StaticResource ButtonDanger}" Content="确认删除"
                                Command="{Binding ConfirmBatchDeleteCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 新增场景 -->
        <Grid Grid.RowSpan="6" Visibility="{Binding IsSceneFormVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="新增场景" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />
                    <TextBlock Text="场景名称" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,4" />
                    <TextBox Text="{Binding FormSceneName, UpdateSourceTrigger=PropertyChanged}" Height="32" hc:InfoElement.Placeholder="请输入场景名称，如：火灾" />
                    <TextBlock Text="场景类别" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,4" />
                    <TextBox Text="{Binding FormSceneCategory, UpdateSourceTrigger=PropertyChanged}" Height="32" hc:InfoElement.Placeholder="请输入场景类别，如：消防" />
                    <TextBlock Text="场景标识图标" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,14,0,6" />
                    <ListBox ItemsSource="{Binding IconItems}" SelectedItem="{Binding FormSceneIcon}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="3" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bg" Width="36" Height="36" CornerRadius="8"
                                                    Background="{StaticResource SurfaceAltBrush}" BorderThickness="1" BorderBrush="{StaticResource BorderBrushColor}">
                                                <Path Data="{Binding Converter={StaticResource IconConv}}" Style="{StaticResource IconStroke}"
                                                      Stroke="{StaticResource PrimaryBrush}" Width="17" Height="17" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBlock Text="· 图标用于区分不同应急场景，选择后左侧场景库将展示对应标识。" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelSceneCommand}" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="保存" Command="{Binding SaveSceneCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 新增/编辑步骤 -->
        <Grid Grid.RowSpan="6" Visibility="{Binding IsStepFormVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="处置步骤" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />
                    <TextBlock Text="步骤序号" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,4" />
                    <TextBox Text="{Binding FormStepNo, UpdateSourceTrigger=PropertyChanged}" Height="32" hc:InfoElement.Placeholder="请输入步骤序号（数字），如：1" />
                    <TextBlock Text="处置步骤内容" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,4" />
                    <TextBox Text="{Binding FormContent, UpdateSourceTrigger=PropertyChanged}" Height="60" AcceptsReturn="True" TextWrapping="Wrap" hc:InfoElement.Placeholder="请输入处置步骤内容，如：确认火情位置与火势级别" />
                    <TextBlock Text="· 处置步骤按序号依次执行，用于引导现场处置顺序；保存后实时刷新步骤表。" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelStepCommand}" />
                        <Button Style="{StaticResource ButtonPrimary}" Content="保存" Command="{Binding SaveStepCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

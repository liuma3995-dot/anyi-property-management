<UserControl x:Class="PropertyManagement.Client.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:conv="clr-namespace:PropertyManagement.Client.Converters"
             FontFamily="微软雅黑">
    <UserControl.Resources>
        <!-- R14：把视图 DataContext 传给不在可视化树内的 DataGridColumn（控制勾选框列显隐） -->
        <conv:BindingProxy x:Key="VmProxy" Data="{Binding}" />
        <!-- 对象列 Tooltip 展示详情 -->
        <Style x:Key="TargetCellText" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
            <Setter Property="ToolTip" Value="{Binding Detail}" />
        </Style>
        <!-- 页码按钮（当前页主色高亮，PG-COM-03） -->
        <Style x:Key="PagerNumberButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 上一页/下一页（白底描边小按钮） -->
        <Style x:Key="PagerStepButton" TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏：时间范围 / 操作人 / 模块 / 动作 / 关键字 + 导出（原型 PG-COM-03） -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ComboBox Height="36" Width="132" FontSize="12" VerticalContentAlignment="Center"
                          ItemsSource="{Binding TimeRanges}" SelectedIndex="{Binding TimeRangeIndex, Mode=TwoWay}" />
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0"
                            Visibility="{Binding IsCustomRange, Converter={StaticResource BoolToVis}}">
                    <DatePicker Height="36" Width="126" FontSize="12" SelectedDate="{Binding CustomFrom, Mode=TwoWay}" />
                    <TextBlock Text="—" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0" />
                    <DatePicker Height="36" Width="126" FontSize="12" SelectedDate="{Binding CustomTo, Mode=TwoWay}" />
                </StackPanel>

                <TextBlock Text="操作人：" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,6,0" />
                <ComboBox Height="36" Width="132" FontSize="12" VerticalContentAlignment="Center"
                          IsEditable="True" ItemsSource="{Binding OperatorOptions}"
                          Text="{Binding Operator, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="模块：" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,6,0" />
                <ComboBox Height="36" Width="140" FontSize="12" VerticalContentAlignment="Center"
                          ItemsSource="{Binding ModuleOptions}" SelectedIndex="{Binding ModuleIndex, Mode=TwoWay}" />

                <TextBlock Text="动作：" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,6,0" />
                <ComboBox Height="36" Width="132" FontSize="12" VerticalContentAlignment="Center"
                          IsEditable="True" ItemsSource="{Binding ActionOptions}"
                          Text="{Binding Action, UpdateSourceTrigger=PropertyChanged}" />

                <Border Height="36" Width="240" Margin="12,0,0,0" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Data="{StaticResource Icon.Search}" Style="{StaticResource IconStroke}" Stroke="{StaticResource TextMutedBrush}" Width="14" Height="14" Margin="12,0,0,0" />
                        <TextBox Grid.Column="1" Style="{StaticResource SearchTextBox}" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" hc:InfoElement.Placeholder="搜索对象 / 关键字" FontSize="11" Margin="8,0,12,0" />
                    </Grid>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource ButtonSecondary}" Height="36" Padding="16,6" Command="{Binding BatchDeleteCommand}"
                        ToolTip="点击后显示勾选框列（可勾选单条，也可勾选表头全选）">
                    <TextBlock Text="{Binding BatchDeleteButtonText}" FontSize="12" Foreground="{StaticResource DangerBrush}" />
                </Button>
                <Button Style="{StaticResource ButtonSecondary}" Content="取消" Height="36" Padding="16,6" Margin="10,0,0,0"
                        Command="{Binding CancelSelectionCommand}"
                        Visibility="{Binding IsSelectionMode, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource ButtonSecondary}" Content="导出" Command="{Binding ExportCommand}" Height="36" Padding="20,6" Margin="10,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- 数据表（八列） -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid Style="{StaticResource GridStyle}" ItemsSource="{Binding Items}" IsReadOnly="True">
                <DataGrid.Columns>
                    <!-- R13：勾选框列（表头全选，支持单选） -->
                    <DataGridTemplateColumn Width="56" MinWidth="56" CellStyle="{StaticResource GridCheckCell}"
                                            Visibility="{Binding Data.IsSelectionMode, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVis}}">
                        <DataGridTemplateColumn.Header>
                            <CheckBox IsChecked="{Binding DataContext.IsAllItemsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=TwoWay}"
                                      Style="{StaticResource GridCheckBox}" ToolTip="全选 / 取消全选" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- 只读 DataGrid 中 CheckBox 的 IsChecked 绑定不会写回源，由 Click 显式同步到行对象 -->
                                <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}" Style="{StaticResource GridCheckBox}"
                                          Click="AuditCheck_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="时间" Width="120" Binding="{Binding Time}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="操作人" Width="86" Binding="{Binding UserName}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="角色" Width="86" Binding="{Binding Role}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="模块" Width="92" Binding="{Binding Module}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="动作" Width="150" Binding="{Binding Action}" ElementStyle="{StaticResource GridCellText}" />
                    <DataGridTextColumn Header="对象" Width="*" Binding="{Binding Target}" ElementStyle="{StaticResource TargetCellText}" />
                    <DataGridTemplateColumn Header="结果" Width="86">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding ResultBg}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding ResultText}" Foreground="{Binding ResultBrush}" FontSize="11" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="IP 地址" Width="110" Binding="{Binding IpAddr}" ElementStyle="{StaticResource GridCellText}" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 分页条：共 N 条记录 · 第 x/y 页 + 页码 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SuccessBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding TotalText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center" Margin="0,0,14,0" HorizontalAlignment="Right" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource PagerStepButton}" Content="上一页" Command="{Binding PrevPageCommand}" />
                <ItemsControl ItemsSource="{Binding Pages}" Margin="6,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PagerNumberButton}" Content="{Binding Text}"
                                    Background="{Binding Background}" BorderBrush="{Binding BorderBrush}" Foreground="{Binding Foreground}"
                                    Command="{Binding DataContext.GoPageCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource PagerStepButton}" Content="下一页" Margin="6,0,0,0" Command="{Binding NextPageCommand}" />
            </StackPanel>
        </Grid>

        <!-- 交互标注（原型 PG-COM-03） -->
        <Border Grid.Row="6" Background="#F7F5FE" CornerRadius="6" Padding="12,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.Eye}" Style="{StaticResource IconStroke}" Stroke="#5B3DF5" Width="12" Height="12" />
                    <TextBlock Text="交互标注" Foreground="#5B3DF5" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Text="· 日志仅支持管理员批量删除（软删留痕，可在「备份与恢复」页一键清理）；登录失败连续 5 次 → 账号锁定 10 分钟并告警" Foreground="#4A3AB0" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="· 支持按时间范围/操作人/模块/动作/关键字组合筛选；导出记录本身也写入日志" Foreground="#4A3AB0" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- R13：批量删除二次确认弹层 -->
        <Border Grid.RowSpan="7" Background="#66000000" Visibility="{Binding IsConfirmVisible, Converter={StaticResource BoolToVis}}">
            <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardBorder}" Padding="26,22">
                <StackPanel>
                    <TextBlock Text="{Binding ConfirmTitle}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding ConfirmMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource ButtonSecondary}" Content="取消" Command="{Binding CancelConfirmCommand}" />
                        <Button Background="{StaticResource DangerBrush}" Style="{StaticResource ButtonPrimary}" Content="确认" Command="{Binding ConfirmDeleteCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>

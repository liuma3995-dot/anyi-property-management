                      "type": "text",
                      "id": "EuPLN",
                      "name": "标注",
                      "fill": "#4A3AB0",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "· 停用变量 → 二次确认「已引用该变量的收费标准将无法生成新账单，历史账单不受影响」；仍被引用的变量不允许删除",
                      "fontFamily": "Funnel Sans",
                      "fontSize": 10,
                      "fontWeight": "normal"
